// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme, Icons, Icon } from "controls.slint";
export { Theme, Icons } from "controls.slint";
export { OcrWindow } from "ocr.slint";
export { ScrollWindow } from "scroll.slint";
export { RecordingWidget } from "widget.slint";
export { ToastWindow } from "toast.slint";
export { WizardWindow } from "wizard.slint";
export { SideItem, SidePanelWindow } from "side_panel.slint";
export { GalleryItem, LineItem, SettingRow, SettingsWindow, ShortcutRow, UiTexts } from "settings.slint";

// All geometry is in physical pixels (`phx`) so the frozen image is shown 1:1 on every DPI;
// the toolbar scales with `ui-scale` (the window's scale factor).
//
// The overlay is one window per monitor. Each shows its `area` of the frozen image, and lays
// everything out in the coordinates of the whole image: the window clips the rest.

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> u: 1phx;
    callback clicked();

    width: 30 * u;
    height: 30 * u;
    border-radius: 6 * u;
    background: root.active ? Theme.accent-soft
        : (touch.pressed && root.enabled ? Theme.subtle-pressed : (touch.has-hover && root.enabled ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }

    // The mark of the active tool, as the Windows 11 selected items have.
    if root.active : Rectangle {
        x: 8 * u; y: root.height - 3 * u; width: root.width - 16 * u; height: 2 * u; border-radius: 1 * u;
        background: Theme.accent;
    }
    Icon {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        data: root.icon;
        size: 18 * u;
        tint: root.enabled ? (root.active ? Theme.accent : Theme.text) : Theme.text-off;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> chosen: false;
    in property <length> u: 1phx;
    callback clicked();

    width: 24 * u;
    height: 24 * u;
    border-radius: 12 * u;
    background: root.swatch;
    border-width: root.chosen ? 2 * u : 1 * u;
    border-color: root.chosen ? Theme.accent : Theme.stroke-strong;

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component EditorWindow inherits Window {
    // This window's part of the frozen image (image pixels) and its size (physical pixels).
    in property <image> frozen;
    in property <float> area-x: 0;
    in property <float> area-y: 0;
    in property <float> area-w: 1;
    in property <float> area-h: 1;
    in property <int> view-width: 1;
    in property <int> view-height: 1;
    in property <int> image-width: 1;
    in property <int> image-height: 1;
    in property <float> dim: 0.4;
    // The veil fades in once the window is up, so the screen first looks exactly as it was.
    in property <bool> fade-in: true;
    in property <float> ui-scale: 1;

    // The zone.
    in property <bool> has-selection: false;
    in property <bool> settled: false;
    in property <float> sel-x;
    in property <float> sel-y;
    in property <float> sel-w;
    in property <float> sel-h;
    in property <bool> has-hover: false;
    in property <float> hover-x;
    in property <float> hover-y;
    in property <float> hover-w;
    in property <float> hover-h;
    in property <string> size-text;
    in property <float> size-x;
    in property <float> size-y;

    // The zone with its annotations drawn on it.
    in property <bool> has-annotated: false;
    in property <image> annotated;
    in property <float> annotated-x;
    in property <float> annotated-y;

    // Magnifier.
    in property <bool> has-magnifier: false;
    in property <image> magnifier;
    in property <float> mag-x;
    in property <float> mag-y;
    in property <float> mag-size;
    in property <string> mag-hex;
    in property <color> mag-color: black;

    // Toolbar.
    in property <bool> has-toolbar: false;
    in property <float> toolbar-x;
    in property <float> toolbar-y;
    in property <int> tool: -1;
    in property <color> current-color: red;
    in property <[color]> palette;
    in property <[color]> recent;
    in property <float> stroke-width: 4;
    in property <bool> filled: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    // Text tool field.
    in property <bool> has-text-input: false;
    in property <float> text-x;
    in property <float> text-y;
    in property <float> text-size: 24;

    in-out property <string> text-value;
    // The style panel (colours, thickness, fill) and, inside it, the colour picker.
    in-out property <bool> style-open: false;
    in-out property <bool> picker-open: false;
    property <float> hue: 0;
    property <float> sat: 1;
    property <float> val: 1;
    in property <int> cursor-kind: 0;
    // Image taller than the window (scrolling capture): the image scrolls, the toolbar stays.
    in property <bool> scrolling: false;
    in-out property <float> scroll-y: 0;
    // Off while a system dialog (Save as) must appear above the overlay.
    in property <bool> on-top: true;

    callback pointer-pressed(float, float, bool);
    callback pointer-moved(float, float, bool);
    callback pointer-released(float, float, bool);
    callback key-pressed(string, bool, bool);
    callback key-released(string);
    callback tool-chosen(int);
    callback color-chosen(color);
    callback width-changed(float);
    callback filled-toggled();
    callback action(string);
    callback text-committed(string);

    property <length> u: 1phx * root.ui-scale;
    property <bool> shown: !root.fade-in;
    property <float> veil: root.shown ? root.dim : 0;
    animate veil { duration: 160ms; easing: ease-out; }
    // The hole in the veil: the zone, else the window under the cursor.
    property <bool> has-hole: root.has-selection || root.has-hover;
    property <float> hole-x: root.has-selection ? root.sel-x : root.hover-x;
    property <float> hole-y: root.has-selection ? root.sel-y : root.hover-y;
    property <float> hole-w: root.has-selection ? root.sel-w : root.hover-w;
    property <float> hole-h: root.has-selection ? root.sel-h : root.hover-h;
    pure function clamp-scroll(v: float) -> float {
        return Math.max(0, Math.min(v, root.image-height - root.height / 1phx));
    }

    no-frame: true;
    always-on-top: root.on-top;
    background: black;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    width: view-width * 1phx;
    height: view-height * 1phx;

    Timer {
        interval: 30ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    init => { focus.focus(); }
    changed has-text-input => {
        if !root.has-text-input { focus.focus(); }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if root.scrolling && !root.has-text-input {
                if event.text == Key.PageDown { root.scroll-y = clamp-scroll(root.scroll-y + root.height / 1phx * 0.9); return accept; }
                if event.text == Key.PageUp { root.scroll-y = clamp-scroll(root.scroll-y - root.height / 1phx * 0.9); return accept; }
                if event.text == Key.Home { root.scroll-y = 0; return accept; }
                if event.text == Key.End { root.scroll-y = clamp-scroll(root.image-height); return accept; }
            }
            root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift);
            accept
        }
        key-released(event) => {
            root.key-released(event.text);
            accept
        }

        content := Rectangle {
            x: -root.area-x * 1phx;
            y: (-root.area-y - root.scroll-y) * 1phx;
            width: root.image-width * 1phx;
            height: root.image-height * 1phx;

            Image {
                x: root.area-x * 1phx;
                y: root.area-y * 1phx;
                width: root.area-w * 1phx;
                height: root.area-h * 1phx;
                source: root.frozen;
                image-rendering: pixelated;
            }

            // Veil around the hole (everywhere when there is none).
            Rectangle { x: 0phx; y: 0phx; width: parent.width; height: root.has-hole ? root.hole-y * 1phx : parent.height; background: black.with-alpha(root.veil); }
            Rectangle { visible: root.has-hole; x: 0phx; y: (root.hole-y + root.hole-h) * 1phx; width: parent.width; height: parent.height - (root.hole-y + root.hole-h) * 1phx; background: black.with-alpha(root.veil); }
            Rectangle { visible: root.has-hole; x: 0phx; y: root.hole-y * 1phx; width: root.hole-x * 1phx; height: root.hole-h * 1phx; background: black.with-alpha(root.veil); }
            Rectangle { visible: root.has-hole; x: (root.hole-x + root.hole-w) * 1phx; y: root.hole-y * 1phx; width: parent.width - (root.hole-x + root.hole-w) * 1phx; height: root.hole-h * 1phx; background: black.with-alpha(root.veil); }

            // Window under the cursor, before any zone exists: left clear, with a fine outline.
            if root.has-hover && !root.has-selection : Rectangle {
                x: root.hover-x * 1phx;
                y: root.hover-y * 1phx;
                width: root.hover-w * 1phx;
                height: root.hover-h * 1phx;
                border-width: 2phx;
                border-color: Theme.accent;
                opacity: root.shown ? 1 : 0;
                animate opacity { duration: 160ms; easing: ease-out; }
            }

            if root.has-annotated : Image {
                x: root.annotated-x * 1phx;
                y: root.annotated-y * 1phx;
                source: root.annotated;
                image-rendering: pixelated;
            }

            TouchArea {
                mouse-cursor: root.cursor-kind == 0 ? MouseCursor.crosshair
                    : root.cursor-kind == 1 ? MouseCursor.move
                    : root.cursor-kind == 2 ? MouseCursor.ns-resize
                    : root.cursor-kind == 3 ? MouseCursor.ew-resize
                    : root.cursor-kind == 4 ? MouseCursor.nesw-resize
                    : root.cursor-kind == 5 ? MouseCursor.nwse-resize
                    : MouseCursor.default;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left {
                        if event.kind == PointerEventKind.down {
                            root.pointer-pressed(self.mouse-x / 1phx, self.mouse-y / 1phx, event.modifiers.shift);
                        } else if event.kind == PointerEventKind.up {
                            root.pointer-released(self.mouse-x / 1phx, self.mouse-y / 1phx, event.modifiers.shift);
                        }
                    }
                }
                moved => { root.pointer-moved(self.mouse-x / 1phx, self.mouse-y / 1phx, false); }
            scroll-event(event) => {
                if root.scrolling {
                    root.scroll-y = clamp-scroll(root.scroll-y - event.delta-y / 1phx);
                    return accept;
                }
                reject
            }
            }

            // Zone border and handles.
            if root.has-selection : Rectangle {
                x: root.sel-x * 1phx;
                y: root.sel-y * 1phx;
                width: root.sel-w * 1phx;
                height: root.sel-h * 1phx;
                border-width: 2phx;
                border-color: Theme.accent;
            }
            if root.has-selection && root.settled : Rectangle {
                x: 0phx; y: 0phx; width: 0phx; height: 0phx;
                for hx[i] in [0.0, 0.5, 1.0, 1.0, 1.0, 0.5, 0.0, 0.0] : Rectangle {
                    property <float> hy: [0.0, 0.0, 0.0, 0.5, 1.0, 1.0, 1.0, 0.5][i];
                    x: (root.sel-x + root.sel-w * hx) * 1phx - 5 * root.u;
                    y: (root.sel-y + root.sel-h * hy) * 1phx - 5 * root.u;
                    width: 10 * root.u;
                    height: 10 * root.u;
                    border-radius: 5 * root.u;
                    background: white;
                    border-width: 2phx;
                    border-color: Theme.accent;
                }
            }

            // Size label.
            if root.has-selection : Rectangle {
                x: root.size-x * 1phx;
                y: root.size-y * 1phx;
                height: 24 * root.u;
                width: label.preferred-width + 16 * root.u;
                background: Theme.flyout;
                border-radius: 4 * root.u;
                border-width: 1phx;
                border-color: Theme.stroke-strong;
                label := Text {
                    text: root.size-text;
                    color: Theme.text;
                    font-size: 12 * root.u;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Magnifier with reticle and the colour under the cursor.
            if root.has-magnifier : Rectangle {
                x: root.mag-x * 1phx;
                y: root.mag-y * 1phx;
                width: root.mag-size * 1phx;
                height: root.mag-size * 1phx + 28 * root.u;
                background: Theme.flyout;
                border-radius: 8 * root.u;
                border-width: 1phx;
                border-color: Theme.stroke-strong;
                clip: true;
                Image {
                    x: 0phx;
                    y: 0phx;
                    width: root.mag-size * 1phx;
                    height: root.mag-size * 1phx;
                    source: root.magnifier;
                    image-rendering: pixelated;
                }
                // reticle: the centre cell
                Rectangle {
                    x: (root.mag-size * 1phx - root.mag-size / 11 * 1phx) / 2;
                    y: self.x;
                    width: root.mag-size / 11 * 1phx;
                    height: self.width;
                    border-width: 1phx;
                    border-color: white;
                    Rectangle { border-width: 1phx; border-color: black; }
                }
                Rectangle {
                    x: 6 * root.u;
                    y: root.mag-size * 1phx + 6 * root.u;
                    width: 16 * root.u;
                    height: 16 * root.u;
                    background: root.mag-color;
                    border-width: 1phx;
                    border-color: white;
                }
                Text {
                    x: 28 * root.u;
                    y: root.mag-size * 1phx;
                    height: 28 * root.u;
                    text: root.mag-hex;
                    color: Theme.text;
                    font-size: 13 * root.u;
                    vertical-alignment: center;
                }
            }

            if root.has-text-input : text-field := TextInput {
                x: root.text-x * 1phx;
                y: root.text-y * 1phx;
                font-size: root.text-size * 1phx;
                color: root.current-color;
                text <=> root.text-value;
                accepted => { root.text-committed(self.text); }
                init => { self.focus(); }
            }

        }

        if root.scrolling && root.image-height > root.height / 1phx : Rectangle {
            x: root.width - 6 * root.u;
            y: root.scroll-y / root.image-height * root.height;
            width: 4 * root.u;
            height: Math.max(24 * root.u, root.height * root.height / (root.image-height * 1phx));
            background: #ffffff88;
            border-radius: 2 * root.u;
        }

        // Toolbar: one row (tools · style · undo/redo · outputs · close). Colours, thickness and
        // fill are in a small panel that opens from the style button.
        if root.has-toolbar : Rectangle {
            // Rises into place when the zone is settled.
            property <bool> shown: !root.fade-in;
            property <length> pop-w: 240 * root.u;
            property <length> pop-h: (root.picker-open ? 250 : 110) * root.u;
            x: (root.toolbar-x - root.area-x) * 1phx;
            y: (root.toolbar-y - root.area-y) * 1phx + (self.shown ? 0 : 6 * root.u);
            width: 722 * root.u;
            height: 46 * root.u;
            opacity: self.shown ? 1 : 0;
            animate opacity, y { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
            background: Theme.flyout.with-alpha(0.94);
            border-radius: 12 * root.u;
            border-width: 1phx;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 18phx;
            drop-shadow-color: #00000060;
            drop-shadow-offset-y: 6phx;
            Timer {
                interval: 16ms;
                running: !parent.shown;
                triggered => { parent.shown = true; }
            }

            TouchArea { } // swallows clicks on the bar itself

            // Tools (the index is the session's tool number).
            for t[k] in [
                { i: 0, icon: Icons.cursor }, { i: 1, icon: Icons.pen }, { i: 7, icon: Icons.highlight },
                { i: 2, icon: Icons.line }, { i: 3, icon: Icons.arrow }, { i: 4, icon: Icons.square },
                { i: 5, icon: Icons.circle }, { i: 6, icon: Icons.text }, { i: 10, icon: Icons.marker },
                { i: 8, icon: Icons.blur }, { i: 9, icon: Icons.pixelate },
            ] : IconButton {
                u: root.u;
                x: (6 + k * 34) * root.u;
                y: 8 * root.u;
                icon: t.icon;
                active: root.tool == t.i;
                clicked => { root.tool-chosen(t.i); }
            }
            for sx in [383, 425, 501, 679] : Rectangle {
                x: sx * root.u;
                y: 14 * root.u;
                width: 1phx;
                height: 18 * root.u;
                background: Theme.divider;
            }

            // Style: the current colour; opens the panel.
            Rectangle {
                x: 388 * root.u;
                y: 8 * root.u;
                width: 30 * root.u;
                height: 30 * root.u;
                border-radius: 6 * root.u;
                background: root.style-open ? Theme.accent-soft : (style-touch.has-hover ? Theme.subtle-hover : transparent);
                animate background { duration: Theme.t-fast; }
                Rectangle {
                    x: 6 * root.u;
                    y: 6 * root.u;
                    width: 18 * root.u;
                    height: 18 * root.u;
                    border-radius: 9 * root.u;
                    background: root.current-color;
                    animate background { duration: Theme.t-fast; }
                    border-width: 1phx;
                    border-color: Theme.stroke-strong;
                }
                style-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.style-open = !root.style-open; root.picker-open = false; }
                }
            }

            // Undo, redo, then copy, save, save as, scrolling capture, OCR; then close.
            for a[k] in [
                { x: 430, icon: Icons.undo, name: "undo" }, { x: 464, icon: Icons.redo, name: "redo" },
                { x: 506, icon: Icons.copy, name: "copy" }, { x: 540, icon: Icons.save, name: "save" },
                { x: 574, icon: Icons.save-as, name: "save-as" }, { x: 608, icon: Icons.scroll, name: "scroll" },
                { x: 642, icon: Icons.scan-text, name: "ocr" }, { x: 684, icon: Icons.dismiss, name: "close" },
            ] : IconButton {
                u: root.u;
                x: a.x * root.u;
                y: 8 * root.u;
                icon: a.icon;
                enabled: k == 0 ? root.can-undo : k == 1 ? root.can-redo : true;
                clicked => { root.action(a.name); }
            }

            // The style panel, above the bar when there is room, else below.
            if root.style-open : Rectangle {
                property <bool> above: (root.toolbar-y - root.area-y) * 1phx > parent.pop-h + 8 * root.u;
                property <bool> open: !root.fade-in;
                x: 403 * root.u - parent.pop-w / 2;
                y: (self.above ? -parent.pop-h - 8 * root.u : 54 * root.u) + (self.open ? 0 : (self.above ? 4 : -4) * root.u);
                width: parent.pop-w;
                height: parent.pop-h;
                opacity: self.open ? 1 : 0;
                animate opacity, y, height { duration: Theme.t-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
                background: Theme.flyout.with-alpha(0.97);
                border-radius: 12 * root.u;
                border-width: 1phx;
                border-color: Theme.stroke-strong;
                drop-shadow-blur: 18phx;
                drop-shadow-color: #00000050;
                drop-shadow-offset-y: 6phx;
                clip: true;
                Timer { interval: 16ms; running: !parent.open; triggered => { parent.open = true; } }
                TouchArea { }

                // The palette.
                for c[i] in root.palette : Swatch {
                    u: root.u;
                    x: (10 + i * 28) * root.u;
                    y: 10 * root.u;
                    swatch: c;
                    chosen: c == root.current-color;
                    clicked => { root.color-chosen(c); }
                }
                // Recent colours, then a colour of one's own and the eyedropper.
                for c[i] in root.recent : Swatch {
                    u: root.u;
                    x: (10 + i * 28) * root.u;
                    y: 42 * root.u;
                    swatch: c;
                    chosen: c == root.current-color;
                    clicked => { root.color-chosen(c); }
                }
                Swatch {
                    u: root.u;
                    x: 174 * root.u;
                    y: 42 * root.u;
                    swatch: #00000000;
                    chosen: root.picker-open;
                    Icon { x: 4 * root.u; y: 4 * root.u; data: Icons.add; tint: Theme.text; size: 16 * root.u; }
                    clicked => { root.picker-open = !root.picker-open; }
                }
                IconButton {
                    u: root.u;
                    x: 202 * root.u;
                    y: 39 * root.u;
                    icon: Icons.eyedropper;
                    active: root.tool == 11;
                    clicked => { root.tool-chosen(11); root.style-open = false; }
                }
                Rectangle { x: 10 * root.u; y: 74 * root.u; width: parent.width - 20 * root.u; height: 1phx; background: Theme.divider; }
                // Thickness: − value +, and the fill of shapes.
                IconButton {
                    u: root.u;
                    x: 6 * root.u;
                    y: 78 * root.u;
                    icon: Icons.subtract;
                    clicked => { root.width-changed(root.stroke-width - 1); }
                }
                Text {
                    x: 36 * root.u;
                    y: 78 * root.u;
                    width: 36 * root.u;
                    height: 30 * root.u;
                    text: round(root.stroke-width) + " px";
                    color: Theme.text;
                    font-size: 13 * root.u;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                IconButton {
                    u: root.u;
                    x: 72 * root.u;
                    y: 78 * root.u;
                    icon: Icons.add;
                    clicked => { root.width-changed(root.stroke-width + 1); }
                }
                IconButton {
                    u: root.u;
                    x: parent.width - 36 * root.u;
                    y: 78 * root.u;
                    icon: Icons.square;
                    active: root.filled;
                    clicked => { root.filled-toggled(); }
                }

                // A colour of one's own: saturation (x) / value (y), and the hue bar.
                if root.picker-open : Rectangle {
                    x: 0px;
                    y: 110 * root.u;
                    width: parent.width;
                    height: 140 * root.u;
                    Rectangle { x: 10 * root.u; y: 0px; width: parent.width - 20 * root.u; height: 1phx; background: Theme.divider; }
                    sv := Rectangle {
                        x: 10 * root.u;
                        y: 10 * root.u;
                        width: 180 * root.u;
                        height: 120 * root.u;
                        border-radius: 4 * root.u;
                        clip: true;
                        background: Colors.hsv(root.hue, 1, 1, 1);
                        Rectangle { background: @linear-gradient(90deg, white, #ffffff00); }
                        Rectangle { background: @linear-gradient(180deg, #00000000, black); }
                        Rectangle {
                            x: root.sat * parent.width - 5 * root.u;
                            y: (1 - root.val) * parent.height - 5 * root.u;
                            width: 10 * root.u;
                            height: 10 * root.u;
                            border-radius: 5 * root.u;
                            border-width: 2 * root.u;
                            border-color: white;
                        }
                        TouchArea {
                            function pick() {
                                root.sat = max(0, min(1, self.mouse-x / self.width));
                                root.val = 1 - max(0, min(1, self.mouse-y / self.height));
                                root.color-chosen(Colors.hsv(root.hue, root.sat, root.val, 1));
                            }
                            pointer-event(e) => { if e.kind == PointerEventKind.down { self.pick(); } }
                            moved => { if self.pressed { self.pick(); } }
                        }
                    }
                    Rectangle {
                        x: 202 * root.u;
                        y: 10 * root.u;
                        width: 28 * root.u;
                        height: 120 * root.u;
                        background: @linear-gradient(180deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
                        border-radius: 4 * root.u;
                        Rectangle {
                            y: root.hue / 360 * parent.height - 2 * root.u;
                            height: 4 * root.u;
                            background: white;
                            border-width: 1phx;
                            border-color: black;
                        }
                        TouchArea {
                            function pick() {
                                root.hue = 360 * max(0, min(0.999, self.mouse-y / self.height));
                                root.color-chosen(Colors.hsv(root.hue, root.sat, root.val, 1));
                            }
                            pointer-event(e) => { if e.kind == PointerEventKind.down { self.pick(); } }
                            moved => { if self.pressed { self.pick(); } }
                        }
                    }
                }
            }
        }
    }
}
