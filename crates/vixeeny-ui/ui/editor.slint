import "../../../assets/fonts/Inter-Regular.ttf";
import { Theme, Icons, Icon } from "controls.slint";
export { Theme, Icons } from "controls.slint";
export { OcrWindow } from "ocr.slint";
export { ScrollWindow } from "scroll.slint";
export { RecordingWidget } from "widget.slint";
export { ToastWindow } from "toast.slint";
export { WizardWindow } from "wizard.slint";
export { SideItem, SidePanelWindow } from "side_panel.slint";
export { GalleryItem, LineItem, SettingRow, SettingsWindow, ShortcutRow, UiTexts } from "settings.slint";

// All geometry is in physical pixels (`phx`) so the frozen image is shown 1:1 on every DPI;
// the toolbar scales with `ui-scale` (the window's scale factor).

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> u: 1phx;
    callback clicked();

    width: 30 * u;
    height: 30 * u;
    border-radius: 4 * u;
    background: root.active ? Theme.accent-soft
        : (touch.pressed && root.enabled ? Theme.subtle-pressed : (touch.has-hover && root.enabled ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }

    // The mark of the active tool, as the Windows 11 selected items have.
    if root.active : Rectangle {
        x: 8 * u; y: root.height - 3 * u; width: root.width - 16 * u; height: 2 * u; border-radius: 1 * u;
        background: Theme.accent;
    }
    Icon {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        data: root.icon;
        size: 18 * u;
        tint: root.enabled ? (root.active ? Theme.accent : Theme.text) : Theme.text-off;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Swatch inherits Rectangle {
    in property <color> swatch;
    in property <bool> chosen: false;
    in property <length> u: 1phx;
    callback clicked();

    width: 24 * u;
    height: 24 * u;
    border-radius: 12 * u;
    background: root.swatch;
    border-width: root.chosen ? 2 * u : 1 * u;
    border-color: root.chosen ? Theme.accent : Theme.stroke-strong;

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component EditorWindow inherits Window {
    in property <image> frozen;
    in property <int> image-width: 1;
    in property <int> image-height: 1;
    in property <float> dim: 0.4;
    in property <float> ui-scale: 1;

    // The zone.
    in property <bool> has-selection: false;
    in property <bool> settled: false;
    in property <float> sel-x;
    in property <float> sel-y;
    in property <float> sel-w;
    in property <float> sel-h;
    in property <bool> has-hover: false;
    in property <float> hover-x;
    in property <float> hover-y;
    in property <float> hover-w;
    in property <float> hover-h;
    in property <string> size-text;
    in property <float> size-x;
    in property <float> size-y;

    // The zone with its annotations drawn on it.
    in property <bool> has-annotated: false;
    in property <image> annotated;
    in property <float> annotated-x;
    in property <float> annotated-y;

    // Magnifier.
    in property <bool> has-magnifier: false;
    in property <image> magnifier;
    in property <float> mag-x;
    in property <float> mag-y;
    in property <float> mag-size;
    in property <string> mag-hex;
    in property <color> mag-color: black;

    // Toolbar.
    in property <bool> has-toolbar: false;
    in property <float> toolbar-x;
    in property <float> toolbar-y;
    in property <int> tool: -1;
    in property <color> current-color: red;
    in property <[color]> palette;
    in property <[color]> recent;
    in property <float> stroke-width: 4;
    in property <bool> filled: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    // Text tool field.
    in property <bool> has-text-input: false;
    in property <float> text-x;
    in property <float> text-y;
    in property <float> text-size: 24;

    in-out property <string> text-value;
    in-out property <bool> picker-open: false;
    property <float> hue: 0;
    property <float> sat: 1;
    property <float> val: 1;
    in property <int> cursor-kind: 0;
    // Image taller than the window (scrolling capture): the image scrolls, the toolbar stays.
    in property <bool> scrolling: false;
    in-out property <float> scroll-y: 0;
    // Off while a system dialog (Save as) must appear above the overlay.
    in property <bool> on-top: true;

    callback pointer-pressed(float, float, bool);
    callback pointer-moved(float, float, bool);
    callback pointer-released(float, float, bool);
    callback key-pressed(string, bool, bool);
    callback key-released(string);
    callback tool-chosen(int);
    callback color-chosen(color);
    callback width-changed(float);
    callback filled-toggled();
    callback action(string);
    callback text-committed(string);

    property <length> u: 1phx * root.ui-scale;
    pure function clamp-scroll(v: float) -> float {
        return Math.max(0, Math.min(v, root.image-height - root.height / 1phx));
    }

    no-frame: true;
    always-on-top: root.on-top;
    background: black;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    width: image-width * 1phx;
    height: image-height * 1phx;

    init => { focus.focus(); }
    changed has-text-input => {
        if !root.has-text-input { focus.focus(); }
    }

    focus := FocusScope {
        key-pressed(event) => {
            if root.scrolling && !root.has-text-input {
                if event.text == Key.PageDown { root.scroll-y = clamp-scroll(root.scroll-y + root.height / 1phx * 0.9); return accept; }
                if event.text == Key.PageUp { root.scroll-y = clamp-scroll(root.scroll-y - root.height / 1phx * 0.9); return accept; }
                if event.text == Key.Home { root.scroll-y = 0; return accept; }
                if event.text == Key.End { root.scroll-y = clamp-scroll(root.image-height); return accept; }
            }
            root.key-pressed(event.text, event.modifiers.control, event.modifiers.shift);
            accept
        }
        key-released(event) => {
            root.key-released(event.text);
            accept
        }

        content := Rectangle {
            x: 0phx;
            y: -root.scroll-y * 1phx;
            width: root.image-width * 1phx;
            height: root.image-height * 1phx;

            Image {
                x: 0phx;
                y: 0phx;
                width: root.image-width * 1phx;
                height: root.image-height * 1phx;
                source: root.frozen;
                image-rendering: pixelated;
            }

            // Veil around the zone (everywhere when there is none).
            Rectangle { x: 0phx; y: 0phx; width: parent.width; height: root.has-selection ? root.sel-y * 1phx : parent.height; background: black.with-alpha(root.dim); }
            Rectangle { visible: root.has-selection; x: 0phx; y: (root.sel-y + root.sel-h) * 1phx; width: parent.width; height: parent.height - (root.sel-y + root.sel-h) * 1phx; background: black.with-alpha(root.dim); }
            Rectangle { visible: root.has-selection; x: 0phx; y: root.sel-y * 1phx; width: root.sel-x * 1phx; height: root.sel-h * 1phx; background: black.with-alpha(root.dim); }
            Rectangle { visible: root.has-selection; x: (root.sel-x + root.sel-w) * 1phx; y: root.sel-y * 1phx; width: parent.width - (root.sel-x + root.sel-w) * 1phx; height: root.sel-h * 1phx; background: black.with-alpha(root.dim); }

            // Window under the cursor, before any zone exists.
            if root.has-hover && !root.has-selection : Rectangle {
                x: root.hover-x * 1phx;
                y: root.hover-y * 1phx;
                width: root.hover-w * 1phx;
                height: root.hover-h * 1phx;
                background: Theme.accent-soft;
                border-width: 2phx;
                border-color: Theme.accent;
            }

            if root.has-annotated : Image {
                x: root.annotated-x * 1phx;
                y: root.annotated-y * 1phx;
                source: root.annotated;
                image-rendering: pixelated;
            }

            TouchArea {
                mouse-cursor: root.cursor-kind == 0 ? MouseCursor.crosshair
                    : root.cursor-kind == 1 ? MouseCursor.move
                    : root.cursor-kind == 2 ? MouseCursor.ns-resize
                    : root.cursor-kind == 3 ? MouseCursor.ew-resize
                    : root.cursor-kind == 4 ? MouseCursor.nesw-resize
                    : root.cursor-kind == 5 ? MouseCursor.nwse-resize
                    : MouseCursor.default;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left {
                        if event.kind == PointerEventKind.down {
                            root.pointer-pressed(self.mouse-x / 1phx, self.mouse-y / 1phx, event.modifiers.shift);
                        } else if event.kind == PointerEventKind.up {
                            root.pointer-released(self.mouse-x / 1phx, self.mouse-y / 1phx, event.modifiers.shift);
                        }
                    }
                }
                moved => { root.pointer-moved(self.mouse-x / 1phx, self.mouse-y / 1phx, false); }
            scroll-event(event) => {
                if root.scrolling {
                    root.scroll-y = clamp-scroll(root.scroll-y - event.delta-y / 1phx);
                    return accept;
                }
                reject
            }
            }

            // Zone border and handles.
            if root.has-selection : Rectangle {
                x: root.sel-x * 1phx;
                y: root.sel-y * 1phx;
                width: root.sel-w * 1phx;
                height: root.sel-h * 1phx;
                border-width: 2phx;
                border-color: Theme.accent;
            }
            if root.has-selection && root.settled : Rectangle {
                x: 0phx; y: 0phx; width: 0phx; height: 0phx;
                for hx[i] in [0.0, 0.5, 1.0, 1.0, 1.0, 0.5, 0.0, 0.0] : Rectangle {
                    property <float> hy: [0.0, 0.0, 0.0, 0.5, 1.0, 1.0, 1.0, 0.5][i];
                    x: (root.sel-x + root.sel-w * hx) * 1phx - 5 * root.u;
                    y: (root.sel-y + root.sel-h * hy) * 1phx - 5 * root.u;
                    width: 10 * root.u;
                    height: 10 * root.u;
                    border-radius: 5 * root.u;
                    background: white;
                    border-width: 2phx;
                    border-color: Theme.accent;
                }
            }

            // Size label.
            if root.has-selection : Rectangle {
                x: root.size-x * 1phx;
                y: root.size-y * 1phx;
                height: 24 * root.u;
                width: label.preferred-width + 16 * root.u;
                background: Theme.flyout;
                border-radius: 4 * root.u;
                border-width: 1phx;
                border-color: Theme.stroke-strong;
                label := Text {
                    text: root.size-text;
                    color: Theme.text;
                    font-size: 12 * root.u;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Magnifier with reticle and the colour under the cursor.
            if root.has-magnifier : Rectangle {
                x: root.mag-x * 1phx;
                y: root.mag-y * 1phx;
                width: root.mag-size * 1phx;
                height: root.mag-size * 1phx + 28 * root.u;
                background: Theme.flyout;
                border-radius: 8 * root.u;
                border-width: 1phx;
                border-color: Theme.stroke-strong;
                clip: true;
                Image {
                    x: 0phx;
                    y: 0phx;
                    width: root.mag-size * 1phx;
                    height: root.mag-size * 1phx;
                    source: root.magnifier;
                    image-rendering: pixelated;
                }
                // reticle: the centre cell
                Rectangle {
                    x: (root.mag-size * 1phx - root.mag-size / 11 * 1phx) / 2;
                    y: self.x;
                    width: root.mag-size / 11 * 1phx;
                    height: self.width;
                    border-width: 1phx;
                    border-color: white;
                    Rectangle { border-width: 1phx; border-color: black; }
                }
                Rectangle {
                    x: 6 * root.u;
                    y: root.mag-size * 1phx + 6 * root.u;
                    width: 16 * root.u;
                    height: 16 * root.u;
                    background: root.mag-color;
                    border-width: 1phx;
                    border-color: white;
                }
                Text {
                    x: 28 * root.u;
                    y: root.mag-size * 1phx;
                    height: 28 * root.u;
                    text: root.mag-hex;
                    color: Theme.text;
                    font-size: 13 * root.u;
                    vertical-alignment: center;
                }
            }

            if root.has-text-input : text-field := TextInput {
                x: root.text-x * 1phx;
                y: root.text-y * 1phx;
                font-size: root.text-size * 1phx;
                color: root.current-color;
                text <=> root.text-value;
                accepted => { root.text-committed(self.text); }
                init => { self.focus(); }
            }

        }

        if root.scrolling && root.image-height > root.height / 1phx : Rectangle {
            x: root.width - 6 * root.u;
            y: root.scroll-y / root.image-height * root.height;
            width: 4 * root.u;
            height: Math.max(24 * root.u, root.height * root.height / (root.image-height * 1phx));
            background: #ffffff88;
            border-radius: 2 * root.u;
        }

        // Toolbar.
        if root.has-toolbar : Rectangle {
            x: root.toolbar-x * 1phx;
            y: root.toolbar-y * 1phx;
            width: 700 * root.u;
            height: 88 * root.u;
            background: Theme.dark ? #2c2c2cf5 : #fcfcfcf5;
            border-radius: 8 * root.u;
            border-width: 1phx;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 16phx;
            drop-shadow-color: #00000066;
            drop-shadow-offset-y: 4phx;

            TouchArea { } // swallows clicks on the bar itself

            // Row 1: tools, then actions.
            for ico[i] in [
                Icons.cursor, Icons.pen, Icons.line, Icons.arrow, Icons.square, Icons.circle, Icons.text,
                Icons.highlight, Icons.blur, Icons.pixelate, Icons.marker, Icons.eyedropper, Icons.crop,
            ] : IconButton {
                u: root.u;
                x: 8 * root.u + i * 32 * root.u;
                y: 8 * root.u;
                icon: ico;
                active: root.tool == i || (i == 12 && root.tool == -1);
                clicked => { root.tool-chosen(i); }
            }

            Rectangle {
                x: 8 * root.u + 13 * 32 * root.u + 5 * root.u;
                y: 12 * root.u;
                width: 1phx;
                height: 22 * root.u;
                background: Theme.divider;
            }

            // Row 1, right: undo/redo, then copy, save, save as, scrolling capture, OCR, close.
            for ico[i] in [
                Icons.undo, Icons.redo, Icons.copy, Icons.save, Icons.save-as, Icons.scroll, Icons.scan-text, Icons.dismiss,
            ] : IconButton {
                u: root.u;
                x: 8 * root.u + 13 * 32 * root.u + 12 * root.u + i * 32 * root.u;
                y: 8 * root.u;
                icon: ico;
                enabled: i == 0 ? root.can-undo : i == 1 ? root.can-redo : true;
                clicked => { root.action(["undo", "redo", "copy", "save", "save-as", "scroll", "ocr", "close"][i]); }
            }

            // Row 2: palette, recent colours, thickness, fill.
            for c[i] in root.palette : Swatch {
                u: root.u;
                x: 8 * root.u + i * 28 * root.u;
                y: 50 * root.u;
                swatch: c;
                chosen: c == root.current-color;
                clicked => { root.color-chosen(c); }
            }
            for c[i] in root.recent : Swatch {
                u: root.u;
                x: 8 * root.u + 9 * 28 * root.u + 10 * root.u + i * 28 * root.u;
                y: 50 * root.u;
                swatch: c;
                chosen: c == root.current-color;
                clicked => { root.color-chosen(c); }
            }
            // Full colour picker: opens the panel below/above the bar.
            Swatch {
                u: root.u;
                x: 8 * root.u + 8 * 28 * root.u;
                y: 50 * root.u;
                swatch: #00000000;
                chosen: root.picker-open;
                Icon { x: 4 * root.u; y: 4 * root.u; data: Icons.add; tint: Theme.text; size: 16 * root.u; }
                clicked => { root.picker-open = !root.picker-open; }
            }
            if root.picker-open : Rectangle {
                x: 8 * root.u;
                y: root.toolbar-y > 190 ? -176 * root.u : 96 * root.u;
                width: 280 * root.u;
                height: 168 * root.u;
                background: Theme.dark ? #2c2c2cf5 : #fcfcfcf5;
                border-radius: 8 * root.u;
                border-width: 1phx;
                border-color: Theme.stroke-strong;
                TouchArea { }
                // saturation (x) / value (y) square for the current hue
                sv := Rectangle {
                    x: 10 * root.u;
                    y: 10 * root.u;
                    width: 200 * root.u;
                    height: 120 * root.u;
                    background: Colors.hsv(root.hue, 1, 1, 1);
                    Rectangle { background: @linear-gradient(90deg, white, #ffffff00); }
                    Rectangle { background: @linear-gradient(180deg, #00000000, black); }
                    Rectangle {
                        x: root.sat * parent.width - 5 * root.u;
                        y: (1 - root.val) * parent.height - 5 * root.u;
                        width: 10 * root.u;
                        height: 10 * root.u;
                        border-radius: 5 * root.u;
                        border-width: 2 * root.u;
                        border-color: white;
                    }
                    TouchArea {
                        function pick() {
                            root.sat = max(0, min(1, self.mouse-x / self.width));
                            root.val = 1 - max(0, min(1, self.mouse-y / self.height));
                            root.color-chosen(Colors.hsv(root.hue, root.sat, root.val, 1));
                        }
                        pointer-event(e) => { if e.kind == PointerEventKind.down { self.pick(); } }
                        moved => { if self.pressed { self.pick(); } }
                    }
                }
                // hue bar
                Rectangle {
                    x: 222 * root.u;
                    y: 10 * root.u;
                    width: 24 * root.u;
                    height: 120 * root.u;
                    background: @linear-gradient(180deg, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000);
                    border-radius: 3 * root.u;
                    Rectangle {
                        y: root.hue / 360 * parent.height - 2 * root.u;
                        height: 4 * root.u;
                        background: white;
                        border-width: 1phx;
                        border-color: black;
                    }
                    TouchArea {
                        function pick() {
                            root.hue = 360 * max(0, min(0.999, self.mouse-y / self.height));
                            root.color-chosen(Colors.hsv(root.hue, root.sat, root.val, 1));
                        }
                        pointer-event(e) => { if e.kind == PointerEventKind.down { self.pick(); } }
                        moved => { if self.pressed { self.pick(); } }
                    }
                }
                // preview of the current colour
                Rectangle {
                    x: 10 * root.u;
                    y: 138 * root.u;
                    width: 24 * root.u;
                    height: 22 * root.u;
                    background: root.current-color;
                    border-radius: 4 * root.u;
                    border-width: 1phx;
                    border-color: Theme.stroke-strong;
                }
            }
            IconButton {
                u: root.u;
                x: 700 * root.u - 8 * root.u - 30 * root.u;
                y: 47 * root.u;
                icon: Icons.square;
                active: root.filled;
                clicked => { root.filled-toggled(); }
            }
            // Thickness: − value +
            IconButton {
                u: root.u;
                x: 700 * root.u - 8 * root.u - 30 * root.u - 4 * root.u - 30 * root.u - 40 * root.u - 30 * root.u;
                y: 47 * root.u;
                icon: Icons.subtract;
                clicked => { root.width-changed(root.stroke-width - 1); }
            }
            Text {
                x: 700 * root.u - 8 * root.u - 30 * root.u - 4 * root.u - 30 * root.u - 40 * root.u;
                y: 47 * root.u;
                width: 40 * root.u;
                height: 30 * root.u;
                text: round(root.stroke-width);
                color: Theme.text;
                font-size: 13 * root.u;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            IconButton {
                u: root.u;
                x: 700 * root.u - 8 * root.u - 30 * root.u - 4 * root.u - 30 * root.u;
                y: 47 * root.u;
                icon: Icons.add;
                clicked => { root.width-changed(root.stroke-width + 1); }
            }
        }
    }
}
