// The settings window: the tabs on the left, under the name of the program; the page on the right, its settings in
// cards, one card per group under the group's title. Rows are generic (a toggle, a choice, a folder…); the shortcuts,
// the updates and the about page have their own layouts. Plain Slint elements only (std-widgets would pull the SVG
// decoder in for its icons).
import { Theme, Icons, Icon, Card, Button, IconButton, Toggle, TextBox, ComboBox, NumberBox, Slider, NavItem, Group, GroupRow, InfoBar, ScrollArea, ProgressBar, SearchBox, ScreenPicker, LevelMeter, ColourField, Tip, TipLayer, Notes, NoteLine } from "controls.slint";

// A choice of a list with pictures (a program to record).
export struct SettingRow {
    id: string,
    label: string,
    // Shown on hover over the label.
    info: string,
    // Behind a warning sign beside the label (empty: nothing wrong).
    warning: string,
    // A short line under the label (an estimate).
    detail: string,
    suffix: string,
    // Belongs to the row above it (a program of its list): set in.
    nested: bool,
    // An eye beside the value shows what it changes.
    preview: bool,
    // A number's unit, chosen beside it: the id of its row (its choices in `options`, `selected`), else empty.
    unit-id: string,
    // 0 toggle, 1 choice, 2 number, 3 text, 4 folder, 5 info, 8 slider, 9 expander (`on`: open), 10 choice of a screen
    // edge, 11 choice of a place on the screen (its own place, if any, in `min` and `max`: thousandths across and down,
    // else -1), 12 colour (one, or a gradient's two: `colours`, their codes in `options`), 13 button (its text in
    // `text`)
    kind: int,
    enabled: bool,
    on: bool,
    text: string,
    num: int,
    // The number as it reads: grouped, with its unit (`10 000 kbit/s`). A number typed in has its unit in `text`.
    shown: string,
    // The microphone's level, live under the slider.
    meter: bool,
    min: int,
    max: int,
    step: int,
    // The value marked on a slider's track (-1: none).
    mark: int,
    colours: [color],
    // Colours ready to take; gradients too, their ends one after the other, and their values.
    swatches: [color],
    pairs: [color],
    pair-values: [string],
    options: [string],
    // The options that title the ones under them.
    headings: [bool],
    // How many of them are lines between groups.
    separators: int,
    // The options advised, marked so in the list.
    marks: [bool],
    // The options that usually do harm, in the warning colour.
    cautions: [bool],
    selected: int,
    // A picture before the label (a program's icon).
    icon: image,
    has-icon: bool,
    // New on a page already shown: it unfolds.
    fresh: bool,
    // No longer applies: it folds away, then goes.
    leaving: bool,
}

// A setting found by the search of the side navigation.
export struct SearchHit {
    label: string,
    // The page it is on, by its title and its index in the navigation.
    page: string,
    section: int,
}

// A card of this computer, on the general page.
export struct PcTile {
    // 0 processor, 1 graphics, 2 memory, 3 screen, 4 disk
    kind: int,
    title: string,
    detail: string,
    // What the part is, for screen readers.
    tip: string,
    // A disk's used share, 0 to 1 (-1: none).
    used: float,
    // A screen's width over its height, its number, and whether it is the main one.
    aspect: float,
    badge: string,
    primary: bool,
}

// Chevrons, 20x20: the open expander's, and the one that leads to a setting found.
global Glyphs {
    out property <string> chevron-right: "M7.64582 4.14708C7.84073 3.95147 8.15731 3.9509 8.35292 4.14582L13.8374 9.6108C14.0531 9.82574 14.0531 10.1751 13.8374 10.39L8.35292 15.855C8.15731 16.0499 7.84073 16.0493 7.64582 15.8537C7.4509 15.6581 7.45147 15.3415 7.64708 15.1466L12.8117 10.0004L7.64708 4.85418C7.45147 4.65927 7.4509 4.34269 7.64582 4.14708Z";
    out property <string> chevron-up: "M15.35 12.85A0.5 0.5 0 0 1 14.65 12.85L10 8.21L5.35 12.85A0.5 0.5 0 0 1 4.65 12.15L9.65 7.15A0.5 0.5 0 0 1 10.35 7.15L15.35 12.15A0.5 0.5 0 0 1 15.35 12.85Z";
}

// Release notes folded under their row, in the card of the rows above it: they unfold in place.
component NotesFold inherits VerticalLayout {
    in property <string> title;
    in property <[NoteLine]> lines;
    in property <bool> open;
    in property <bool> animated;
    callback clicked();

    GroupRow {
        title: root.title;
        glyph: Icons.sparkle;
        framed: false;
        divider: true;
        clickable: true;
        clicked => { root.clicked(); }
        Icon {
            data: root.open ? Glyphs.chevron-up : Icons.chevron-down;
            tint: Theme.text-2;
            size: 14px;
        }
    }
    Rectangle {
        clip: true;
        height: root.open ? notes.preferred-height + 20px : 0px;
        animate height { duration: root.animated ? Theme.t-normal : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        notes := Notes {
            x: 52px;
            y: 2px;
            width: parent.width - 52px - 20px;
            height: self.preferred-height;
            lines: root.lines;
            opacity: root.open ? 1 : 0;
            animate opacity { duration: root.animated ? Theme.t-normal : 0ms; }
        }
    }
}

// A scrolling page: its content in a column 24px from the left.
component Page inherits ScrollArea {
    in property <length> column;
    in property <length> gap: 28px;
    x: 0px;
    VerticalLayout {
        x: 24px;
        width: root.column;
        alignment: start;
        spacing: root.gap;
        padding-bottom: 32px;
        @children
    }
}

// One part of this computer: its icon (a screen: its outline, to scale), a figure or a name, a short line; a disk, how
// full it is.
component PcCard inherits Card {
    in property <PcTile> tile;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        Rectangle {
            width: 40px;
            if root.tile.kind != 3 : Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 24px;
                tint: Theme.text-2;
                data: root.tile.kind == 0 ? Icons.cpu
                    : root.tile.kind == 1 ? Icons.gpu
                    : root.tile.kind == 2 ? Icons.ram
                    : Icons.drive;
            }
            // The screen, drawn to its shape; the main one filled.
            if root.tile.kind == 3 : Rectangle {
                property <float> aspect: max(root.tile.aspect, 0.5);
                width: min(40px, 26px * self.aspect);
                height: self.width / self.aspect;
                border-radius: 3px;
                border-width: 1.5px;
                border-color: root.tile.primary ? Theme.text-2 : Theme.text-3;
                background: root.tile.primary ? Theme.control : transparent;
                Text {
                    text: root.tile.badge;
                    color: root.tile.primary ? Theme.text : Theme.text-3;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: root.tile.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // A disk: what is free, beside its letter.
                if root.tile.used >= 0 : Text {
                    text: root.tile.detail;
                    color: Theme.text-3;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            if root.tile.used >= 0 : Rectangle {
                height: 12px;
                Rectangle {
                    y: 5px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.control-stroke;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.tile.used, 0, 1);
                        border-radius: 2px;
                        // Under 20 % free: amber; under 5 %: red.
                        background: root.tile.used > 0.95 ? Theme.danger
                            : root.tile.used > 0.8 ? Theme.warning : Theme.accent;
                    }
                }
            }
            if root.tile.used < 0 && root.tile.detail != "" : Text {
                text: root.tile.detail;
                color: Theme.text-3;
                font-size: 12px;
                overflow: elide;
            }
        }
    }
    accessible-role: AccessibleRole.text;
    accessible-label: root.tile.tip + ": " + root.tile.title + " " + root.tile.detail;
}

// Cards side by side on one row (`max-rows`: on more when they do not fit), the last row sharing its width.
component PcTiles inherits Rectangle {
    in property <[PcTile]> tiles;
    in property <int> max-rows: 1;
    property <length> tile-h: 64px;
    property <length> gap: 8px;
    property <int> n: root.tiles.length;
    // As many as fit, then as even rows as can be (four on two rows: two and two).
    property <int> fit: max(1, min(root.n, floor((root.width + root.gap) / (240px + root.gap))));
    property <int> rows: min(root.max-rows, ceil(root.n / root.fit));
    property <int> cols: ceil(root.n / root.rows);
    height: root.rows * root.tile-h + (root.rows - 1) * root.gap;
    for tile[i] in root.tiles : PcCard {
        property <int> line: floor(i / root.cols);
        // The cards of this row.
        property <int> count: min(root.cols, root.n - self.line * root.cols);
        property <length> w: (root.width - (self.count - 1) * root.gap) / self.count;
        x: mod(i, root.cols) * (self.w + root.gap);
        y: self.line * (root.tile-h + root.gap);
        width: self.w;
        height: root.tile-h;
        tile: tile;
    }
}

// This computer at a glance: processor and memory, graphics, screens, disks.
component PcSheet inherits VerticalLayout {
    in property <[PcTile]> system;
    in property <[PcTile]> gpus;
    in property <[PcTile]> screens;
    in property <[PcTile]> disks;
    spacing: 8px;
    if root.system.length > 0 : PcTiles { tiles: root.system; }
    if root.gpus.length > 0 : PcTiles { tiles: root.gpus; }
    if root.screens.length > 0 : PcTiles { tiles: root.screens; }
    if root.disks.length > 0 : PcTiles {
        tiles: root.disks;
        max-rows: 2;
    }
}

// Rows shown together in a card, under their title (empty: none).
export struct SettingGroup {
    title: string,
    rows: [SettingRow],
}

// A group of actions of the shortcuts table, as one card: its rows in the table.
export struct ShortcutSpan {
    title: string,
    start: int,
    count: int,
}

export struct ShortcutKey {
    // `Ctrl+Shift+R` (empty: a free slot), and as the user reads it: `Ctrl + Shift + R`.
    text: string,
    shown: string,
    slot: int,
    // Kept by Windows or taken by another program (it does not reach Vixeeny): why, shown on hover over the red field
    // (empty: it works).
    tip: string,
}

export struct ShortcutRow {
    // Starts a new group of actions (shown apart from the one above).
    group-title: string,
    enabled: bool,
    label: string,
    // Always the two slots.
    keys: [ShortcutKey],
    error: string,
}

export struct LineItem {
    text: string,
    detail: string,
    selected: bool,
}

export struct UiTexts {
    github: string,
    logs: string,
    licenses: string,
    report: string,
    change: string,
    show: string,
    remove: string,
    add-shortcut: string,
    press-keys: string,
    keys-help: string,
    restart: string,
    no-shortcut: string,
    recommended: string,
    this-pc: string,
    reset: string,
    cancel: string,
    reset-page-body: string,
    reset-all: string,
    reset-all-title: string,
    reset-all-body: string,
    preview: string,
}

component SettingLine inherits GroupRow {
    in property <SettingRow> entry;
    in property <UiTexts> t;
    // The height of the window: a list opens upwards when it has no room below.
    in property <length> view-h;
    in property <bool> animated: true;
    // How loud the microphone is (a level meter row).
    in property <float> level;
    // Found by a search: outlined, and brought into view.
    in property <bool> highlighted;
    callback reveal(length);
    callback toggled(bool);
    callback chosen(int);
    callback number(int);
    callback sliding(bool);
    callback text-edited(string);
    callback colour(int, color);
    callback code(int, string);
    callback browse();
    callback action(string);
    callback unit-chosen(int);

    title: root.entry.label;
    info: root.entry.info;
    warning: root.entry.warning;
    // A folder's path under its name, else the row's own short line.
    description: root.entry.kind == 4 ? root.entry.text : root.entry.detail;
    framed: false;
    nested: root.entry.nested;
    icon: root.entry.icon;
    has-icon: root.entry.has-icon;
    unfold: root.entry.fresh && root.animated;
    fold: root.entry.leaving;
    flash: root.highlighted;
    // Once laid out, a row found by a search scrolls into view.
    Timer {
        interval: 30ms;
        running: root.highlighted;
        triggered => { self.running = false; root.reveal(root.absolute-position.y); }
    }
    glyph: root.entry.kind == 4 ? Icons.folder : "";
    dimmed: !root.entry.enabled && root.entry.kind != 5 && root.entry.kind != 6 && root.entry.kind != 13;
    stack-under: root.entry.kind == 3 ? 620px : 500px;
    clickable: (root.entry.kind == 0 || root.entry.kind == 9) && root.entry.enabled;
    clicked => { root.toggled(!root.entry.on); }

    if root.entry.kind == 9 : Rectangle {
        width: 32px;
        height: 32px;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            data: root.entry.on ? Glyphs.chevron-up : Icons.chevron-down;
            tint: Theme.text-2;
            size: 14px;
        }
    }
    // In the middle of the row's height, beside a taller preview button.
    if root.entry.kind == 0 : VerticalLayout {
        alignment: center;
        Toggle {
            on: root.entry.on;
            enabled: root.entry.enabled;
            toggled(v) => { root.toggled(v); }
        }
    }
    if root.entry.kind == 1 : ComboBox {
        // Every value of the page has the same width; a long choice is cut here, whole in the list.
        width: Theme.value-w;
        options: root.entry.options;
        headings: root.entry.headings;
        separators: root.entry.separators;
        marks: root.entry.marks;
        cautions: root.entry.cautions;
        mark-text: root.t.recommended;
        current: root.entry.selected;
        enabled: root.entry.enabled;
        selected(i) => { root.chosen(i); }
    }
    if root.entry.kind == 10 || root.entry.kind == 11 : ScreenPicker {
        corners: root.entry.kind == 11;
        options: root.entry.options;
        current: root.entry.selected;
        // A place of the user's: `min`, `max` (see the row's kind 11).
        custom-x: root.entry.kind == 11 ? root.entry.min : -1;
        custom-y: root.entry.kind == 11 ? root.entry.max : -1;
        selected(i) => { root.chosen(i); }
        placed(x, y) => { root.text-edited("custom:" + x + ":" + y); }
    }
    if root.entry.kind == 2 : HorizontalLayout {
        spacing: 8px;
        NumberBox {
            width: root.entry.unit-id != "" ? Theme.value-w - 128px : Theme.value-w;
            value: root.entry.num;
            lo: root.entry.min;
            hi: root.entry.max;
            enabled: root.entry.enabled;
            unit: root.entry.text;
            changed(v) => { root.number(v); }
        }
        if root.entry.unit-id != "" : ComboBox {
            width: 120px;
            options: root.entry.options;
            current: root.entry.selected;
            enabled: root.entry.enabled;
            selected(i) => { root.unit-chosen(i); }
        }
    }
    if root.entry.kind == 8 : VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 12px;
            Slider {
                width: Theme.value-w - 64px;
                value: root.entry.num;
                lo: root.entry.min;
                hi: root.entry.max;
                step: root.entry.step;
                mark: root.entry.mark;
                enabled: root.entry.enabled;
                changed(v) => { root.number(v); }
                sliding(on) => { root.sliding(on); }
            }
            Text {
                width: 52px;
                text: root.entry.shown != "" ? root.entry.shown : root.entry.num;
                color: Theme.text-2;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        // How loud the microphone is, under its volume: as long as the slider's track.
        if root.entry.meter : HorizontalLayout {
            padding-left: 10px;
            alignment: start;
            LevelMeter {
                width: Theme.value-w - 84px;
                height: 10px;
                level: root.level;
            }
        }
    }
    if root.entry.kind == 12 : ColourField {
        colours: root.entry.colours;
        codes: root.entry.options;
        swatches: root.entry.swatches;
        pairs: root.entry.pairs;
        pair-values: root.entry.pair-values;
        enabled: root.entry.enabled;
        picked(i, c) => { root.colour(i, c); }
        typed(i, s) => { root.code(i, s); }
        chosen(s) => { root.text-edited(s); }
        sliding(on) => { root.sliding(on); }
    }
    if root.entry.kind == 3 : TextBox {
        width: Theme.value-w;
        text: root.entry.text;
        suffix: root.entry.suffix;
        enabled: root.entry.enabled;
        accepted(s) => { root.text-edited(s); }
    }
    if root.entry.kind == 4 : HorizontalLayout {
        spacing: 8px;
        Button { text: root.t.show; clicked => { root.action("open"); } }
        Button { text: root.t.change; clicked => { root.browse(); } }
    }
    if root.entry.kind == 13 : Button {
        text: root.entry.text;
        enabled: root.entry.enabled;
        clicked => { root.action("press"); }
    }
    if root.entry.kind == 5 : Text {
        max-width: 300px;
        text: root.entry.text;
        color: Theme.text-2;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    // The preview, after the value: the eyes of a page make one column.
    if root.entry.preview : Button {
        width: 32px;
        icon: Icons.eye;
        tip: root.t.preview;
        clicked => { root.action("preview"); }
    }
}

// A shortcut of an action, as a field: its keys (or "none"); a click records new ones, shown as they are held; the
// cross empties it.
component ShortcutField inherits Rectangle {
    in property <ShortcutKey> key;
    in property <bool> enabled: true;
    in property <bool> recording;
    // The keys held while it records.
    in property <string> held;
    in property <UiTexts> t;
    callback record();
    callback clear();

    property <string> shown: root.recording ? root.held : root.key.shown;
    property <bool> removable: root.key.text != "" && !root.recording;
    property <bool> warned: root.key.tip != "" && !root.recording;
    height: 32px;
    border-radius: Theme.radius;
    border-color: root.recording ? Theme.accent : (root.warned ? Theme.danger : Theme.control-stroke);
    border-width: root.warned && !root.recording ? 2px : 1px;
    background: root.recording ? Theme.accent-soft
        : (touch.has-hover ? Theme.control-hover : Theme.control);
    clip: true;
    animate background, border-color { duration: Theme.t-fast; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.record(); }
        // Why it is red, while the pointer rests on it.
        changed has-hover => {
            if self.has-hover && root.warned {
                Tip.text = root.key.tip;
                Tip.left = root.absolute-position.x;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
            } else if Tip.text == root.key.tip {
                Tip.text = "";
            }
        }
    }
    Text {
        x: 10px;
        width: parent.width - (root.removable ? 38px : 20px);
        text: root.shown != "" ? root.shown
            : (root.recording ? root.t.press-keys : root.t.no-shortcut);
        color: root.shown != "" ? (root.warned && !root.recording ? Theme.danger : Theme.text)
            : (root.recording ? Theme.accent : Theme.text-3);
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.removable : IconButton {
        x: parent.width - self.width - 4px;
        y: (parent.height - self.height) / 2;
        icon: Icons.dismiss;
        enabled: root.enabled;
        label: root.t.remove;
        size: 24px;
        tint: Theme.text-3;
        clicked => { root.clear(); }
    }
    accessible-role: button;
    accessible-label: root.key.text != "" ? root.key.text : root.t.add-shortcut;
}

// One action of the shortcuts table, a row of its group's card: its name (and what went wrong) on the left, its two
// shortcuts in the columns on the right. The second column is a mere "+" until a second shortcut is set somewhere
// (`second-w` narrow).
component ShortcutLine inherits Rectangle {
    in property <ShortcutRow> entry;
    in property <bool> recording-here;
    in property <int> recording-slot;
    in property <string> held;
    in property <length> key-w;
    in property <length> second-w;
    // Under the row above it in the card.
    in property <bool> divider;
    in property <UiTexts> t;
    callback record(int);
    callback clear(int);

    opacity: root.entry.enabled ? 1 : 0.45;
    property <string> detail: root.entry.error;
    property <bool> compact: root.second-w < root.key-w;
    height: max(64px, info.preferred-height + 28px);
    if root.divider : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.stroke;
    }
    info := VerticalLayout {
        x: 16px;
        y: (parent.height - self.preferred-height) / 2;
        width: root.width - 44px - root.key-w - root.second-w;
        height: self.preferred-height;
        spacing: 2px;
        Text {
            text: root.entry.label;
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
        }
        if root.detail != "" : Text {
            text: root.detail;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    for key[k] in root.entry.keys : Rectangle {
        x: k == 0 ? root.width - 16px - root.second-w - root.key-w : root.width - 16px - root.second-w;
        y: (parent.height - 32px) / 2;
        width: (k == 0 ? root.key-w : root.second-w) - 8px;
        height: 32px;
        if k == 0 || !root.compact : ShortcutField {
            width: parent.width;
            key: key;
            enabled: root.entry.enabled;
            recording: root.recording-here && root.recording-slot == key.slot;
            held: root.held;
            t: root.t;
            record => { root.record(key.slot); }
            clear => { root.clear(key.slot); }
        }
        if k == 1 && root.compact : IconButton {
            icon: Icons.add;
            label: root.t.add-shortcut;
            tip: root.t.add-shortcut;
            enabled: root.entry.enabled;
            clicked => { root.record(key.slot); }
        }
    }
}

// A button of the window's corner (minimize, maximize, close), as Windows draws them.
component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    width: 46px;
    height: 36px;
    background: root.danger && touch.has-hover ? (touch.pressed ? #c42b1ccc : #c42b1c)
        : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        size: 14px;
        tint: root.danger && touch.has-hover ? #ffffff : Theme.text;
        animate tint { duration: Theme.t-fast; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

export component SettingsWindow inherits Window {
    in property <UiTexts> t;
    in property <[string]> section-titles;
    // 0 general, 1 overlay, 2 image, 3 video, 4 sound, 5 replay, 6 shortcuts, 7 notifications, 8 updates, 9 about
    in-out property <int> section: 0;
    in property <[SettingGroup]> groups;
    // The about page: this computer.
    in property <[PcTile]> pc-system;
    in property <[PcTile]> pc-gpus;
    in property <[PcTile]> pc-screens;
    in property <[PcTile]> pc-disks;
    // A message above the groups (problems with the video settings).
    in property <string> notice;
    in property <[ShortcutRow]> shortcuts;
    // Its cards, and whether a second shortcut is set anywhere (the second column drawn whole).
    in property <[ShortcutSpan]> shortcut-spans;
    in property <bool> two-columns;
    // The shortcut being recorded (-1: none).
    in property <int> recording-row: -1;
    in property <int> recording-slot: -1;
    // The keys held while it is recorded.
    in property <string> recording-keys;
    in property <[LineItem]> lines;
    in property <string> extra;
    // Off in the tests, where no time passes: what animates is shown at its end at once.
    in property <bool> animated: true;
    // The search of the side navigation: what is typed, and what answers it.
    in-out property <string> search-text;
    in property <[SearchHit]> search-hits;
    in property <string> search-placeholder;
    in property <string> search-title;
    in property <string> search-none;
    // The row a search led to (outlined for a moment).
    in property <string> highlight-id;
    // How loud the microphone is now, 0 to 1.
    in property <float> mic-level;

    // The about page: the version.
    in property <string> version;
    // The updates page: 0 up to date (or not checked), 1 checking, 2 available, 3 downloading, 4 ready, 5 failed, 6
    // restarting
    in property <int> update-state: 0;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress: 0;
    in property <string> update-action;
    // What changed in the version offered (or this one), under a heading that folds it.
    in property <string> update-notes-title;
    in property <[NoteLine]> update-notes;
    in-out property <bool> notes-open: true;
    public function toggle-notes() { root.notes-open = !root.notes-open; }
    // The page holds a setting changed from how it comes (its reset button works), and the question its reset asks.
    in property <bool> page-changed;
    in property <string> reset-page-title;
    // The question on screen: 0 none, 1 reset the page, 2 reset everything.
    in-out property <int> confirming: 0;

    callback section-changed(int);
    callback row-toggled(string, bool);
    callback row-chosen(string, int);
    callback row-number(string, int);
    callback row-sliding(bool);
    callback row-text(string, string);
    // A colour of a colour row (by its place: a gradient's start or end), picked or typed.
    callback row-colour(string, int, color);
    callback row-code(string, int, string);
    callback row-browse(string);
    callback row-action(string, string);
    callback shortcut-record(int, int);
    callback shortcut-clear(int, int);
    callback page-action(string, string);
    callback search-edited(string);
    callback search-picked(int);
    callback reset-page();
    callback reset-all();

    // The window has no system frame: its title bar is drawn here.
    in property <bool> zoomed: false;
    callback drag-window();
    callback minimize-window();
    callback toggle-maximized();
    callback close-window();
    // 0 east, 1 north, 2 north-east, 3 north-west, 4 south, 5 south-east, 6 south-west, 7 west
    callback resize-window(int);

    title: "Vixeeny";
    no-frame: true;
    icon: Theme.app-icon;
    background: Theme.bg;
    min-width: 960px;
    min-height: 640px;
    preferred-width: 1040px;
    preferred-height: 760px;
    default-font-family: Theme.font;

    property <bool> searching: root.search-text != "";
    property <bool> is-rows: root.section != 4 && root.section != 8 && !root.searching;
    // The first tab and the title of the page share this line.
    property <length> top: 52px;
    property <length> tab-h: 38px;
    // The page rises into place when it changes (it never disappears: no flash).
    property <bool> page-settled: true;

    pure function nav-icon(i: int) -> string {
        return i == 0 ? Icons.settings
            : i == 1 ? Icons.image
            : i == 2 ? Icons.video
            : i == 3 ? Icons.history
            : i == 4 ? Icons.keyboard
            : i == 5 ? Icons.layer
            : i == 6 ? Icons.alert
            : i == 7 ? Icons.download
            : Icons.info;
    }
    function go(i: int) {
        if root.searching { search.clear(); }
        if i == root.section { return; }
        root.section = i;
        root.page-settled = false;
        settle.running = true;
        root.section-changed(i);
    }

    settle := Timer {
        interval: 16ms;
        running: false;
        triggered => { self.running = false; root.page-settled = true; }
    }

    // Placed by hand rather than by a layout: the width of the navigation follows the width of the window, which a
    // layout would make depend on the navigation in turn.
    nav := Rectangle {
        x: 0px;
        y: 0px;
        height: root.height;
        width: 220px;
        // The name of the program, in the title bar.
        HorizontalLayout {
            x: 24px;
            y: 0px;
            height: 44px;
            spacing: 10px;
            Image {
                source: Theme.app-icon;
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Vixeeny";
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        // The search, on the line of the page's title.
        search := SearchBox {
            x: 12px;
            y: root.top + (root.tab-h - 2px - self.height) / 2;
            width: parent.width - 24px;
            placeholder: root.search-placeholder;
            text <=> root.search-text;
            edited(text) => { root.search-edited(text); }
        }
        // The tabs under it; the last two (updates, about) at the bottom of the column.
        property <int> bottom-tabs: 2;
        for title[i] in root.section-titles : NavItem {
            property <int> from-end: root.section-titles.length - i;
            x: 12px;
            y: self.from-end <= nav.bottom-tabs
                ? max(root.height - 12px - self.from-end * root.tab-h, root.top + root.tab-h + 20px + i * root.tab-h)
                : root.top + root.tab-h + 20px + i * root.tab-h;
            width: parent.width - 24px;
            height: root.tab-h - 2px;
            text: title;
            icon: root.nav-icon(i);
            badge: i == 7 && (root.update-state == 2 || root.update-state == 4);
            current: i == root.section && !root.searching;
            animated: root.animated;
            clicked => { root.go(i); }
        }
    }

    // ---- the page
    page := Rectangle {
        x: nav.width;
        y: root.page-settled ? 0px : 8px;
        animate y { duration: root.page-settled && root.animated ? Theme.t-slow : 0ms; easing: cubic-bezier(0.1, 0.9, 0.2, 1); }
        width: root.width - nav.width;
        height: root.height;
        // The column of the page: as wide as the window allows, up to a comfortable width.
        property <length> column: min(self.width - 56px, 1000px);

        // ---- the title of the page, on the line of the first tab: their texts share a baseline (both are centred in
        // the same height; the baseline sits ≈ 0.41 em under the centre, so the larger title is raised by the
        // difference).
        page-title := Text {
            x: 24px;
            y: root.top - (24px - 14px) * 0.41;
            width: page.column - (reset.visible ? reset.width + 12px : 0px);
            height: root.tab-h - 2px;
            text: root.searching ? root.search-title
                : (root.section >= 0 && root.section < root.section-titles.length ? root.section-titles[root.section] : "");
            color: Theme.text;
            font-size: 24px;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        // Back to how the page comes, at the end of the title's line: only once changed.
        reset := IconButton {
            visible: root.section != 8 && !root.searching;
            x: 24px + page.column - self.width;
            y: page-title.y + (page-title.height - self.height) / 2;
            icon: Icons.arrow-reset;
            label: root.t.reset;
            tip: root.page-changed ? root.t.reset : "";
            enabled: root.page-changed;
            clicked => { root.confirming = 1; }
        }
        // While a shortcut is recorded: how, under the title.
        if root.section == 4 && root.recording-row >= 0 && !root.searching : Text {
            x: 24px;
            y: root.top + root.tab-h;
            width: page.column;
            text: root.t.keys-help;
            color: Theme.accent;
            font-size: 12px;
            overflow: elide;
        }

        body := Rectangle {
            x: 0px;
            y: root.top + root.tab-h + 20px;
            width: parent.width;
            height: parent.height - self.y;

            // ---- pages made of rows (and the updates page)
            if root.is-rows : rows-area := Page {
                width: parent.width - 8px;
                height: parent.height;
                column: page.column;
                if root.notice != "" : InfoBar {
                    kind: 1;
                    text: root.notice;
                }
                // Where the update stands, and what to do about it.
                if root.section == 7 : Group {
                    GroupRow {
                        title: root.update-title;
                        description: root.update-detail;
                        glyph: root.update-state == 5 ? Icons.error
                            : (root.update-state == 0 ? Icons.checkmark-circle : Icons.download);
                        // Up to date: green.
                        tint: root.update-state == 0 ? Theme.success : Theme.text;
                        if root.update-state == 3 || root.update-state == 6 : ProgressBar {
                            width: 160px;
                            value: root.update-state == 6 ? 1 : root.update-progress;
                        }
                        if root.update-action != "" && root.update-state != 1 && root.update-state != 3 && root.update-state != 6 : Button {
                            accent: root.update-state == 2 || root.update-state == 4;
                            text: root.update-action;
                            clicked => {
                                root.page-action(root.update-state == 2 ? "update-download"
                                    : root.update-state == 4 ? "update-restart" : "update-check", "");
                            }
                        }
                    }
                }
                // A group: its title, then its rows in one card.
                for g[gi] in root.groups : VerticalLayout {
                    spacing: 8px;
                    if g.title != "" : Text {
                        text: g.title;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Card {
                        clip: true;
                        VerticalLayout {
                    for r[i] in g.rows : SettingLine {
                        // A setting that belongs to the one above goes with it, without a line between them.
                        divider: i > 0 && !r.nested;
                        entry: r;
                        t: root.t;
                        view-h: root.height;
                        animated: root.animated;
                        level: root.mic-level;
                        highlighted: r.id != "" && r.id == root.highlight-id;
                        reveal(y) => { rows-area.reveal(y); }
                        toggled(v) => { root.row-toggled(r.id, v); }
                        chosen(k) => { root.row-chosen(r.id, k); }
                        unit-chosen(k) => { root.row-chosen(r.unit-id, k); }
                        number(v) => { root.row-number(r.id, v); }
                        sliding(on) => { root.row-sliding(on); }
                        text-edited(s) => { root.row-text(r.id, s); }
                        colour(i, c) => { root.row-colour(r.id, i, c); }
                        code(i, s) => { root.row-code(r.id, i, s); }
                        browse => { root.row-browse(r.id); }
                        action(a) => { root.row-action(r.id, a); }
                    }

                        }
                    }
                }
                if root.section == 7 && root.update-notes.length > 0 : Card {
                    VerticalLayout {
                        NotesFold {
                            title: root.update-notes-title;
                            lines: root.update-notes;
                            open: root.notes-open;
                            animated: root.animated;
                            clicked => { root.toggle-notes(); }
                        }
                    }
                }
                // All the pages back to how they come.
                if root.section == 0 : VerticalLayout {
                    padding-top: 12px;
                    Group {
                        GroupRow {
                            title: root.t.reset-all;
                            Button {
                                text: root.t.reset;
                                danger: true;
                                clicked => { root.confirming = 2; }
                            }
                        }
                    }
                }
            }

            // ---- the answers of a search: each leads to its setting
            if root.searching : Page {
                width: parent.width - 8px;
                height: parent.height;
                column: page.column;
                gap: 4px;
                if root.search-hits.length == 0 : Text {
                    text: root.search-none;
                    color: Theme.text-2;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                for hit[i] in root.search-hits : GroupRow {
                    title: hit.label;
                    description: hit.page;
                    glyph: root.nav-icon(hit.section);
                    clickable: true;
                    clicked => { root.search-picked(i); }
                    Icon {
                        data: Glyphs.chevron-right;
                        tint: Theme.text-2;
                        size: 14px;
                    }
                }
            }

            // ---- shortcuts: a table, one row per action and a column per shortcut (two at most)
            if root.section == 4 && !root.searching : Rectangle {
                width: parent.width;
                height: parent.height;
                property <length> key-w: max(180px, min(240px, (page.column - 220px) / 2));
                // A "+" until a second shortcut is set (or being recorded).
                property <length> second-w: root.two-columns || (root.recording-row >= 0 && root.recording-slot == 1) ? self.key-w : 40px;
                Page {
                    width: parent.width - 8px;
                    height: parent.height;
                    column: page.column;
                    for span in root.shortcut-spans : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: span.title;
                            color: Theme.text-2;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        Card {
                            clip: true;
                            VerticalLayout {
                                for k in span.count : ShortcutLine {
                                    property <int> i: span.start + k;
                                    entry: root.shortcuts[self.i];
                                    divider: k > 0;
                                    recording-here: root.recording-row == self.i;
                                    recording-slot: root.recording-slot;
                                    held: root.recording-keys;
                                    key-w: key-w;
                                    second-w: second-w;
                                    t: root.t;
                                    record(slot) => { root.shortcut-record(self.i, slot); }
                                    clear(slot) => { root.shortcut-clear(self.i, slot); }
                                }
                            }
                        }
                    }
                }
            }

            // ---- about: who we are, this machine, the links
            if root.section == 8 && !root.searching : Page {
                width: parent.width - 8px;
                height: parent.height;
                column: page.column;
                Card {
                    height: who.preferred-height;
                    who := HorizontalLayout {
                        padding: 20px;
                        spacing: 16px;
                        Image {
                            source: Theme.app-icon;
                            width: 48px;
                            height: 48px;
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Vixeeny"; color: Theme.text; font-size: 18px; font-weight: 700; }
                            Text { text: root.version; color: Theme.text-2; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
                if root.lines.length > 0 : Group {
                    for line in root.lines : GroupRow {
                        title: line.text;
                        description: line.detail;
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Button { icon: Icons.github; text: root.t.github; clicked => { root.page-action("github", ""); } }
                        Button { icon: Icons.folder-open; text: root.t.logs; clicked => { root.page-action("logs", ""); } }
                        Button { icon: Icons.document; text: root.t.licenses; clicked => { root.page-action("licenses", ""); } }
                        Button { icon: Icons.bug; text: root.t.report; clicked => { root.page-action("report", ""); } }
                    }
                    if root.extra != "" : Text {
                        text: root.extra;
                        color: Theme.text-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
                // This computer.
                if root.pc-system.length + root.pc-gpus.length + root.pc-screens.length + root.pc-disks.length > 0 : VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: root.t.this-pc;
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }
                    PcSheet {
                        system: root.pc-system;
                        gpus: root.pc-gpus;
                        screens: root.pc-screens;
                        disks: root.pc-disks;
                    }
                }
            }
        }
    }

    // ---- the title bar: the top of the window moves it; its buttons at the top right
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width - 3 * 46px;
        height: 36px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag-window(); }
        }
        double-clicked => { root.toggle-maximized(); }
    }
    HorizontalLayout {
        x: root.width - self.width;
        y: 0px;
        width: 3 * 46px;
        height: 36px;
        CaptionButton { icon: Icons.minimize; label: "Minimize"; clicked => { root.minimize-window(); } }
        CaptionButton { icon: root.zoomed ? Icons.restore : Icons.maximize; label: "Maximize"; clicked => { root.toggle-maximized(); } }
        CaptionButton { icon: Icons.dismiss; label: "Close"; danger: true; clicked => { root.close-window(); } }
    }

    // ---- the edges resize the window (not when it fills the screen)
    if !root.zoomed : Rectangle {
        property <length> e: 5px;
        TouchArea { x: 0px; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(7); } } }
        TouchArea { x: root.width - e; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(0); } } }
        TouchArea { x: e; y: 0px; width: root.width - 2 * e - 3 * 46px; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(1); } } }
        TouchArea { x: e; y: root.height - e; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(4); } } }
        TouchArea { x: 0px; y: 0px; width: 2 * e; height: 2 * e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(3); } } }
        TouchArea { x: root.width - e; y: 0px; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(2); } } }
        TouchArea { x: 0px; y: root.height - 2 * e; width: 2 * e; height: 2 * e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(6); } } }
        TouchArea { x: root.width - 2 * e; y: root.height - 2 * e; width: 2 * e; height: 2 * e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(5); } } }
    }
    // ---- the question before a reset: over the whole window, which it dims
    if root.confirming != 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000066;
        // A click beside the question, or Esc, leaves everything as it is.
        TouchArea { clicked => { root.confirming = 0; } }
        keys := FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if e.text == Key.Escape { root.confirming = 0; return accept; }
                reject
            }
        }
        Rectangle {
            width: min(440px, parent.width - 48px);
            height: col.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-flyout;
            border-width: 1px;
            border-color: Theme.stroke;
            background: Theme.flyout;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000059;
            // Clicks on the question stay on it.
            TouchArea { }
            col := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.confirming == 1 ? root.reset-page-title : root.t.reset-all-title;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirming == 1 ? root.t.reset-page-body : root.t.reset-all-body;
                    color: Theme.text-2;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    padding-top: 12px;
                    Button {
                        text: root.t.cancel;
                        clicked => { root.confirming = 0; }
                    }
                    Button {
                        text: root.t.reset;
                        accent: true;
                        danger: true;
                        clicked => {
                            if root.confirming == 1 { root.reset-page(); } else { root.reset-all(); }
                            root.confirming = 0;
                        }
                    }
                }
            }
        }
    }
    // Above everything; it takes no clicks.
    TipLayer {
        width: root.width;
        height: root.height;
    }
}
