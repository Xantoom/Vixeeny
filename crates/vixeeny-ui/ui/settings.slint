// The settings window (plan 5.13), in the style of the Windows 11 Settings app: a navigation on
// the left, the title of the page and its cards on the right. Rows of settings are generic (a
// toggle, a choice, a number…); the gallery, shortcuts, profiles, hardware, updates and about
// pages have their own layouts. Plain Slint elements only (std-widgets would pull the SVG
// decoder in for its icons).
import { Theme, Icons, Icon, Button, IconButton, Toggle, TextBox, ComboBox, NumberBox, Slider, Segmented, NavItem, SettingsCard, SectionLabel, InfoBar, Chip, ScrollArea } from "controls.slint";

export struct SettingRow {
    id: string,
    label: string,
    hint: string,
    // 0 toggle, 1 choice, 2 number, 3 text, 4 folder, 5 info, 6 header, 7 segmented, 8 slider
    kind: int,
    enabled: bool,
    on: bool,
    text: string,
    num: int,
    min: int,
    max: int,
    step: int,
    options: [string],
    selected: int,
}

export struct GalleryItem {
    name: string,
    detail: string,
    thumb: image,
    has-thumb: bool,
    video: bool,
    selected: bool,
}

export struct ShortcutKey {
    text: string,
    slot: int,
}

export struct ShortcutRow {
    label: string,
    keys: [ShortcutKey],
    // The slot a new shortcut would take (-1: all three are used).
    free-slot: int,
    error: string,
}

export struct LineItem {
    text: string,
    detail: string,
    selected: bool,
    strong: bool,
}

export struct UiTexts {
    reset: string,
    new-label: string,
    duplicate: string,
    rename: string,
    delete: string,
    use-label: string,
    open: string,
    open-folder: string,
    copy: string,
    all: string,
    images: string,
    videos: string,
    app-filter: string,
    redetect: string,
    check-now: string,
    update-now: string,
    github: string,
    logs: string,
    copy-info: string,
    empty: string,
    name-hint: string,
    choose: string,
    press-keys: string,
    keys-help: string,
    add-shortcut: string,
    details: string,
}

component SettingLine inherits Rectangle {
    in property <SettingRow> entry;
    in property <UiTexts> t;
    callback toggled(bool);
    callback chosen(int);
    callback number(int);
    callback text-edited(string);
    callback browse();

    preferred-height: root.entry.kind == 6 ? 48px : card.preferred-height;
    min-height: root.entry.kind == 6 ? 48px : 56px;

    if root.entry.kind == 6 : SectionLabel {
        x: 2px;
        y: parent.height - self.preferred-height - 6px;
        width: parent.width - 4px;
        text: root.entry.label;
    }
    card := SettingsCard {
        visible: root.entry.kind != 6;
        title: root.entry.label;
        description: root.entry.hint;
        dimmed: !root.entry.enabled && root.entry.kind != 5;
        if root.entry.kind == 0 : Toggle {
            on: root.entry.on;
            enabled: root.entry.enabled;
            toggled(v) => { root.toggled(v); }
        }
        if root.entry.kind == 1 : ComboBox {
            width: 240px;
            options: root.entry.options;
            current: root.entry.selected;
            enabled: root.entry.enabled;
            selected(i) => { root.chosen(i); }
        }
        if root.entry.kind == 7 : Segmented {
            options: root.entry.options;
            current: root.entry.selected;
            enabled: root.entry.enabled;
            selected(i) => { root.chosen(i); }
        }
        if root.entry.kind == 2 : NumberBox {
            value: root.entry.num;
            lo: root.entry.min;
            hi: root.entry.max;
            step: root.entry.step;
            enabled: root.entry.enabled;
            changed(v) => { root.number(v); }
        }
        if root.entry.kind == 8 : HorizontalLayout {
            spacing: 12px;
            Slider {
                width: 220px;
                value: root.entry.num;
                lo: root.entry.min;
                hi: root.entry.max;
                step: root.entry.step;
                enabled: root.entry.enabled;
                changed(v) => { root.number(v); }
            }
            Text {
                width: 44px;
                text: root.entry.num;
                color: Theme.text-2;
                font-size: 14px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        if root.entry.kind == 3 : TextBox {
            width: 320px;
            text: root.entry.text;
            enabled: root.entry.enabled;
            accepted(s) => { root.text-edited(s); }
        }
        if root.entry.kind == 4 : HorizontalLayout {
            spacing: 8px;
            TextBox {
                width: 300px;
                text: root.entry.text;
                enabled: root.entry.enabled;
                accepted(s) => { root.text-edited(s); }
            }
            Button {
                icon: Icons.folder-open;
                text: root.t.choose;
                clicked => { root.browse(); }
            }
        }
        if root.entry.kind == 5 : Text {
            max-width: 320px;
            text: root.entry.text;
            color: Theme.text-2;
            font-size: 14px;
            horizontal-alignment: right;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
}

// A page of cards for lines of text (hardware, profiles, about…).
component LineCard inherits Rectangle {
    in property <LineItem> line;
    in property <bool> pickable: false;
    callback clicked();
    preferred-height: layout.preferred-height;
    min-height: 52px;
    border-radius: Theme.radius-card;
    border-width: root.line.selected ? 2px : 1px;
    border-color: root.line.selected ? Theme.accent : Theme.stroke;
    background: root.line.selected ? Theme.accent-soft : (touch.has-hover && root.pickable ? Theme.card-hover : Theme.card);
    animate background { duration: Theme.t-fast; }
    layout := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.line.text;
            color: Theme.text;
            font-size: 14px;
            font-weight: root.line.strong ? 600 : 400;
            wrap: word-wrap;
        }
        if root.line.detail != "" : Text {
            text: root.line.detail;
            color: Theme.text-2;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        enabled: root.pickable;
        mouse-cursor: root.pickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component Tile inherits Rectangle {
    in property <GalleryItem> item;
    callback clicked();
    callback opened();
    border-radius: Theme.radius-card;
    border-width: root.item.selected ? 2px : 1px;
    border-color: root.item.selected ? Theme.accent : (touch.has-hover ? Theme.stroke-strong : Theme.stroke);
    background: root.item.selected ? Theme.accent-soft : Theme.card;
    animate border-color { duration: Theme.t-fast; }
    clip: true;
    Rectangle {
        height: parent.height - 64px;
        background: Theme.bg-deep;
        clip: true;
        if root.item.has-thumb : Image {
            source: root.item.thumb;
            image-fit: cover;
            width: parent.width;
            height: parent.height;
        }
        if !root.item.has-thumb : Icon {
            data: root.item.video ? Icons.video : Icons.image;
            tint: Theme.text-3;
            size: 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if root.item.video : Rectangle {
            x: parent.width - 36px;
            y: 8px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: #000000a0;
            Icon {
                data: Icons.play-filled;
                tint: white;
                size: 14px;
                x: 8px;
                y: 7px;
            }
        }
    }
    VerticalLayout {
        y: parent.height - 62px;
        height: 60px;
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        spacing: 1px;
        Text {
            text: root.item.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.item.detail;
            color: Theme.text-2;
            font-size: 12px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.opened(); }
    }
    accessible-role: button;
    accessible-label: root.item.name;
}

component KeyChip inherits Rectangle {
    in property <string> text;
    in property <bool> recording: false;
    callback clicked();
    callback cleared();
    height: 32px;
    preferred-width: row.preferred-width + 8px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.recording ? Theme.accent : Theme.control-stroke;
    background: root.recording ? Theme.accent-soft : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
        if !root.recording : IconButton {
            icon: Icons.dismiss;
            size: 24px;
            y: (parent.height - self.height) / 2;
            clicked => { root.cleared(); }
        }
    }
    touch := TouchArea {
        z: -1;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SettingsWindow inherits Window {
    in property <string> window-title: "Vixeeny";
    in property <UiTexts> t;
    in property <[string]> section-titles;
    // 0 gallery, 1 general, 2 shortcuts, 3 images, 4 video, 5 audio, 6 replay, 7 folders, 8 ocr,
    // 9 profiles, 10 hardware, 11 updates, 12 about
    in-out property <int> section: 1;
    in property <[SettingRow]> rows;
    // A message above the rows (problems with the video settings).
    in property <string> notice;
    in property <[GalleryItem]> gallery;
    in property <[ShortcutRow]> shortcuts;
    // The shortcut being recorded (-1: none).
    in property <int> recording-row: -1;
    in property <int> recording-slot: -1;
    in property <[LineItem]> lines;
    in property <string> extra;
    in property <string> rename-text;
    in-out property <int> gallery-kind: 0;
    in property <int> gallery-selected: -1;
    in property <string> gallery-detail;

    callback section-changed(int);
    callback reset();
    callback row-toggled(string, bool);
    callback row-chosen(string, int);
    callback row-number(string, int);
    callback row-text(string, string);
    callback row-browse(string);
    callback gallery-select(int);
    callback gallery-open(int);
    callback gallery-action(string);
    callback gallery-filter(int, string);
    callback shortcut-record(int, int);
    callback shortcut-clear(int, int);
    callback line-select(int);
    callback page-action(string, string);

    title: root.window-title;
    icon: Theme.app-icon;
    background: Theme.bg;
    min-width: 820px;
    min-height: 540px;
    preferred-width: 1120px;
    preferred-height: 780px;
    default-font-family: Theme.font;

    property <bool> is-rows: root.section == 1 || root.section == 3 || root.section == 4 || root.section == 5 || root.section == 6 || root.section == 7 || root.section == 8 || root.section == 11;
    property <bool> is-lines: root.section == 10 || root.section == 12;

// The icon of each section of the navigation (same order as `Section::ALL`).
        pure function nav-icon(i: int) -> string {
        return i == 0 ? Icons.images
            : i == 1 ? Icons.settings
            : i == 2 ? Icons.keyboard
            : i == 3 ? Icons.image
            : i == 4 ? Icons.video
            : i == 5 ? Icons.speaker
            : i == 6 ? Icons.history
            : i == 7 ? Icons.folder
            : i == 8 ? Icons.scan-text
            : i == 9 ? Icons.slider
            : i == 10 ? Icons.device
            : i == 11 ? Icons.download
            : Icons.info;
    }

    HorizontalLayout {
        // ---- navigation
        Rectangle {
            width: 268px;
            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 14px;
                padding-bottom: 10px;
                spacing: 2px;
                alignment: start;
                HorizontalLayout {
                    height: 56px;
                    padding-left: 10px;
                    spacing: 12px;
                    Image {
                        source: Theme.app-icon;
                        width: 28px;
                        height: 28px;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Vixeeny";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                for title[i] in root.section-titles : NavItem {
                    text: title;
                    icon: root.nav-icon(i);
                    current: i == root.section;
                    clicked => { root.section = i; root.section-changed(i); }
                }
            }
        }

        // ---- the page
        VerticalLayout {
            padding-left: 8px;
            padding-right: 28px;
            padding-top: 14px;
            padding-bottom: 14px;
            spacing: 10px;
            HorizontalLayout {
                height: 52px;
                Text {
                    text: root.section >= 0 && root.section < root.section-titles.length ? root.section-titles[root.section] : "";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle { horizontal-stretch: 1; }
                if root.is-rows || root.section == 2 : Button {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.sync;
                    text: root.t.reset;
                    clicked => { root.reset(); }
                }
            }

            // ---- pages made of rows
            if root.is-rows : ScrollArea {
                vertical-stretch: 1;
                VerticalLayout {
                    width: min(parent.width - 16px, 960px);
                    alignment: start;
                    spacing: 4px;
                    padding-bottom: 20px;
                    if root.notice != "" : InfoBar {
                        kind: 1;
                        text: root.notice;
                    }
                    for r in root.rows : SettingLine {
                        entry: r;
                        t: root.t;
                        toggled(v) => { root.row-toggled(r.id, v); }
                        chosen(k) => { root.row-chosen(r.id, k); }
                        number(v) => { root.row-number(r.id, v); }
                        text-edited(s) => { root.row-text(r.id, s); }
                        browse => { root.row-browse(r.id); }
                    }
                    if root.section == 11 && root.extra != "" : Text {
                        text: root.extra;
                        color: Theme.text-2;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.section == 11 : HorizontalLayout {
                        padding-top: 8px;
                        spacing: 8px;
                        alignment: start;
                        Button { icon: Icons.sync; text: root.t.check-now; clicked => { root.page-action("check", ""); } }
                        Button { accent: true; icon: Icons.download; text: root.t.update-now; clicked => { root.page-action("update", ""); } }
                    }
                }
            }

            // ---- gallery
            if root.section == 0 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    height: 32px;
                    Chip { text: root.t.all; selected: root.gallery-kind == 0; clicked => { root.gallery-kind = 0; root.gallery-filter(0, app-filter.text); } }
                    Chip { text: root.t.images; selected: root.gallery-kind == 1; clicked => { root.gallery-kind = 1; root.gallery-filter(1, app-filter.text); } }
                    Chip { text: root.t.videos; selected: root.gallery-kind == 2; clicked => { root.gallery-kind = 2; root.gallery-filter(2, app-filter.text); } }
                    app-filter := TextBox {
                        width: 220px;
                        placeholder: root.t.app-filter;
                        accepted(s) => { root.gallery-filter(root.gallery-kind, s); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button { icon: Icons.open; text: root.t.open; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("open"); } }
                    Button { icon: Icons.folder-open; text: root.t.open-folder; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("folder"); } }
                    Button { icon: Icons.copy; text: root.t.copy; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("copy"); } }
                    Button { icon: Icons.delete; text: root.t.delete; danger: true; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("delete"); } }
                }
                if root.gallery.length == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 12px;
                    Icon { data: Icons.images; tint: Theme.text-3; size: 40px; x: (parent.width - self.width) / 2; }
                    Text {
                        text: root.t.empty;
                        color: Theme.text-2;
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
                if root.gallery.length > 0 : grid := ScrollArea {
                    vertical-stretch: 1;
                    property <int> cols: max(1, floor((self.width - 12px) / 232px));
                    property <length> tile-w: (self.width - 12px) / self.cols;
                    property <length> tile-h: tile-w * 0.72 + 64px;
                    Rectangle {
                        width: parent.width;
                        height: ceil(root.gallery.length / grid.cols) * grid.tile-h + 12px;
                        for item[i] in root.gallery : Tile {
                            x: mod(i, grid.cols) * grid.tile-w + 4px;
                            y: floor(i / grid.cols) * grid.tile-h + 4px;
                            width: grid.tile-w - 8px;
                            height: grid.tile-h - 8px;
                            item: item;
                            clicked => { root.gallery-select(i); }
                            opened => { root.gallery-open(i); }
                        }
                    }
                }
                if root.gallery-detail != "" : Text {
                    text: root.gallery-detail;
                    color: Theme.text-2;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            // ---- shortcuts
            if root.section == 2 : ScrollArea {
                vertical-stretch: 1;
                VerticalLayout {
                    width: min(parent.width - 16px, 960px);
                    alignment: start;
                    spacing: 4px;
                    padding-bottom: 20px;
                    for sc[i] in root.shortcuts : VerticalLayout {
                        spacing: 4px;
                        SettingsCard {
                            title: sc.label;
                            description: root.recording-row == i ? root.t.keys-help : "";
                            HorizontalLayout {
                                spacing: 8px;
                                for key in sc.keys : KeyChip {
                                    text: root.recording-row == i && root.recording-slot == key.slot ? root.t.press-keys : key.text;
                                    recording: root.recording-row == i && root.recording-slot == key.slot;
                                    clicked => { root.shortcut-record(i, key.slot); }
                                    cleared => { root.shortcut-clear(i, key.slot); }
                                }
                                if sc.free-slot >= 0 : Button {
                                    icon: Icons.add;
                                    text: root.recording-row == i && root.recording-slot == sc.free-slot ? root.t.press-keys : root.t.add-shortcut;
                                    accent: root.recording-row == i && root.recording-slot == sc.free-slot;
                                    clicked => { root.shortcut-record(i, sc.free-slot); }
                                }
                            }
                        }
                        if sc.error != "" : InfoBar { kind: 2; text: sc.error; }
                    }
                }
            }

            // ---- profiles
            if root.section == 9 : VerticalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                ScrollArea {
                    vertical-stretch: 1;
                    VerticalLayout {
                        width: min(parent.width - 16px, 960px);
                        alignment: start;
                        spacing: 4px;
                        for line[i] in root.lines : LineCard {
                            line: line;
                            pickable: true;
                            clicked => { root.line-select(i); }
                        }
                    }
                }
                if root.extra != "" : InfoBar { kind: 2; text: root.extra; }
                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;
                    name-field := TextBox { width: 220px; placeholder: root.t.name-hint; text: root.rename-text; }
                    Button { icon: Icons.add; text: root.t.new-label; clicked => { root.page-action("new", name-field.text); } }
                    Button { icon: Icons.copy; text: root.t.duplicate; clicked => { root.page-action("duplicate", name-field.text); } }
                    Button { icon: Icons.rename; text: root.t.rename; clicked => { root.page-action("rename", name-field.text); } }
                    Button { accent: true; icon: Icons.checkmark; text: root.t.use-label; clicked => { root.page-action("use", ""); } }
                    Button { icon: Icons.delete; text: root.t.delete; danger: true; clicked => { root.page-action("delete", ""); } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }

            // ---- hardware and about
            if root.is-lines : ScrollArea {
                vertical-stretch: 1;
                VerticalLayout {
                    width: min(parent.width - 16px, 960px);
                    alignment: start;
                    spacing: 4px;
                    padding-bottom: 20px;
                    HorizontalLayout {
                        padding-bottom: 8px;
                        spacing: 8px;
                        alignment: start;
                        if root.section == 10 : Button { accent: true; icon: Icons.sync; text: root.t.redetect; clicked => { root.page-action("redetect", ""); } }
                        if root.section == 12 : Button { icon: Icons.globe; text: root.t.github; clicked => { root.page-action("github", ""); } }
                        if root.section == 12 : Button { icon: Icons.copy; text: root.t.copy-info; clicked => { root.page-action("copy-info", ""); } }
                        if root.section == 12 : Button { icon: Icons.document; text: root.t.logs; clicked => { root.page-action("logs", ""); } }
                    }
                    for line in root.lines : LineCard { line: line; }
                    if root.extra != "" : InfoBar { text: root.extra; }
                }
            }
        }
    }
}
