// The settings window (plan 5.13): a quiet navigation on the left, the page on the right, its
// settings in groups (cards with hairlines between the rows). Rows are generic (a toggle, a
// choice, a number…); the gallery, the shortcuts and the about page have their own layouts.
// Plain Slint elements only (std-widgets would pull the SVG decoder in for its icons).
import { Theme, Icons, Icon, Button, IconButton, Toggle, TextBox, ComboBox, NumberBox, Slider, Segmented, NavItem, Group, GroupRow, SectionLabel, InfoBar, Chip, ScrollArea, ProgressBar } from "controls.slint";

export struct SettingRow {
    id: string,
    label: string,
    hint: string,
    // 0 toggle, 1 choice, 2 number, 3 text, 4 folder, 5 info, 6 header, 7 segmented, 8 slider,
    // 9 profile
    kind: int,
    enabled: bool,
    on: bool,
    text: string,
    num: int,
    min: int,
    max: int,
    step: int,
    options: [string],
    selected: int,
    // A picture before the label (a program's icon).
    icon: image,
    has-icon: bool,
}

// The rows under one title.
export struct SettingGroup {
    title: string,
    rows: [SettingRow],
}

export struct GalleryItem {
    // Its position among all the tiles shown (what the callbacks take).
    index: int,
    name: string,
    detail: string,
    format: string,
    thumb: image,
    has-thumb: bool,
    video: bool,
    selected: bool,
}

// The tiles of one sub-folder (empty: none).
export struct GalleryGroup {
    folder: string,
    count: int,
    items: [GalleryItem],
}

export struct ShortcutKey {
    text: string,
    slot: int,
}

export struct ShortcutRow {
    // The title of the group this row starts (empty: same group as the row above).
    group: string,
    label: string,
    // Always the three slots, an empty text for a free one.
    keys: [ShortcutKey],
    error: string,
}

export struct LineItem {
    text: string,
    detail: string,
    selected: bool,
    strong: bool,
}

export struct UiTexts {
    new-label: string,
    duplicate: string,
    rename: string,
    delete: string,
    use-label: string,
    open: string,
    open-folder: string,
    copy: string,
    all: string,
    images: string,
    videos: string,
    no-folder: string,
    confirm-delete: string,
    confirm-delete-hint: string,
    app-filter: string,
    redetect: string,
    check-now: string,
    update-now: string,
    github: string,
    logs: string,
    copy-info: string,
    empty: string,
    name-hint: string,
    choose: string,
    press-keys: string,
    keys-help: string,
    action-column: string,
    shortcut-column: string,
    details: string,
    restart: string,
    retry: string,
    profile-new: string,
    profile-duplicate: string,
    profile-rename: string,
    profile-delete: string,
    ok: string,
    cancel: string,
}

component SettingLine inherits GroupRow {
    in property <SettingRow> entry;
    in property <UiTexts> t;
    callback toggled(bool);
    callback chosen(int);
    callback number(int);
    callback text-edited(string);
    callback browse();
    callback action(string, string);

    property <bool> renaming: false;
    title: root.entry.label;
    description: root.entry.hint;
    icon: root.entry.icon;
    has-icon: root.entry.has-icon;
    dimmed: !root.entry.enabled && root.entry.kind != 5;
    stack-under: root.entry.kind == 4 || root.entry.kind == 3 || root.entry.kind == 9 ? 620px : 500px;
    clickable: root.entry.kind == 0 && root.entry.enabled;
    clicked => { root.toggled(!root.entry.on); }

    if root.entry.kind == 0 : Toggle {
        on: root.entry.on;
        enabled: root.entry.enabled;
        toggled(v) => { root.toggled(v); }
    }
    if root.entry.kind == 1 : ComboBox {
        width: 240px;
        options: root.entry.options;
        current: root.entry.selected;
        enabled: root.entry.enabled;
        selected(i) => { root.chosen(i); }
    }
    if root.entry.kind == 7 : Segmented {
        options: root.entry.options;
        current: root.entry.selected;
        enabled: root.entry.enabled;
        selected(i) => { root.chosen(i); }
    }
    if root.entry.kind == 2 : NumberBox {
        value: root.entry.num;
        lo: root.entry.min;
        hi: root.entry.max;
        step: root.entry.step;
        enabled: root.entry.enabled;
        changed(v) => { root.number(v); }
    }
    if root.entry.kind == 8 : HorizontalLayout {
        spacing: 12px;
        Slider {
            width: 200px;
            value: root.entry.num;
            lo: root.entry.min;
            hi: root.entry.max;
            step: root.entry.step;
            enabled: root.entry.enabled;
            changed(v) => { root.number(v); }
        }
        Text {
            width: 36px;
            text: root.entry.num;
            color: Theme.text-2;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if root.entry.kind == 3 : TextBox {
        width: 280px;
        text: root.entry.text;
        enabled: root.entry.enabled;
        accepted(s) => { root.text-edited(s); }
    }
    if root.entry.kind == 4 : HorizontalLayout {
        spacing: 8px;
        TextBox {
            width: 280px;
            text: root.entry.text;
            enabled: root.entry.enabled;
            accepted(s) => { root.text-edited(s); }
        }
        IconButton {
            icon: Icons.folder-open;
            label: root.t.choose;
            clicked => { root.browse(); }
        }
    }
    if root.entry.kind == 5 : Text {
        max-width: 300px;
        text: root.entry.text;
        color: Theme.text-2;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    // The profile: the list and its four buttons, or the field of its new name.
    if root.entry.kind == 9 && !root.renaming : HorizontalLayout {
        spacing: 4px;
        ComboBox {
            width: 200px;
            options: root.entry.options;
            current: root.entry.selected;
            selected(i) => { root.chosen(i); }
        }
        Rectangle { width: 4px; }
        IconButton { icon: Icons.add; label: root.t.profile-new; clicked => { root.action("profile-new", ""); } }
        IconButton { icon: Icons.copy; label: root.t.profile-duplicate; clicked => { root.action("profile-duplicate", ""); } }
        IconButton { icon: Icons.rename; label: root.t.profile-rename; clicked => { root.renaming = true; } }
        IconButton { icon: Icons.delete; label: root.t.profile-delete; enabled: root.entry.options.length > 1; clicked => { root.action("profile-delete", ""); } }
    }
    if root.entry.kind == 9 && root.renaming : HorizontalLayout {
        spacing: 8px;
        name := TextBox {
            width: 200px;
            text: root.entry.text;
            accepted(s) => { root.renaming = false; root.action("profile-rename", s); }
            init => { self.take-focus(); }
        }
        Button { text: root.t.ok; accent: true; clicked => { root.renaming = false; root.action("profile-rename", name.text); } }
        Button { text: root.t.cancel; subtle: true; clicked => { root.renaming = false; } }
    }
}

component Tile inherits Rectangle {
    in property <GalleryItem> item;
    callback clicked();
    callback opened();
    // Right click, at this point of the tile.
    callback menu(length, length);
    border-radius: Theme.radius-card;
    border-width: root.item.selected ? 2px : 1px;
    border-color: root.item.selected ? Theme.accent : (touch.has-hover ? Theme.stroke-strong : Theme.stroke);
    background: touch.has-hover ? Theme.control-hover : Theme.card;
    animate border-color, background { duration: Theme.t-fast; }
    drop-shadow-blur: touch.has-hover ? 12px : 0px;
    drop-shadow-color: #00000030;
    drop-shadow-offset-y: 2px;
    animate drop-shadow-blur { duration: Theme.t-normal; }
    clip: true;
    Rectangle {
        y: 0px;
        height: parent.height - 52px;
        background: Theme.bg-deep;
        clip: true;
        if root.item.has-thumb : Image {
            source: root.item.thumb;
            image-fit: cover;
            width: parent.width;
            height: parent.height;
        }
        if !root.item.has-thumb : Icon {
            data: root.item.video ? Icons.video : Icons.image;
            tint: Theme.text-3;
            size: 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        // A video: a play button in the middle of its picture.
        if root.item.video && root.item.has-thumb : Rectangle {
            width: touch.has-hover ? 48px : 42px;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: #000000a0;
            border-width: 1.5px;
            border-color: #ffffffc0;
            animate width { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
            Icon {
                data: Icons.play-filled;
                tint: white;
                size: 18px;
                x: (parent.width - self.width) / 2 + 1px;
                y: (parent.height - self.height) / 2;
            }
        }
        // The kind and the format, top left: a video stands out in the accent colour.
        Rectangle {
            x: 8px;
            y: 8px;
            height: 22px;
            width: badge.preferred-width;
            border-radius: 11px;
            background: root.item.video ? Theme.accent : #000000a8;
            badge := HorizontalLayout {
                padding-left: 7px;
                padding-right: 8px;
                spacing: 4px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    data: root.item.video ? Icons.video : Icons.image;
                    tint: root.item.video ? Theme.on-accent : white;
                    size: 13px;
                }
                Text {
                    text: root.item.format;
                    color: root.item.video ? Theme.on-accent : white;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }
    VerticalLayout {
        y: parent.height - 52px;
        height: 52px;
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.item.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.item.detail;
            color: Theme.text-2;
            font-size: 12px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.opened(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
    }
    accessible-role: button;
    accessible-label: root.item.name;
}

// A line of the menu of a tile.
component MenuEntry inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> danger: false;
    callback clicked();
    height: 34px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? (root.danger ? Theme.danger.with-alpha(0.12) : Theme.subtle-hover) : transparent);
    animate background { duration: Theme.t-fast; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            tint: root.danger ? Theme.danger : Theme.text-2;
            size: 16px;
        }
        Text {
            text: root.text;
            color: root.danger ? Theme.danger : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.text;
}

// One cell of the shortcuts table: a shortcut (a click changes it, the cross removes it), or an
// empty slot (a click records one).
component KeySlot inherits Rectangle {
    in property <string> text;
    in property <bool> recording: false;
    in property <string> press-label;
    callback clicked();
    callback cleared();
    property <bool> empty: root.text == "" && !root.recording;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.recording ? Theme.accent : (root.empty ? (touch.has-hover ? Theme.control-stroke : Theme.divider) : Theme.control-stroke);
    background: root.recording ? Theme.accent-soft
        : root.empty ? (touch.has-hover ? Theme.subtle-hover : transparent)
        : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background, border-color { duration: Theme.t-fast; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.empty && touch.has-hover : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: Icons.add;
        tint: Theme.text-3;
        size: 14px;
    }
    if !root.empty : HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            horizontal-stretch: 1;
            text: root.recording ? root.press-label : root.text;
            color: root.recording ? Theme.accent : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.recording : IconButton {
            icon: Icons.dismiss;
            size: 24px;
            y: (parent.height - self.height) / 2;
            clicked => { root.cleared(); }
        }
    }
    accessible-role: button;
    accessible-label: root.text;
}

// A button of the window's corner (minimize, maximize, close), as Windows draws them.
component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    width: 46px;
    height: 36px;
    background: root.danger && touch.has-hover ? (touch.pressed ? #c42b1ccc : #c42b1c)
        : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        size: 14px;
        tint: root.danger && touch.has-hover ? #ffffff : Theme.text;
        animate tint { duration: Theme.t-fast; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

export component SettingsWindow inherits Window {
    in property <UiTexts> t;
    in property <[string]> section-titles;
    // 0 gallery, 1 general, 2 shortcuts, 3 captures, 4 video, 5 replay, 6 audio, 7 about
    in-out property <int> section: 1;
    in property <[SettingGroup]> groups;
    // A message above the groups (problems with the video settings).
    in property <string> notice;
    in property <[GalleryGroup]> gallery;
    in property <int> gallery-count: 0;
    in property <[ShortcutRow]> shortcuts;
    // The shortcut being recorded (-1: none).
    in property <int> recording-row: -1;
    in property <int> recording-slot: -1;
    in property <[LineItem]> lines;
    in property <string> extra;
    in-out property <int> gallery-kind: 0;
    in property <int> gallery-selected: -1;
    in property <string> gallery-detail;
    // The delete confirmation is open, for this file.
    in-out property <bool> confirm-open: false;
    in-out property <string> confirm-name;
    // Off in the tests, where no time passes: what animates is shown at its end at once.
    in property <bool> animated: true;

    // The about page: the version, and the state of the update.
    in property <string> version;
    in property <string> tagline;
    // 0 up to date (or not checked), 1 checking, 2 available, 3 downloading, 4 ready,
    // 5 failed, 6 restarting
    in property <int> update-state: 0;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress: 0;
    in property <string> update-action;

    callback section-changed(int);
    callback row-toggled(string, bool);
    callback row-chosen(string, int);
    callback row-number(string, int);
    callback row-text(string, string);
    callback row-browse(string);
    callback row-action(string, string, string);
    callback gallery-select(int);
    callback gallery-open(int);
    callback gallery-action(string);
    callback gallery-filter(int, string);
    callback shortcut-record(int, int);
    callback shortcut-clear(int, int);
    callback page-action(string, string);

    // The window has no system frame: its title bar is drawn here.
    in property <bool> zoomed: false;
    callback drag-window();
    callback minimize-window();
    callback toggle-maximized();
    callback close-window();
    // 0 east, 1 north, 2 north-east, 3 north-west, 4 south, 5 south-east, 6 south-west, 7 west
    callback resize-window(int);

    title: "Vixeeny";
    no-frame: true;
    icon: Theme.app-icon;
    background: Theme.bg;
    min-width: 640px;
    min-height: 480px;
    preferred-width: 1040px;
    preferred-height: 760px;
    default-font-family: Theme.font;

    property <bool> compact: root.width < 820px;
    // The width of a column of the shortcuts table.
    property <length> slot-w: root.compact ? 120px : 150px;
    property <bool> is-rows: root.section != 0 && root.section != 2;
    // The page fades and rises in when it changes.
    property <bool> page-shown: true;

    pure function nav-icon(i: int) -> string {
        return i == 0 ? Icons.images
            : i == 1 ? Icons.settings
            : i == 2 ? Icons.keyboard
            : i == 3 ? Icons.image
            : i == 4 ? Icons.video
            : i == 5 ? Icons.history
            : i == 6 ? Icons.speaker
            : Icons.info;
    }
    function go(i: int) {
        if i == root.section { return; }
        root.section = i;
        root.page-shown = false;
        appear.running = true;
        root.section-changed(i);
    }

    appear := Timer {
        interval: 16ms;
        running: false;
        triggered => { self.running = false; root.page-shown = true; }
    }

    // Placed by hand rather than by a layout: the width of the navigation follows the width of
    // the window, which a layout would make depend on the navigation in turn.
    nav := Rectangle {
        x: 0px;
        y: 0px;
        height: root.height;
        width: root.compact ? 64px : 232px;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 16px;
            spacing: 2px;
            // In the title bar, on the line of the window's buttons.
            HorizontalLayout {
                height: 36px;
                padding-left: root.compact ? 10px : 8px;
                spacing: 8px;
                Image {
                    source: Theme.app-icon;
                    width: 20px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                }
                if !root.compact : Text {
                    text: "Vixeeny";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            // The first entry level with the title of the page.
            Rectangle { height: 40px; }
            items := Rectangle {
                height: root.section-titles.length * 38px;
                // The highlight of the current entry slides to the new one.
                Rectangle {
                    x: 0px;
                    y: root.section * 38px;
                    width: parent.width;
                    height: 36px;
                    border-radius: Theme.radius + 2px;
                    background: Theme.selected;
                    animate y { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
                    Rectangle {
                        x: 0px;
                        y: 10px;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
                for title[i] in root.section-titles : NavItem {
                    x: 0px;
                    y: i * 38px;
                    width: parent.width;
                    text: title;
                    icon: root.nav-icon(i);
                    current: i == root.section;
                    compact: root.compact;
                    clicked => { root.go(i); }
                }
            }
            Rectangle { vertical-stretch: 1; }
            // An update waits: a discreet way to it.
            if root.update-state == 4 : Rectangle {
                height: 36px;
                border-radius: 18px;
                background: pill.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: Theme.t-fast; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;
                    Icon { y: (parent.height - self.height) / 2; data: Icons.download; tint: Theme.on-accent; size: 16px; }
                    if !root.compact : Text {
                        text: root.t.restart;
                        color: Theme.on-accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                pill := TouchArea { mouse-cursor: pointer; clicked => { root.go(7); } }
            }
        }
    }

    // ---- the page
    page-host := Rectangle {
        x: nav.width;
        y: 0px;
        width: root.width - nav.width;
        height: root.height;
        page := Rectangle {
            x: 0px;
            y: root.page-shown ? 0px : 10px;
            width: parent.width;
            height: parent.height;
            opacity: root.page-shown ? 1 : 0;
            animate y, opacity { duration: root.page-shown ? Theme.t-slow : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }

            VerticalLayout {
                // Below the window's title bar (its buttons are at the top right).
                padding-top: 36px;
                padding-right: 8px;
                spacing: 8px;
                // ---- title of the page, as wide as the column of the page
                HorizontalLayout {
                    height: 48px;
                    padding-left: 16px;
                    padding-right: max(24px, parent.width - 8px - 16px - 820px);
                    Text {
                        text: root.section >= 0 && root.section < root.section-titles.length ? root.section-titles[root.section] : "";
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // ---- pages made of groups of rows (and the about page)
                if root.is-rows : ScrollArea {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        width: parent.width - 8px;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        VerticalLayout {
                            width: min(parent.width - 32px, 820px);
                            alignment: start;
                            spacing: 8px;
                            padding-bottom: 32px;
                            if root.notice != "" : InfoBar {
                                kind: 1;
                                text: root.notice;
                            }
                            if root.section == 7 : about := VerticalLayout {
                                spacing: 8px;
                                // Who we are.
                                Group {
                                    HorizontalLayout {
                                        padding: 20px;
                                        spacing: 16px;
                                        Image {
                                            source: Theme.app-icon;
                                            width: 56px;
                                            height: 56px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Vixeeny"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                            Text { text: root.version; color: Theme.text-2; font-size: 13px; }
                                            Text { text: root.tagline; color: Theme.text-3; font-size: 12px; wrap: word-wrap; }
                                        }
                                    }
                                }
                                // The update.
                                Group {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 18px;
                                                background: root.update-state == 5 ? Theme.danger-fill
                                                    : (root.update-state == 0 ? Theme.control : Theme.accent-soft);
                                                Icon {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    size: 18px;
                                                    data: root.update-state == 5 ? Icons.error
                                                        : (root.update-state == 0 ? Icons.checkmark : Icons.download);
                                                    tint: root.update-state == 5 ? Theme.danger
                                                        : (root.update-state == 0 ? Theme.success : Theme.accent);
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: root.update-title; color: Theme.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                                                if root.update-detail != "" : Text { text: root.update-detail; color: Theme.text-3; font-size: 12px; wrap: word-wrap; }
                                            }
                                            if root.update-action != "" && root.update-state != 3 && root.update-state != 1 && root.update-state != 6 : Button {
                                                y: (parent.height - self.height) / 2;
                                                accent: root.update-state == 2 || root.update-state == 4;
                                                icon: root.update-state == 4 ? Icons.sync : (root.update-state == 2 ? Icons.download : Icons.sync);
                                                text: root.update-action;
                                                clicked => {
                                                    root.page-action(root.update-state == 2 ? "update-download"
                                                        : root.update-state == 4 ? "update-restart" : "update-check", "");
                                                }
                                            }
                                        }
                                        if root.update-state == 3 || root.update-state == 6 : ProgressBar {
                                            value: root.update-state == 6 ? 1 : root.update-progress;
                                        }
                                    }
                                }
                                Rectangle { height: 12px; }
                            }
                            for g in root.groups : VerticalLayout {
                                spacing: 8px;
                                if g.title != "" : SectionLabel {
                                    text: g.title;
                                }
                                if g.title != "" : Rectangle { height: 0px; }
                                Group {
                                    for r[i] in g.rows : SettingLine {
                                        entry: r;
                                        t: root.t;
                                        first: i == 0;
                                        toggled(v) => { root.row-toggled(r.id, v); }
                                        chosen(k) => { root.row-chosen(r.id, k); }
                                        number(v) => { root.row-number(r.id, v); }
                                        text-edited(s) => { root.row-text(r.id, s); }
                                        browse => { root.row-browse(r.id); }
                                        action(a, arg) => { root.row-action(r.id, a, arg); }
                                    }
                                }
                                Rectangle { height: 12px; }
                            }
                            if root.section == 7 : VerticalLayout {
                                spacing: 8px;
                                SectionLabel { text: root.t.details; }
                                Group {
                                    for line[i] in root.lines : GroupRow {
                                        first: i == 0;
                                        title: line.text;
                                        description: line.detail;
                                    }
                                }
                                HorizontalLayout {
                                    padding-top: 4px;
                                    spacing: 8px;
                                    alignment: start;
                                    Button { icon: Icons.globe; text: root.t.github; clicked => { root.page-action("github", ""); } }
                                    Button { icon: Icons.document; text: root.t.logs; clicked => { root.page-action("logs", ""); } }
                                    Button { icon: Icons.copy; text: root.t.copy-info; clicked => { root.page-action("copy-info", ""); } }
                                }
                                if root.extra != "" : Text {
                                    text: root.extra;
                                    color: Theme.text-2;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // ---- gallery
                if root.section == 0 : gallery-page := VerticalLayout {
                    vertical-stretch: 1;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    // The tile the menu is for, and where it opens.
                    property <GalleryItem> menu-item;
                    property <length> menu-x;
                    property <length> menu-y;
                    HorizontalLayout {
                        spacing: 6px;
                        height: 32px;
                        Chip { text: root.t.all; selected: root.gallery-kind == 0; clicked => { root.gallery-kind = 0; root.gallery-filter(0, app-filter.text); } }
                        Chip { text: root.t.images; selected: root.gallery-kind == 1; clicked => { root.gallery-kind = 1; root.gallery-filter(1, app-filter.text); } }
                        Chip { text: root.t.videos; selected: root.gallery-kind == 2; clicked => { root.gallery-kind = 2; root.gallery-filter(2, app-filter.text); } }
                        Rectangle { horizontal-stretch: 1; }
                        app-filter := TextBox {
                            width: 220px;
                            placeholder: root.t.app-filter;
                            accepted(s) => { root.gallery-filter(root.gallery-kind, s); }
                        }
                    }
                    if root.gallery-count == 0 : VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 12px;
                        Icon { data: Icons.images; tint: Theme.text-3; size: 40px; x: (parent.width - self.width) / 2; }
                        Text {
                            text: root.t.empty;
                            color: Theme.text-2;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if root.gallery-count > 0 : grid := ScrollArea {
                        vertical-stretch: 1;
                        // Room on the right for the scroll bar.
                        property <length> inner: self.width - 14px;
                        property <int> cols: max(1, floor(self.inner / 220px));
                        property <length> tile-w: self.inner / self.cols;
                        property <length> tile-h: self.tile-w * 0.62 + 56px;
                        VerticalLayout {
                            width: grid.inner;
                            padding-bottom: 8px;
                            for group in root.gallery : VerticalLayout {
                                // The folder: its name and how many captures it holds.
                                HorizontalLayout {
                                    height: 40px;
                                    padding-left: 6px;
                                    padding-top: 8px;
                                    spacing: 8px;
                                    alignment: start;
                                    Icon {
                                        y: (parent.height - self.height) / 2 + 4px;
                                        data: Icons.folder-open;
                                        tint: group.folder == "" ? Theme.text-3 : Theme.accent;
                                        size: 18px;
                                    }
                                    Text {
                                        text: group.folder == "" ? root.t.no-folder : group.folder;
                                        color: Theme.text;
                                        font-size: 15px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        y: (parent.height - self.height) / 2 + 4px;
                                        height: 20px;
                                        width: max(20px, count.preferred-width + 12px);
                                        border-radius: 10px;
                                        background: Theme.subtle-hover;
                                        count := Text {
                                            text: group.count;
                                            color: Theme.text-2;
                                            font-size: 11px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle {
                                    height: ceil(group.items.length / grid.cols) * grid.tile-h;
                                    for item[i] in group.items : Tile {
                                        x: mod(i, grid.cols) * grid.tile-w + 5px;
                                        y: floor(i / grid.cols) * grid.tile-h + 5px;
                                        width: grid.tile-w - 10px;
                                        height: grid.tile-h - 10px;
                                        item: item;
                                        clicked => { root.gallery-select(item.index); }
                                        opened => { root.gallery-open(item.index); }
                                        menu(mx, my) => {
                                            root.gallery-select(item.index);
                                            gallery-page.menu-item = item;
                                            gallery-page.menu-x = self.absolute-position.x + mx - gallery-page.absolute-position.x;
                                            gallery-page.menu-y = self.absolute-position.y + my - gallery-page.absolute-position.y;
                                            menu.show();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.gallery-detail != "" : Text {
                        text: root.gallery-detail;
                        color: Theme.text-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }

                    // What can be done with a tile: a right click on it.
                    menu := PopupWindow {
                        // Kept inside the page, next to the pointer.
                        x: min(gallery-page.menu-x, gallery-page.width - self.width - 16px);
                        y: min(gallery-page.menu-y, gallery-page.height - self.height - 8px);
                        width: 220px;
                        height: entries.preferred-height;
                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            property <bool> open: false;
                            y: self.open ? 0px : -4px;
                            opacity: self.open ? 1 : 0;
                            animate y, opacity { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
                            Timer { interval: 16ms; running: !parent.open; triggered => { parent.open = true; } }
                            background: Theme.flyout;
                            border-radius: Theme.radius-flyout;
                            border-width: 1px;
                            border-color: Theme.stroke-strong;
                            drop-shadow-blur: 24px;
                            drop-shadow-color: #00000050;
                            drop-shadow-offset-y: 6px;
                            entries := VerticalLayout {
                                padding: 4px;
                                spacing: 2px;
                                MenuEntry { icon: Icons.open; text: root.t.open; clicked => { root.gallery-action("open"); } }
                                MenuEntry { icon: Icons.folder-open; text: root.t.open-folder; clicked => { root.gallery-action("folder"); } }
                                if !gallery-page.menu-item.video : MenuEntry { icon: Icons.copy; text: root.t.copy; clicked => { root.gallery-action("copy"); } }
                                Rectangle { height: 9px; Rectangle { y: 4px; height: 1px; background: Theme.divider; } }
                                MenuEntry {
                                    icon: Icons.delete;
                                    text: root.t.delete;
                                    danger: true;
                                    clicked => {
                                        root.confirm-name = gallery-page.menu-item.name;
                                        root.confirm-open = true;
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- shortcuts
                if root.section == 2 : ScrollArea {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        width: parent.width - 8px;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        VerticalLayout {
                            width: min(parent.width - 32px, 820px);
                            alignment: start;
                            spacing: 0px;
                            padding-bottom: 32px;
                            // The column titles: the action, then its three shortcuts.
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-bottom: 6px;
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.t.action-column;
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                                for k in 3 : Text {
                                    width: root.slot-w;
                                    text: root.t.shortcut-column + " " + (k + 1);
                                    color: Theme.text-3;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }
                            for sc[i] in root.shortcuts : VerticalLayout {
                                if sc.group != "" : VerticalLayout {
                                    padding-top: i == 0 ? 4px : 20px;
                                    padding-bottom: 8px;
                                    SectionLabel { text: sc.group; }
                                }
                                Rectangle {
                                    // One card per group: the rows of a group touch, their corners
                                    // are rounded only at the ends.
                                    height: line.preferred-height;
                                    background: Theme.card;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    border-top-left-radius: sc.group != "" ? Theme.radius-card : 0px;
                                    border-top-right-radius: sc.group != "" ? Theme.radius-card : 0px;
                                    border-bottom-left-radius: i + 1 >= root.shortcuts.length || root.shortcuts[i + 1].group != "" ? Theme.radius-card : 0px;
                                    border-bottom-right-radius: i + 1 >= root.shortcuts.length || root.shortcuts[i + 1].group != "" ? Theme.radius-card : 0px;
                                    if sc.group == "" : Rectangle {
                                        x: 16px;
                                        y: 0px;
                                        width: parent.width - 32px;
                                        height: 1px;
                                        background: Theme.divider;
                                    }
                                    line := HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        padding-top: 10px;
                                        padding-bottom: 10px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: sc.label;
                                                color: Theme.text;
                                                font-size: 14px;
                                                wrap: word-wrap;
                                            }
                                            if sc.error != "" || root.recording-row == i : Text {
                                                text: sc.error != "" ? sc.error : root.t.keys-help;
                                                color: sc.error != "" ? Theme.danger : Theme.text-3;
                                                font-size: 12px;
                                                wrap: word-wrap;
                                            }
                                        }
                                        for key in sc.keys : KeySlot {
                                            width: root.slot-w;
                                            y: (parent.height - self.height) / 2;
                                            text: key.text;
                                            recording: root.recording-row == i && root.recording-slot == key.slot;
                                            press-label: root.t.press-keys;
                                            clicked => { root.shortcut-record(i, key.slot); }
                                            cleared => { root.shortcut-clear(i, key.slot); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- the title bar: the top of the window moves it; its buttons at the top right
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width - 3 * 46px;
        height: 36px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag-window(); }
        }
        double-clicked => { root.toggle-maximized(); }
    }
    HorizontalLayout {
        x: root.width - self.width;
        y: 0px;
        width: 3 * 46px;
        height: 36px;
        CaptionButton { icon: Icons.minimize; label: "Minimize"; clicked => { root.minimize-window(); } }
        CaptionButton { icon: root.zoomed ? Icons.restore : Icons.maximize; label: "Maximize"; clicked => { root.toggle-maximized(); } }
        CaptionButton { icon: Icons.dismiss; label: "Close"; danger: true; clicked => { root.close-window(); } }
    }

    // ---- the edges resize the window (not when it fills the screen)
    if !root.zoomed : Rectangle {
        property <length> e: 5px;
        TouchArea { x: 0px; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(7); } } }
        TouchArea { x: root.width - e; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(0); } } }
        TouchArea { x: e; y: 0px; width: root.width - 2 * e - 3 * 46px; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(1); } } }
        TouchArea { x: e; y: root.height - e; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(4); } } }
        TouchArea { x: 0px; y: 0px; width: 2 * e; height: 2 * e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(3); } } }
        TouchArea { x: root.width - e; y: 0px; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(2); } } }
        TouchArea { x: 0px; y: root.height - 2 * e; width: 2 * e; height: 2 * e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(6); } } }
        TouchArea { x: root.width - 2 * e; y: root.height - 2 * e; width: 2 * e; height: 2 * e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(5); } } }
    }

    // ---- the delete confirmation, over everything
    Rectangle {
        width: root.width;
        height: root.height;
        visible: self.opacity > 0.01;
        opacity: root.confirm-open ? 1 : 0;
        animate opacity { duration: root.animated ? Theme.t-normal : 0ms; }
        background: #0000006b;
        // A click beside the dialog cancels.
        TouchArea { clicked => { root.confirm-open = false; } }
        keys := FocusScope {
            enabled: root.confirm-open;
            changed enabled => { if self.enabled { self.focus(); } }
            key-pressed(e) => {
                if e.text == Key.Escape { root.confirm-open = false; return accept; }
                if e.text == Key.Return {
                    root.confirm-open = false;
                    root.gallery-action("delete");
                    return accept;
                }
                reject
            }
        }
        dialog := Rectangle {
            width: min(420px, root.width - 48px);
            height: body.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.confirm-open ? 0px : 16px);
            animate y { duration: root.animated ? Theme.t-normal : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }
            background: Theme.flyout;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000060;
            drop-shadow-offset-y: 8px;
            // Clicks on the dialog stay on it.
            TouchArea {}
            body := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: Theme.danger.with-alpha(0.14);
                        Icon { data: Icons.delete; tint: Theme.danger; size: 18px; x: 9px; y: 9px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.t.confirm-delete;
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.confirm-name;
                            color: Theme.text-2;
                            font-size: 13px;
                            overflow: elide;
                        }
                    }
                }
                Text {
                    text: root.t.confirm-delete-hint;
                    color: Theme.text-2;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    padding-top: 12px;
                    spacing: 8px;
                    alignment: end;
                    Button { text: root.t.cancel; clicked => { root.confirm-open = false; } }
                    Button {
                        text: root.t.delete;
                        danger: true;
                        accent: true;
                        clicked => {
                            root.confirm-open = false;
                            root.gallery-action("delete");
                        }
                    }
                }
            }
        }
    }
}
