// The settings window (plan 5.13): a quiet navigation on the left, the page on the right, its
// settings in groups (cards with hairlines between the rows). Rows are generic (a toggle, a
// choice, a number…); the gallery, the shortcuts and the about page have their own layouts.
// Plain Slint elements only (std-widgets would pull the SVG decoder in for its icons).
import { Theme, Icons, Icon, Button, IconButton, Toggle, TextBox, ComboBox, NumberBox, Slider, Segmented, NavItem, Group, GroupRow, SectionLabel, InfoBar, Chip, ScrollArea, ProgressBar } from "controls.slint";

export struct SettingRow {
    id: string,
    label: string,
    hint: string,
    // 0 toggle, 1 choice, 2 number, 3 text, 4 folder, 5 info, 6 header, 7 segmented, 8 slider,
    // 9 profile
    kind: int,
    enabled: bool,
    on: bool,
    text: string,
    num: int,
    min: int,
    max: int,
    step: int,
    options: [string],
    selected: int,
}

// The rows under one title.
export struct SettingGroup {
    title: string,
    rows: [SettingRow],
}

export struct GalleryItem {
    name: string,
    detail: string,
    thumb: image,
    has-thumb: bool,
    video: bool,
    selected: bool,
}

export struct ShortcutKey {
    text: string,
    slot: int,
}

export struct ShortcutRow {
    // The title of the group this row starts (empty: same group as the row above).
    group: string,
    label: string,
    keys: [ShortcutKey],
    // The slot a new shortcut would take (-1: all three are used).
    free-slot: int,
    error: string,
}

export struct LineItem {
    text: string,
    detail: string,
    selected: bool,
    strong: bool,
}

export struct UiTexts {
    reset: string,
    new-label: string,
    duplicate: string,
    rename: string,
    delete: string,
    use-label: string,
    open: string,
    open-folder: string,
    copy: string,
    all: string,
    images: string,
    videos: string,
    app-filter: string,
    redetect: string,
    check-now: string,
    update-now: string,
    github: string,
    logs: string,
    copy-info: string,
    empty: string,
    name-hint: string,
    choose: string,
    press-keys: string,
    keys-help: string,
    add-shortcut: string,
    details: string,
    restart: string,
    retry: string,
    profile-new: string,
    profile-duplicate: string,
    profile-rename: string,
    profile-delete: string,
    ok: string,
    cancel: string,
}

component SettingLine inherits GroupRow {
    in property <SettingRow> entry;
    in property <UiTexts> t;
    callback toggled(bool);
    callback chosen(int);
    callback number(int);
    callback text-edited(string);
    callback browse();
    callback action(string, string);

    property <bool> renaming: false;
    title: root.entry.label;
    description: root.entry.hint;
    dimmed: !root.entry.enabled && root.entry.kind != 5;
    stack-under: root.entry.kind == 4 || root.entry.kind == 3 || root.entry.kind == 9 ? 620px : 500px;
    clickable: root.entry.kind == 0 && root.entry.enabled;
    clicked => { root.toggled(!root.entry.on); }

    if root.entry.kind == 0 : Toggle {
        on: root.entry.on;
        enabled: root.entry.enabled;
        toggled(v) => { root.toggled(v); }
    }
    if root.entry.kind == 1 : ComboBox {
        width: 240px;
        options: root.entry.options;
        current: root.entry.selected;
        enabled: root.entry.enabled;
        selected(i) => { root.chosen(i); }
    }
    if root.entry.kind == 7 : Segmented {
        options: root.entry.options;
        current: root.entry.selected;
        enabled: root.entry.enabled;
        selected(i) => { root.chosen(i); }
    }
    if root.entry.kind == 2 : NumberBox {
        value: root.entry.num;
        lo: root.entry.min;
        hi: root.entry.max;
        step: root.entry.step;
        enabled: root.entry.enabled;
        changed(v) => { root.number(v); }
    }
    if root.entry.kind == 8 : HorizontalLayout {
        spacing: 12px;
        Slider {
            width: 200px;
            value: root.entry.num;
            lo: root.entry.min;
            hi: root.entry.max;
            step: root.entry.step;
            enabled: root.entry.enabled;
            changed(v) => { root.number(v); }
        }
        Text {
            width: 36px;
            text: root.entry.num;
            color: Theme.text-2;
            font-size: 13px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    if root.entry.kind == 3 : TextBox {
        width: 280px;
        text: root.entry.text;
        enabled: root.entry.enabled;
        accepted(s) => { root.text-edited(s); }
    }
    if root.entry.kind == 4 : HorizontalLayout {
        spacing: 8px;
        TextBox {
            width: 280px;
            text: root.entry.text;
            enabled: root.entry.enabled;
            accepted(s) => { root.text-edited(s); }
        }
        IconButton {
            icon: Icons.folder-open;
            label: root.t.choose;
            clicked => { root.browse(); }
        }
    }
    if root.entry.kind == 5 : Text {
        max-width: 300px;
        text: root.entry.text;
        color: Theme.text-2;
        font-size: 13px;
        horizontal-alignment: right;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    // The profile: the list and its four buttons, or the field of its new name.
    if root.entry.kind == 9 && !root.renaming : HorizontalLayout {
        spacing: 4px;
        ComboBox {
            width: 200px;
            options: root.entry.options;
            current: root.entry.selected;
            selected(i) => { root.chosen(i); }
        }
        Rectangle { width: 4px; }
        IconButton { icon: Icons.add; label: root.t.profile-new; clicked => { root.action("profile-new", ""); } }
        IconButton { icon: Icons.copy; label: root.t.profile-duplicate; clicked => { root.action("profile-duplicate", ""); } }
        IconButton { icon: Icons.rename; label: root.t.profile-rename; clicked => { root.renaming = true; } }
        IconButton { icon: Icons.delete; label: root.t.profile-delete; enabled: root.entry.options.length > 1; clicked => { root.action("profile-delete", ""); } }
    }
    if root.entry.kind == 9 && root.renaming : HorizontalLayout {
        spacing: 8px;
        name := TextBox {
            width: 200px;
            text: root.entry.text;
            accepted(s) => { root.renaming = false; root.action("profile-rename", s); }
            init => { self.take-focus(); }
        }
        Button { text: root.t.ok; accent: true; clicked => { root.renaming = false; root.action("profile-rename", name.text); } }
        Button { text: root.t.cancel; subtle: true; clicked => { root.renaming = false; } }
    }
}

component Tile inherits Rectangle {
    in property <GalleryItem> item;
    callback clicked();
    callback opened();
    border-radius: Theme.radius-card;
    border-width: root.item.selected ? 2px : 1px;
    border-color: root.item.selected ? Theme.accent : (touch.has-hover ? Theme.stroke-strong : Theme.stroke);
    background: Theme.card;
    animate border-color { duration: Theme.t-fast; }
    clip: true;
    Rectangle {
        y: 0px;
        height: parent.height - 52px;
        background: Theme.bg-deep;
        clip: true;
        if root.item.has-thumb : Image {
            source: root.item.thumb;
            image-fit: cover;
            width: parent.width;
            height: parent.height;
        }
        if !root.item.has-thumb : Icon {
            data: root.item.video ? Icons.video : Icons.image;
            tint: Theme.text-3;
            size: 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if root.item.video : Rectangle {
            x: parent.width - 36px;
            y: 8px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: #000000a0;
            Icon {
                data: Icons.play-filled;
                tint: white;
                size: 14px;
                x: 8px;
                y: 7px;
            }
        }
    }
    VerticalLayout {
        y: parent.height - 52px;
        height: 52px;
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.item.name;
            color: Theme.text;
            font-size: 13px;
            overflow: elide;
        }
        Text {
            text: root.item.detail;
            color: Theme.text-2;
            font-size: 12px;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.opened(); }
    }
    accessible-role: button;
    accessible-label: root.item.name;
}

component KeyChip inherits Rectangle {
    in property <string> text;
    in property <bool> recording: false;
    callback clicked();
    callback cleared();
    height: 32px;
    preferred-width: row.preferred-width + 8px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.recording ? Theme.accent : Theme.control-stroke;
    background: root.recording ? Theme.accent-soft : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 4px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }
        if !root.recording : IconButton {
            icon: Icons.dismiss;
            size: 24px;
            y: (parent.height - self.height) / 2;
            clicked => { root.cleared(); }
        }
    }
    touch := TouchArea {
        z: -1;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A button of the window's corner (minimize, maximize, close), as Windows draws them.
component CaptionButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();

    width: 46px;
    height: 36px;
    background: root.danger && touch.has-hover ? (touch.pressed ? #c42b1ccc : #c42b1c)
        : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        size: 14px;
        tint: root.danger && touch.has-hover ? #ffffff : Theme.text;
        animate tint { duration: Theme.t-fast; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

export component SettingsWindow inherits Window {
    in property <UiTexts> t;
    in property <[string]> section-titles;
    // 0 gallery, 1 general, 2 shortcuts, 3 captures, 4 video, 5 audio, 6 about
    in-out property <int> section: 1;
    in property <bool> can-reset: true;
    in property <[SettingGroup]> groups;
    // A message above the groups (problems with the video settings).
    in property <string> notice;
    in property <[GalleryItem]> gallery;
    in property <[ShortcutRow]> shortcuts;
    // The shortcut being recorded (-1: none).
    in property <int> recording-row: -1;
    in property <int> recording-slot: -1;
    in property <[LineItem]> lines;
    in property <string> extra;
    in-out property <int> gallery-kind: 0;
    in property <int> gallery-selected: -1;
    in property <string> gallery-detail;

    // The about page: the version, and the state of the update.
    in property <string> version;
    in property <string> tagline;
    // 0 up to date (or not checked), 1 checking, 2 available, 3 downloading, 4 ready,
    // 5 failed, 6 restarting
    in property <int> update-state: 0;
    in property <string> update-title;
    in property <string> update-detail;
    in property <float> update-progress: 0;
    in property <string> update-action;

    callback section-changed(int);
    callback reset();
    callback row-toggled(string, bool);
    callback row-chosen(string, int);
    callback row-number(string, int);
    callback row-text(string, string);
    callback row-browse(string);
    callback row-action(string, string, string);
    callback gallery-select(int);
    callback gallery-open(int);
    callback gallery-action(string);
    callback gallery-filter(int, string);
    callback shortcut-record(int, int);
    callback shortcut-clear(int, int);
    callback page-action(string, string);

    // The window has no system frame: its title bar is drawn here.
    in property <bool> zoomed: false;
    callback drag-window();
    callback minimize-window();
    callback toggle-maximized();
    callback close-window();
    // 0 east, 1 north, 2 north-east, 3 north-west, 4 south, 5 south-east, 6 south-west, 7 west
    callback resize-window(int);

    title: "Vixeeny";
    no-frame: true;
    icon: Theme.app-icon;
    background: Theme.bg;
    min-width: 640px;
    min-height: 480px;
    preferred-width: 1040px;
    preferred-height: 760px;
    default-font-family: Theme.font;

    property <bool> compact: root.width < 820px;
    property <bool> is-rows: root.section != 0 && root.section != 2;
    // The page fades and rises in when it changes.
    property <bool> page-shown: true;

    pure function nav-icon(i: int) -> string {
        return i == 0 ? Icons.images
            : i == 1 ? Icons.settings
            : i == 2 ? Icons.keyboard
            : i == 3 ? Icons.image
            : i == 4 ? Icons.video
            : i == 5 ? Icons.speaker
            : Icons.info;
    }
    function go(i: int) {
        if i == root.section { return; }
        root.section = i;
        root.page-shown = false;
        appear.running = true;
        root.section-changed(i);
    }

    appear := Timer {
        interval: 16ms;
        running: false;
        triggered => { self.running = false; root.page-shown = true; }
    }

    // Placed by hand rather than by a layout: the width of the navigation follows the width of
    // the window, which a layout would make depend on the navigation in turn.
    nav := Rectangle {
        x: 0px;
        y: 0px;
        height: root.height;
        width: root.compact ? 64px : 232px;
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 16px;
            padding-bottom: 16px;
            spacing: 2px;
            HorizontalLayout {
                height: 48px;
                padding-left: root.compact ? 6px : 10px;
                spacing: 10px;
                Image {
                    source: Theme.app-icon;
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                }
                if !root.compact : Text {
                    text: "Vixeeny";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 12px; }
            items := Rectangle {
                height: root.section-titles.length * 38px;
                // The highlight of the current entry slides to the new one.
                Rectangle {
                    x: 0px;
                    y: root.section * 38px;
                    width: parent.width;
                    height: 36px;
                    border-radius: Theme.radius + 2px;
                    background: Theme.selected;
                    animate y { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
                    Rectangle {
                        x: 0px;
                        y: 10px;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                }
                for title[i] in root.section-titles : NavItem {
                    x: 0px;
                    y: i * 38px;
                    width: parent.width;
                    text: title;
                    icon: root.nav-icon(i);
                    current: i == root.section;
                    compact: root.compact;
                    clicked => { root.go(i); }
                }
            }
            Rectangle { vertical-stretch: 1; }
            // An update waits: a discreet way to it.
            if root.update-state == 4 : Rectangle {
                height: 36px;
                border-radius: 18px;
                background: pill.has-hover ? Theme.accent-hover : Theme.accent;
                animate background { duration: Theme.t-fast; }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: center;
                    Icon { y: (parent.height - self.height) / 2; data: Icons.download; tint: Theme.on-accent; size: 16px; }
                    if !root.compact : Text {
                        text: root.t.restart;
                        color: Theme.on-accent;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                pill := TouchArea { mouse-cursor: pointer; clicked => { root.go(6); } }
            }
        }
    }

    // ---- the page
    page-host := Rectangle {
        x: nav.width;
        y: 0px;
        width: root.width - nav.width;
        height: root.height;
        page := Rectangle {
            x: 0px;
            y: root.page-shown ? 0px : 10px;
            width: parent.width;
            height: parent.height;
            opacity: root.page-shown ? 1 : 0;
            animate y, opacity { duration: root.page-shown ? Theme.t-slow : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }

            VerticalLayout {
                // Below the window's title bar (its buttons are at the top right).
                padding-top: 36px;
                padding-right: 8px;
                spacing: 8px;
                // ---- title of the page, as wide as the column of the page
                HorizontalLayout {
                    height: 48px;
                    padding-left: 16px;
                    padding-right: max(24px, parent.width - 8px - 16px - 820px);
                    Text {
                        text: root.section >= 0 && root.section < root.section-titles.length ? root.section-titles[root.section] : "";
                        color: Theme.text;
                        font-size: 26px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.can-reset : Button {
                        y: (parent.height - self.height) / 2;
                        subtle: true;
                        icon: Icons.sync;
                        text: root.t.reset;
                        clicked => { root.reset(); }
                    }
                }

                // ---- pages made of groups of rows (and the about page)
                if root.is-rows : ScrollArea {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        width: parent.width - 8px;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        VerticalLayout {
                            width: min(parent.width - 32px, 820px);
                            alignment: start;
                            spacing: 8px;
                            padding-bottom: 32px;
                            if root.notice != "" : InfoBar {
                                kind: 1;
                                text: root.notice;
                            }
                            if root.section == 6 : about := VerticalLayout {
                                spacing: 8px;
                                // Who we are.
                                Group {
                                    HorizontalLayout {
                                        padding: 20px;
                                        spacing: 16px;
                                        Image {
                                            source: Theme.app-icon;
                                            width: 56px;
                                            height: 56px;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: "Vixeeny"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                            Text { text: root.version; color: Theme.text-2; font-size: 13px; }
                                            Text { text: root.tagline; color: Theme.text-3; font-size: 12px; wrap: word-wrap; }
                                        }
                                    }
                                }
                                // The update.
                                Group {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 12px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: 18px;
                                                background: root.update-state == 5 ? Theme.danger-fill
                                                    : (root.update-state == 0 ? Theme.control : Theme.accent-soft);
                                                Icon {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    size: 18px;
                                                    data: root.update-state == 5 ? Icons.error
                                                        : (root.update-state == 0 ? Icons.checkmark : Icons.download);
                                                    tint: root.update-state == 5 ? Theme.danger
                                                        : (root.update-state == 0 ? Theme.success : Theme.accent);
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                alignment: center;
                                                spacing: 2px;
                                                Text { text: root.update-title; color: Theme.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
                                                if root.update-detail != "" : Text { text: root.update-detail; color: Theme.text-3; font-size: 12px; wrap: word-wrap; }
                                            }
                                            if root.update-action != "" && root.update-state != 3 && root.update-state != 1 && root.update-state != 6 : Button {
                                                y: (parent.height - self.height) / 2;
                                                accent: root.update-state == 2 || root.update-state == 4;
                                                icon: root.update-state == 4 ? Icons.sync : (root.update-state == 2 ? Icons.download : Icons.sync);
                                                text: root.update-action;
                                                clicked => {
                                                    root.page-action(root.update-state == 2 ? "update-download"
                                                        : root.update-state == 4 ? "update-restart" : "update-check", "");
                                                }
                                            }
                                        }
                                        if root.update-state == 3 || root.update-state == 6 : ProgressBar {
                                            value: root.update-state == 6 ? 1 : root.update-progress;
                                        }
                                    }
                                }
                                Rectangle { height: 12px; }
                            }
                            for g in root.groups : VerticalLayout {
                                spacing: 8px;
                                if g.title != "" : SectionLabel {
                                    text: g.title;
                                }
                                if g.title != "" : Rectangle { height: 0px; }
                                Group {
                                    for r[i] in g.rows : SettingLine {
                                        entry: r;
                                        t: root.t;
                                        first: i == 0;
                                        toggled(v) => { root.row-toggled(r.id, v); }
                                        chosen(k) => { root.row-chosen(r.id, k); }
                                        number(v) => { root.row-number(r.id, v); }
                                        text-edited(s) => { root.row-text(r.id, s); }
                                        browse => { root.row-browse(r.id); }
                                        action(a, arg) => { root.row-action(r.id, a, arg); }
                                    }
                                }
                                Rectangle { height: 12px; }
                            }
                            if root.section == 6 : VerticalLayout {
                                spacing: 8px;
                                SectionLabel { text: root.t.details; }
                                Group {
                                    for line[i] in root.lines : GroupRow {
                                        first: i == 0;
                                        title: line.text;
                                        description: line.detail;
                                    }
                                }
                                HorizontalLayout {
                                    padding-top: 4px;
                                    spacing: 8px;
                                    alignment: start;
                                    Button { icon: Icons.globe; text: root.t.github; clicked => { root.page-action("github", ""); } }
                                    Button { icon: Icons.document; text: root.t.logs; clicked => { root.page-action("logs", ""); } }
                                    Button { icon: Icons.copy; text: root.t.copy-info; clicked => { root.page-action("copy-info", ""); } }
                                }
                                if root.extra != "" : Text {
                                    text: root.extra;
                                    color: Theme.text-2;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // ---- gallery
                if root.section == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-bottom: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 6px;
                        height: 32px;
                        Chip { text: root.t.all; selected: root.gallery-kind == 0; clicked => { root.gallery-kind = 0; root.gallery-filter(0, app-filter.text); } }
                        Chip { text: root.t.images; selected: root.gallery-kind == 1; clicked => { root.gallery-kind = 1; root.gallery-filter(1, app-filter.text); } }
                        Chip { text: root.t.videos; selected: root.gallery-kind == 2; clicked => { root.gallery-kind = 2; root.gallery-filter(2, app-filter.text); } }
                        Rectangle { width: 6px; }
                        app-filter := TextBox {
                            width: 200px;
                            placeholder: root.t.app-filter;
                            accepted(s) => { root.gallery-filter(root.gallery-kind, s); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        IconButton { icon: Icons.open; label: root.t.open; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("open"); } }
                        IconButton { icon: Icons.folder-open; label: root.t.open-folder; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("folder"); } }
                        IconButton { icon: Icons.copy; label: root.t.copy; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("copy"); } }
                        IconButton { icon: Icons.delete; label: root.t.delete; tint: Theme.danger; enabled: root.gallery-selected >= 0; clicked => { root.gallery-action("delete"); } }
                    }
                    if root.gallery.length == 0 : VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 12px;
                        Icon { data: Icons.images; tint: Theme.text-3; size: 40px; x: (parent.width - self.width) / 2; }
                        Text {
                            text: root.t.empty;
                            color: Theme.text-2;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if root.gallery.length > 0 : grid := ScrollArea {
                        vertical-stretch: 1;
                        property <int> cols: max(1, floor((self.width - 12px) / 220px));
                        property <length> tile-w: (self.width - 12px) / self.cols;
                        property <length> tile-h: tile-w * 0.66 + 56px;
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: ceil(root.gallery.length / grid.cols) * grid.tile-h + 12px;
                            for item[i] in root.gallery : Tile {
                                x: mod(i, grid.cols) * grid.tile-w + 5px;
                                y: floor(i / grid.cols) * grid.tile-h + 5px;
                                width: grid.tile-w - 10px;
                                height: grid.tile-h - 10px;
                                item: item;
                                clicked => { root.gallery-select(i); }
                                opened => { root.gallery-open(i); }
                            }
                        }
                    }
                    if root.gallery-detail != "" : Text {
                        text: root.gallery-detail;
                        color: Theme.text-2;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }

                // ---- shortcuts
                if root.section == 2 : ScrollArea {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        width: parent.width - 8px;
                        alignment: start;
                        padding-left: 16px;
                        padding-right: 16px;
                        VerticalLayout {
                            width: min(parent.width - 32px, 820px);
                            alignment: start;
                            spacing: 0px;
                            padding-bottom: 32px;
                            for sc[i] in root.shortcuts : VerticalLayout {
                                if sc.group != "" : VerticalLayout {
                                    padding-top: i == 0 ? 0px : 20px;
                                    padding-bottom: 8px;
                                    SectionLabel { text: sc.group; }
                                }
                                Rectangle {
                                    // One card per group: the rows of a group touch, their corners
                                    // are rounded only at the ends.
                                    height: line.height;
                                    background: Theme.card;
                                    border-width: 1px;
                                    border-color: Theme.stroke;
                                    border-top-left-radius: sc.group != "" ? Theme.radius-card : 0px;
                                    border-top-right-radius: sc.group != "" ? Theme.radius-card : 0px;
                                    border-bottom-left-radius: i + 1 >= root.shortcuts.length || root.shortcuts[i + 1].group != "" ? Theme.radius-card : 0px;
                                    border-bottom-right-radius: i + 1 >= root.shortcuts.length || root.shortcuts[i + 1].group != "" ? Theme.radius-card : 0px;
                                    line := GroupRow {
                                        first: sc.group != "";
                                        title: sc.label;
                                        description: sc.error != "" ? sc.error : (root.recording-row == i ? root.t.keys-help : "");
                                        HorizontalLayout {
                                            spacing: 6px;
                                            for key in sc.keys : KeyChip {
                                                text: root.recording-row == i && root.recording-slot == key.slot ? root.t.press-keys : key.text;
                                                recording: root.recording-row == i && root.recording-slot == key.slot;
                                                clicked => { root.shortcut-record(i, key.slot); }
                                                cleared => { root.shortcut-clear(i, key.slot); }
                                            }
                                            if sc.free-slot >= 0 : Button {
                                                subtle: !(root.recording-row == i && root.recording-slot == sc.free-slot);
                                                icon: Icons.add;
                                                text: root.recording-row == i && root.recording-slot == sc.free-slot ? root.t.press-keys : root.t.add-shortcut;
                                                accent: root.recording-row == i && root.recording-slot == sc.free-slot;
                                                clicked => { root.shortcut-record(i, sc.free-slot); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---- the title bar: the top of the window moves it; its buttons at the top right
    TouchArea {
        x: 0px;
        y: 0px;
        width: root.width - 3 * 46px;
        height: 36px;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag-window(); }
        }
        double-clicked => { root.toggle-maximized(); }
    }
    HorizontalLayout {
        x: root.width - self.width;
        y: 0px;
        width: 3 * 46px;
        height: 36px;
        CaptionButton { icon: Icons.minimize; label: "Minimize"; clicked => { root.minimize-window(); } }
        CaptionButton { icon: root.zoomed ? Icons.restore : Icons.maximize; label: "Maximize"; clicked => { root.toggle-maximized(); } }
        CaptionButton { icon: Icons.dismiss; label: "Close"; danger: true; clicked => { root.close-window(); } }
    }

    // ---- the edges resize the window (not when it fills the screen)
    if !root.zoomed : Rectangle {
        property <length> e: 5px;
        TouchArea { x: 0px; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(7); } } }
        TouchArea { x: root.width - e; y: e; width: e; height: root.height - 2 * e; mouse-cursor: ew-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(0); } } }
        TouchArea { x: e; y: 0px; width: root.width - 2 * e - 3 * 46px; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(1); } } }
        TouchArea { x: e; y: root.height - e; width: root.width - 2 * e; height: e; mouse-cursor: ns-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(4); } } }
        TouchArea { x: 0px; y: 0px; width: 2 * e; height: 2 * e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(3); } } }
        TouchArea { x: root.width - e; y: 0px; width: e; height: e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(2); } } }
        TouchArea { x: 0px; y: root.height - 2 * e; width: 2 * e; height: 2 * e; mouse-cursor: nesw-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(6); } } }
        TouchArea { x: root.width - 2 * e; y: root.height - 2 * e; width: 2 * e; height: 2 * e; mouse-cursor: nwse-resize; pointer-event(ev) => { if ev.kind == PointerEventKind.down { root.resize-window(5); } } }
    }
}
