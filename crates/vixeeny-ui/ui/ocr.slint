import { Theme, Icons, Button, InfoBar } from "controls.slint";
export { Button as PushButton } from "controls.slint";

// The result of a text recognition: editable text, a status line and, when a language is
// missing, how to install it (plan 5.6).
export component OcrWindow inherits Window {
    in-out property <string> text;
    in property <string> status;
    in property <string> hint;
    in property <string> copy-label: "Copy";
    in property <string> settings-label: "Open language settings";
    in property <bool> show-settings: false;

    callback copy(string);
    callback open-settings();

    title: "Vixeeny";
    icon: Theme.app-icon;
    min-width: 420px;
    min-height: 260px;
    preferred-width: 580px;
    preferred-height: 400px;
    default-font-family: Theme.font;
    background: Theme.bg;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        Rectangle {
            vertical-stretch: 1;
            background: Theme.card;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.stroke;
            clip: true;
            Flickable {
                content-height: max(self.height, input.preferred-height + 24px);
                input := TextInput {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    text <=> root.text;
                    wrap: word-wrap;
                    single-line: false;
                    color: Theme.text;
                    selection-background-color: Theme.accent-soft;
                    selection-foreground-color: Theme.text;
                    font-size: 14px;
                }
            }
        }

        if root.hint != "" : InfoBar {
            kind: 1;
            text: root.hint;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.status;
                color: Theme.text-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
                wrap: word-wrap;
                font-size: 12px;
            }
            if root.show-settings : Button {
                text: root.settings-label;
                clicked => { root.open-settings(); }
            }
            Button {
                text: root.copy-label;
                icon: Icons.copy;
                accent: true;
                clicked => { root.copy(root.text); }
            }
        }
    }
}
