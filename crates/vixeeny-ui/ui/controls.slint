// The controls of every Vixeeny window, drawn after the Windows 11 (Fluent) ones: plain Slint elements only
// (std-widgets would pull the SVG decoder in), colours and motion from `Theme`.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
export { Theme } from "theme.slint";
export { Icons } from "icons.slint";

// The tooltip under the pointer. The window draws it above everything (`TipLayer`): a popup would take the pointer from
// what it belongs to, and close again at once.
export global Tip {
    // Empty while none shows.
    in-out property <string> text;
    // What it belongs to, in window coordinates: it goes under it (above near the bottom).
    in-out property <length> left;
    in-out property <length> top;
    in-out property <length> bottom;
}

// A 20-unit Fluent glyph (see `Icons`) drawn as a path, sharp at any scale.
export component Icon inherits Rectangle {
    in property <string> data;
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.data;
        fill: root.tint;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> accent: false;
    in property <bool> subtle: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // Shown under it while the pointer rests on it; also its name when it has no text.
    in property <string> tip;
    callback clicked();

    min-width: 32px;
    height: 32px;
    preferred-width: row.preferred-width;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    border-width: root.accent || root.subtle ? 0px : 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    animate opacity { duration: Theme.t-normal; }
    background: root.accent && root.danger
        ? (touch.pressed ? #a52314 : (touch.has-hover ? #b42818 : #c42b1c))
        : root.accent
        ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent))
        : root.subtle
            ? (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent))
            : (touch.pressed ? Theme.control-pressed : (touch.has-hover ? Theme.control-hover : Theme.control));
    animate background { duration: Theme.t-fast; }

    row := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 14px;
        padding-right: root.text == "" ? 8px : 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "" : Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            tint: root.accent && root.danger ? white : root.accent ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
        }
        if root.text != "" : Text {
            text: root.text;
            color: root.accent && root.danger ? white : root.accent ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                Tip.text = root.tip;
                Tip.left = root.absolute-position.x;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
            } else if root.tip != "" && Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }
    accessible-role: button;
    accessible-label: root.text != "" ? root.text : root.tip;
    accessible-enabled: root.enabled;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    // Shown under it while the pointer rests on it.
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> tint: Theme.text;
    in property <length> size: 32px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1.0 : 0.4;
    animate opacity { duration: Theme.t-normal; }
    background: root.active ? Theme.accent-soft
        : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Icon {
        data: root.icon;
        tint: root.active ? Theme.accent : root.tint;
        animate tint { duration: Theme.t-fast; }
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.tip != "" {
                Tip.text = root.tip;
                Tip.left = root.absolute-position.x;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
            } else if root.tip != "" && Tip.text == root.tip {
                Tip.text = "";
            }
        }
    }
    accessible-role: button;
    accessible-label: root.label;
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 40px;
    height: 22px;
    border-radius: 11px;
    opacity: root.enabled ? 1.0 : 0.4;
    animate opacity { duration: Theme.t-normal; }
    background: root.on ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent))
        : (touch.has-hover ? Theme.stroke-strong : Theme.control-stroke.with-alpha(Theme.dark ? 0.16 : 0.12));
    animate background { duration: Theme.t-normal; }

    Rectangle {
        property <length> d: 16px;
        property <length> stretch: touch.pressed ? 4px : 0px;
        width: self.d + self.stretch;
        height: self.d;
        border-radius: self.d / 2;
        y: (parent.height - self.d) / 2;
        x: root.on ? parent.width - self.width - 3px : 3px;
        background: root.on ? Theme.on-accent : (Theme.dark ? #e4e4e7 : #ffffff);
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 1px;
        animate x, width { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    accessible-role: switch;
    accessible-checked: root.on;
}

export component Check inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> text;
    callback toggled(bool);

    height: 32px;
    preferred-width: row.preferred-width;
    opacity: root.enabled ? 1.0 : 0.45;
    animate opacity { duration: Theme.t-normal; }
    row := HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: root.on ? 0px : 1px;
            border-color: Theme.stroke-strong;
            background: root.on ? Theme.accent : (touch.has-hover ? Theme.subtle-hover : transparent);
            animate background { duration: Theme.t-fast; }
            // The mark grows in from the centre.
            Icon {
                data: Icons.checkmark;
                tint: Theme.on-accent;
                size: root.on ? 14px : 6px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                opacity: root.on ? 1 : 0;
                animate size, opacity { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
            }
        }
        if root.text != "" : Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.text;
}

// The text fields: a press outside the one with the focus takes the focus away from it.
export global Fields {
    // The pointer is over the field with the focus.
    in-out property <bool> kept;
    // Goes up for each press elsewhere: the fields let go of the focus.
    in-out property <int> blur;
    public function pressed() { if (!self.kept) { self.blur += 1; } }
}

export component TextBox inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <string> suffix;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    callback edited(string);
    callback accepted(string);
    public function take-focus() { input.focus(); }
    // Shows `s`, typed over or not.
    public function show(s: string) { input.text = s; }

    min-width: 120px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    background: input.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }

    // The focus underline, drawn from the middle outwards.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: input.has-focus ? parent.width - 2px : 0px;
        x: (parent.width - self.width) / 2;
        border-radius: 1px;
        background: Theme.accent;
        // The position follows the width: animating both would shift it off centre.
        animate width { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    Text {
        x: 10px;
        width: parent.width - 20px - (root.suffix != "" ? suffix.width + 8px : 0px);
        text: root.placeholder;
        visible: input.text == "" && !input.has-focus;
        color: Theme.text-3;
        font-size: 14px;
        vertical-alignment: center;
    }
    // A press anywhere else in the window takes the focus away (`Fields`).
    property <bool> kept: input.has-focus && touch.has-hover;
    changed kept => { Fields.kept = self.kept; }
    property <int> blur: Fields.blur;
    changed blur => { input.clear-focus(); }
    // The text inside: its hover covers the text too.
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        viewport := Rectangle {
            x: 10px;
            width: parent.width - 20px - (root.suffix != "" ? suffix.width + 8px : 0px);
            height: parent.height;
            clip: true;
        input := TextInput {
            property <length> offset;
            x: min(0px, max(parent.width - self.width - 2px, self.offset));
            width: max(parent.width - 2px, self.preferred-width);
            cursor-position-changed(pos) => {
                if pos.x + self.offset < 2px { self.offset = 2px - pos.x; }
                else if pos.x + self.offset > parent.width - 2px { self.offset = parent.width - 2px - pos.x; }
            }
            height: parent.height;
            text: root.text;
            enabled: root.enabled;
            read-only: root.read-only;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
            changed has-focus => { if (!self.has-focus) { root.accepted(self.text); } }
        }
    }
    }
    suffix := Text {
        x: parent.width - self.width - 10px;
        height: parent.height;
        width: min(self.preferred-width, parent.width / 2);
        text: root.suffix;
        color: Theme.text-3;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    accessible-role: text-input;
    accessible-label: root.placeholder;
}

export component ComboBox inherits Rectangle {
    in property <[string]> options;
    // Options that only title the ones under them (not chosen); one without a label is a line between two groups.
    in property <[bool]> headings;
    // How many of them are lines (shorter rows).
    in property <int> separators;
    // The options advised: `mark-text` beside them in the list.
    in property <[bool]> marks;
    in property <string> mark-text;
    // The options that usually do harm: in the warning colour.
    in property <[bool]> cautions;
    in property <int> current: -1;
    in property <bool> enabled: true;
    in property <string> placeholder;
    callback selected(int);
    // The width that shows the choice whole (with the arrow): the box follows it.
    out property <length> fit: max(72px, shown.preferred-width + 42px);

    min-width: 72px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    animate opacity { duration: Theme.t-normal; }
    background: touch.pressed ? Theme.control-pressed : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.placeholder;
            color: root.current < 0 ? Theme.text-3
                : (root.current < root.cautions.length && root.cautions[root.current] ? Theme.warning : Theme.text);
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-down;
            tint: Theme.text-2;
            size: 12px;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    // The widest choice, measured (never shown): the list fits it whole.
    Rectangle {
        width: 0px;
        height: 0px;
        visible: false;
        measure := VerticalLayout {
            for option in root.options : Text { text: option; font-size: 14px; }
        }
        mark := Text { text: root.mark-text; font-size: 12px; }
        shown := Text {
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.placeholder;
            font-size: 14px;
        }
    }
    property <length> mark-w: root.marks.length > 0 ? mark.preferred-width + 16px : 0px;
    // A row is 38 px high with 2 px under it; a line between groups, 9 px.
    property <length> list-h: (root.options.length - root.separators) * 40px + root.separators * 11px + 8px;
    menu := PopupWindow {
        // At least as wide as the box, wider when a choice needs it: then it grows to the left, its right edge on the
        // box's (the boxes sit at the right of the page).
        x: root.width - self.width;
        y: root.height + 2px;
        width: max(root.width, measure.preferred-width + 40px + root.mark-w);
        height: min(root.list-h, 420px);
        Rectangle {
            // Unfolds from the box when it opens.
            property <bool> open: false;
            y: 0px;
            height: self.open ? parent.height : 0px;
            opacity: self.open ? 1 : 0;
            clip: true;
            animate height, opacity { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
            Timer { interval: 16ms; running: !parent.open; triggered => { parent.open = true; } }
            background: Theme.flyout;
            border-radius: Theme.radius-flyout;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            drop-shadow-offset-y: 6px;
            Flickable {
                content-height: root.list-h;
                VerticalLayout {
                    padding: 4px;
                    spacing: 2px;
                    alignment: start;
                    for option[i] in root.options : item-row := Rectangle {
                        property <bool> head: i < root.headings.length && root.headings[i];
                        property <bool> rule: self.head && option == "";
                        property <bool> marked: i < root.marks.length && root.marks[i];
                        property <bool> caution: i < root.cautions.length && root.cautions[i];
                        height: self.rule ? 9px : 38px;
                        border-radius: Theme.radius;
                        background: self.head ? transparent
                            : (item.pressed ? Theme.subtle-pressed : (item.has-hover || i == root.current ? Theme.subtle-hover : transparent));
                        animate background { duration: Theme.t-fast; }
                        if i == root.current && !self.head : Rectangle {
                            x: 0px;
                            y: (parent.height - 16px) / 2;
                            width: 3px;
                            height: 16px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                        if item-row.rule : Rectangle {
                            x: 8px;
                            y: (parent.height - 1px) / 2;
                            width: parent.width - 16px;
                            height: 1px;
                            background: Theme.stroke-strong;
                        }
                        if !item-row.rule : Text {
                            x: parent.head ? 8px : 12px;
                            y: 0px;
                            width: parent.width - 20px - (parent.marked ? root.mark-w : 0px);
                            height: parent.height;
                            overflow: elide;
                            text: option;
                            color: parent.head ? Theme.text-3 : (parent.caution ? Theme.warning : Theme.text);
                            font-size: parent.head ? 12px : 14px;
                            font-weight: parent.head ? 600 : 400;
                            vertical-alignment: parent.head ? bottom : center;
                        }
                        if item-row.marked : Text {
                            x: parent.width - 12px - self.width;
                            width: self.preferred-width;
                            height: parent.height;
                            text: root.mark-text;
                            color: Theme.text-3;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        item := TouchArea {
                            enabled: !parent.head;
                            mouse-cursor: pointer;
                            clicked => { root.selected(i); menu.close(); }
                        }
                    }
                }
            }
        }
    }
    accessible-role: combobox;
}

// "−  42  +"
// A whole number typed in, from `lo` to `hi`, its unit after it. Digits only; out of range it is outlined in red, and
// held to the range once left.
export component NumberBox inherits Rectangle {
    in property <int> value;
    in property <int> lo: 0;
    in property <int> hi: 100;
    in property <bool> enabled: true;
    in property <string> unit;
    // What a notch of the wheel adds or takes away.
    in property <int> step: 1;
    callback changed(int);

    property <bool> wrong: input.text != "" && (input.text.to-float() < root.lo || input.text.to-float() > root.hi);
    // The value typed: held to the range, or the value as it was when nothing is typed.
    function commit() {
        if input.text == "" {
            input.text = root.value;
            return;
        }
        let n = max(root.lo, min(root.hi, round(input.text.to-float())));
        input.text = n;
        if n != root.value { root.changed(n); }
    }
    changed value => { input.text = root.value; }

    width: 136px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.wrong ? Theme.danger : Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    background: input.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background, border-color { duration: Theme.t-fast; }

    // The focus underline, drawn from the middle outwards.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        width: input.has-focus ? parent.width - 2px : 0px;
        x: (parent.width - self.width) / 2;
        border-radius: 1px;
        background: root.wrong ? Theme.danger : Theme.accent;
        animate width { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
    }
    // A press anywhere else in the window takes the focus away (`Fields`).
    property <bool> kept: input.has-focus && touch.has-hover;
    changed kept => { Fields.kept = self.kept; }
    property <int> blur: Fields.blur;
    changed blur => { input.clear-focus(); }
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        // Once clicked in, the wheel over it goes up or down a step (from what is typed, if anything); otherwise it
        // scrolls the page.
        scroll-event(e) => {
            if !root.enabled || !input.has-focus || e.delta-y == 0 {
                return reject;
            }
            let from = input.text == "" ? root.value : round(input.text.to-float());
            let s = max(1, root.step);
            let n = max(root.lo, min(root.hi, e.delta-y > 0 ? floor(from / s) * s + s : ceil(from / s) * s - s));
            input.text = n;
            if n != root.value { root.changed(n); }
            accept
        }
        input := TextInput {
            x: 10px;
            width: parent.width - 20px - (root.unit != "" ? unit.preferred-width + 8px : 0px);
            height: parent.height;
            text: root.value;
            enabled: root.enabled;
            input-type: number;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            accepted => { root.commit(); }
            changed has-focus => { if (!self.has-focus) { root.commit(); } }
        }
        unit := Text {
            x: parent.width - 10px - self.width;
            width: self.preferred-width;
            visible: root.unit != "";
            text: root.unit;
            color: Theme.text-3;
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    accessible-role: text-input;
}

export component Slider inherits Rectangle {
    in property <int> value;
    in property <int> lo: 0;
    in property <int> hi: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;
    // The value advised, marked on the track (100 % of a volume), which the thumb is lightly pulled to; -1: none.
    in property <int> mark: -1;
    callback changed(int);
    // Held (`true`) and let go: the values given meanwhile are only a preview of the last.
    callback sliding(bool);

    min-width: 160px;
    height: 32px;
    opacity: root.enabled ? 1.0 : 0.45;
    property <float> ratio: root.hi > root.lo ? (clamp(root.value, root.lo, root.hi) - root.lo) / (root.hi - root.lo) : 0;
    function pick(x: length) {
        if (!root.enabled) { return; }
        // A 20 px thumb: the travel is the width minus one thumb.
        let r = clamp((x - 10px) / max(1px, root.width - 20px), 0, 1);
        let raw = root.lo + r * (root.hi - root.lo);
        let snapped = root.lo + round((raw - root.lo) / max(1, root.step)) * max(1, root.step);
        // Within 1.5 % of the track from the mark, the mark: a light pull.
        let held = root.mark >= root.lo && abs(raw - root.mark) <= (root.hi - root.lo) * 0.015 ? root.mark : snapped;
        root.changed(clamp(round(held), root.lo, root.hi));
    }
    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        height: 4px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: Theme.stroke-strong;
        Rectangle {
            x: 0px;
            width: parent.width * root.ratio;
            border-radius: 2px;
            background: Theme.accent;
            // Follows the pointer at once while dragged, glides otherwise.
            animate width { duration: touch.pressed ? 0ms : Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
        }
    }
    if root.mark >= root.lo && root.mark <= root.hi && root.hi > root.lo : Rectangle {
        width: 2px;
        height: 12px;
        border-radius: 1px;
        x: 10px + (root.mark - root.lo) / (root.hi - root.lo) * (parent.width - 20px) - 1px;
        y: (parent.height - self.height) / 2;
        background: Theme.text-3;
    }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        x: root.ratio * (parent.width - 20px);
        animate x { duration: touch.pressed ? 0ms : Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
        y: (parent.height - 20px) / 2;
        background: Theme.dark ? #454545 : #ffffff;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        Rectangle {
            property <length> d: touch.pressed ? 10px : (touch.has-hover ? 14px : 12px);
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            x: (parent.width - self.d) / 2;
            y: (parent.height - self.d) / 2;
            background: Theme.accent;
            animate width, height, x, y { duration: Theme.t-fast; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.sliding(true);
                root.pick(self.mouse-x);
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.sliding(false);
            }
        }
        moved => { if (self.pressed) { root.pick(self.mouse-x); } }
    }
    accessible-role: slider;
    accessible-value: root.value;
}

// A colour to open the picker with: a rounded square of it, outlined.
component Swatch inherits Rectangle {
    in property <color> colour;
    in property <bool> enabled: true;
    in property <bool> current;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: Theme.radius;
    background: root.colour;
    border-width: root.current ? 2px : 1px;
    border-color: root.current ? Theme.accent : (touch.has-hover ? Theme.text-2 : Theme.control-stroke);
    animate border-color { duration: Theme.t-fast; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One colour, or the two ends of a gradient with the gradient between them; each opens a picker: a square of saturation
// (across) and brightness (down), a bar of hues, the code in hexadecimal and a few colours ready to take.
export component ColourField inherits Rectangle {
    // One colour, or two: the ends of a gradient.
    in property <[color]> colours;
    // The same, in hexadecimal.
    in property <[string]> codes;
    // Colours ready to take.
    in property <[color]> swatches;
    // Gradients ready to take: their ends one after the other, and their values.
    in property <[color]> pairs;
    in property <[string]> pair-values;
    in property <bool> enabled: true;
    callback picked(int, color);
    callback typed(int, string);
    callback chosen(string);
    // Dragged in the square or the bar (`true`) and let go.
    callback sliding(bool);

    // The end being picked, and its hue, saturation and brightness: kept here, so that the hue stays while the colour
    // is grey.
    property <int> editing;
    property <float> hue;
    property <float> sat;
    property <float> val;
    property <bool> gradient: root.colours.length > 1;
    // The code of the end being picked: the field shows it as it changes.
    property <string> code: root.editing < root.codes.length ? root.codes[root.editing] : "";
    function open(i: int) {
        root.editing = i;
        let c = root.colours[i].to-hsv();
        root.hue = c.hue;
        root.sat = c.saturation;
        root.val = c.value;
        picker.show();
    }
    function send() { root.picked(root.editing, Colors.hsv(root.hue, root.sat, root.val)); }
    function take(c: color) {
        let h = c.to-hsv();
        root.hue = h.hue;
        root.sat = h.saturation;
        root.val = h.value;
        root.picked(root.editing, c);
    }

    width: Theme.value-w;
    height: 32px;
    opacity: root.enabled ? 1.0 : 0.45;

    if !root.gradient && root.colours.length > 0 : Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.control-stroke;
        background: one.pressed ? Theme.control-pressed : (one.has-hover ? Theme.control-hover : Theme.control);
        animate background { duration: Theme.t-fast; }
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 10px;
            spacing: 10px;
            Rectangle {
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius - 1px;
                border-width: 1px;
                border-color: Theme.control-stroke;
                background: root.colours[0];
            }
            Text {
                horizontal-stretch: 1;
                text: root.codes.length > 0 ? root.codes[0] : "";
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
            }
            Icon {
                y: (parent.height - self.height) / 2;
                data: Icons.chevron-down;
                tint: Theme.text-2;
                size: 12px;
            }
        }
        one := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.open(0); }
        }
    }
    if root.gradient : HorizontalLayout {
        spacing: 8px;
        alignment: stretch;
        Swatch {
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            colour: root.colours[0];
            enabled: root.enabled;
            clicked => { root.open(0); }
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 12px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: @linear-gradient(90deg, root.colours[0] 0%, root.colours[1] 100%);
        }
        Swatch {
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            colour: root.colours[1];
            enabled: root.enabled;
            clicked => { root.open(1); }
        }
    }

    picker := PopupWindow {
        // Under the field, its right edge on the field's (the values sit at the right).
        property <length> pad: 12px;
        property <length> inner: 232px;
        property <int> pair-count: root.pairs.length / 2;
        x: root.width - self.width;
        y: root.height + 2px;
        width: self.inner + 2 * self.pad;
        height: 160px + 14px + 32px + 3 * 12px + 22px + 2 * self.pad
            + (self.pair-count > 0 ? 12px + 24px : 0px);
        close-policy: close-on-click-outside;
        Rectangle {
            property <string> code: root.code;
            changed code => { field.show(self.code); }
            background: Theme.flyout;
            border-radius: Theme.radius-flyout;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            drop-shadow-offset-y: 6px;
            VerticalLayout {
                padding: picker.pad;
                spacing: 12px;
                // Saturation across, brightness down.
                square := Rectangle {
                    height: 160px;
                    border-radius: Theme.radius;
                    clip: true;
                    background: Colors.hsv(root.hue, 1, 1);
                    Rectangle { background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%); }
                    Rectangle { background: @linear-gradient(0deg, #000000 0%, #00000000 100%); }
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        x: root.sat * parent.width - self.width / 2;
                        y: (1 - root.val) * parent.height - self.height / 2;
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: #ffffff;
                        drop-shadow-blur: 3px;
                        drop-shadow-color: #00000080;
                    }
                    TouchArea {
                        mouse-cursor: crosshair;
                        function at(x: length, y: length) {
                            root.sat = clamp(x / max(1px, parent.width), 0, 1);
                            root.val = 1 - clamp(y / max(1px, parent.height), 0, 1);
                            root.send();
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.sliding(true);
                                self.at(self.mouse-x, self.mouse-y);
                            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                root.sliding(false);
                            }
                        }
                        moved => { if (self.pressed) { self.at(self.mouse-x, self.mouse-y); } }
                    }
                }
                // The hues.
                Rectangle {
                    height: 14px;
                    border-radius: 7px;
                    background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        x: root.hue / 360 * (parent.width - self.width);
                        border-radius: 7px;
                        border-width: 2px;
                        border-color: #ffffff;
                        background: Colors.hsv(root.hue, 1, 1);
                        drop-shadow-blur: 3px;
                        drop-shadow-color: #00000080;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        function at(x: length) {
                            root.hue = clamp((x - 7px) / max(1px, parent.width - 14px), 0, 1) * 359.9;
                            root.send();
                        }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.sliding(true);
                                self.at(self.mouse-x);
                            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                                root.sliding(false);
                            }
                        }
                        moved => { if (self.pressed) { self.at(self.mouse-x); } }
                    }
                }
                // The code, and the colour it gives.
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 32px;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: Theme.control-stroke;
                        background: Colors.hsv(root.hue, root.sat, root.val);
                    }
                    field := TextBox {
                        horizontal-stretch: 1;
                        text: root.code;
                        placeholder: "#RRGGBB";
                        // A code that is not a colour gives way to the colour as it is.
                        accepted(s) => { root.typed(root.editing, s); field.show(root.code); }
                    }
                }
                // As many as there are, across the width.
                HorizontalLayout {
                    spacing: 6px;
                    for c in root.swatches : Swatch {
                        width: (picker.inner - (root.swatches.length - 1) * 6px) / max(1, root.swatches.length);
                        height: 22px;
                        colour: c;
                        clicked => { root.take(c); }
                    }
                }
                if picker.pair-count > 0 : HorizontalLayout {
                    spacing: 6px;
                    for i in picker.pair-count : Rectangle {
                        height: 24px;
                        horizontal-stretch: 1;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: pair.has-hover ? Theme.text-2 : Theme.control-stroke;
                        background: @linear-gradient(135deg, root.pairs[2 * i] 0%, root.pairs[2 * i + 1] 100%);
                        pair := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.chosen(root.pair-values[i]); picker.close(); }
                        }
                    }
                }
            }
        }
    }
    accessible-role: button;
}

// An entry of the side navigation: the current one on a light ground, in bold, its icon in the accent colour.
export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> current: false;
    in property <bool> badge: false;
    in property <bool> animated: true;
    callback clicked();

    height: 36px;
    border-radius: Theme.radius + 2px;
    background: touch.pressed ? Theme.subtle-pressed
        : root.current ? Theme.selected
        : touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: root.animated ? Theme.t-normal : 0ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            tint: root.current ? Theme.accent : Theme.text;
            size: 18px;
            animate tint { duration: root.animated ? Theme.t-normal : 0ms; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            font-weight: root.current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.badge : Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Theme.accent;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: tab;
    accessible-label: root.text;
}

// A card: rounded and outlined, on the card colour.
export component Card inherits Rectangle {
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.card;
}

// Rows that belong together: each is a card of its own, a few pixels apart.
export component Group inherits VerticalLayout {
    spacing: 8px;
}

// The tooltip of the window, its last child.
export component TipLayer inherits Rectangle {
    if Tip.text != "" : Rectangle {
        property <length> gap: 8px;
        property <bool> up: Tip.bottom + self.gap + self.height > root.height - 8px;
        x: clamp(Tip.left, 8px, max(8px, root.width - self.width - 8px));
        y: self.up ? Tip.top - self.gap - self.height : Tip.bottom + self.gap;
        width: min(380px, body.preferred-width + 28px);
        height: body.preferred-height + 24px;
        background: Theme.flyout;
        border-radius: Theme.radius-flyout;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        drop-shadow-offset-y: 4px;
        body := Text {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            text: Tip.text;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

// A small "i" (or, with `alert`, a warning sign): its text shows while the pointer rests on it.
export component InfoTip inherits Rectangle {
    in property <string> text;
    in property <bool> alert: false;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: root.alert ? 0px : 1px;
    border-color: area.has-hover ? Theme.accent : Theme.text-3;
    animate border-color { duration: Theme.t-fast; }
    if root.alert : Icon {
        data: Icons.warning;
        tint: Theme.warning;
        size: 16px;
    }
    if !root.alert : Text {
        width: parent.width;
        height: parent.height;
        text: "i";
        color: area.has-hover ? Theme.accent : Theme.text-3;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Where its tooltip goes from, in the window.
    property <length> left: root.absolute-position.x - 12px;
    area := TouchArea {
        // A little larger than the dot, easier to rest on.
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        changed has-hover => {
            if self.has-hover {
                Tip.text = root.text;
                Tip.left = root.left;
                Tip.top = root.absolute-position.y;
                Tip.bottom = root.absolute-position.y + root.height;
            // Unless another one took the tooltip meanwhile. Not by its place: a scroll moves it.
            } else if Tip.text == root.text {
                Tip.text = "";
            }
        }
    }
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
}

// A setting, as a card: a title (and a line of explanation) on the left, the control on the right; narrower than
// `stack-under`, the control goes under the text. The text wraps, and the height follows it.
export component GroupRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    // What the setting does and what to choose: shown on hover over the title.
    in property <string> info;
    // What is wrong with it as it is: behind a warning sign beside the title.
    in property <string> warning;
    in property <bool> dimmed: false;
    in property <bool> clickable: false;
    in property <length> stack-under: 500px;
    // A picture before the title (a program's icon), or a glyph (see `Icons`).
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> glyph;
    // The colour of the glyph and the title (green for "all is well", for instance).
    in property <color> tint: Theme.text;
    // A row that appears on a page already shown (a setting that only makes sense with the one above): it unfolds from
    // nothing instead of popping in.
    in property <bool> unfold: false;
    // A row that no longer applies: it folds away to nothing before it is removed.
    in property <bool> fold: false;
    // Found by a search: outlined in the accent colour for a moment.
    in property <bool> flash: false;
    // A card of its own; else a row of a card shared with its group (no frame), under a line when `divider`.
    in property <bool> framed: true;
    in property <bool> divider: false;
    // Belongs to the row above it: set in, joined to it by a line that turns at a right angle.
    in property <bool> nested: false;
    // The row under it belongs to the same row: the line goes on down to it.
    in property <bool> nested-next: false;
    callback clicked();

    property <bool> stacked: root.width < root.stack-under;
    property <length> pad: 16px;
    property <length> indent: root.nested ? 28px : 0px;
    property <bool> lead-on: root.has-icon || root.glyph != "";
    property <length> lead: root.indent + (root.lead-on ? 36px : 0px);
    property <length> text-w: root.stacked ? root.width - 2 * root.pad - root.lead
        : max(120px, root.width - 2 * root.pad - root.lead - ctl.preferred-width - 24px);
    property <length> body: root.stacked ? txt.preferred-height + 10px + ctl.preferred-height
        : max(txt.preferred-height, ctl.preferred-height);
    property <length> natural: root.framed ? max(64px, root.body + 32px) : max(56px, root.body + 24px);
    property <bool> grown: !root.unfold;
    // A row made already leaving starts shown, then folds (the change is what animates).
    property <bool> folded: false;
    property <bool> shown: root.grown && !root.folded;
    height: root.shown ? root.natural : 0px;
    opacity: root.shown ? 1 : 0;
    // Only while unfolding or folding: a row that changes its height otherwise follows it at once.
    animate height, opacity { duration: root.unfold || root.fold ? Theme.t-normal : 0ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    clip: root.unfold || root.fold;
    Timer {
        interval: 16ms;
        running: root.unfold && !root.grown;
        triggered => { root.grown = true; }
    }
    Timer {
        interval: 16ms;
        running: root.fold && !root.folded;
        triggered => { root.folded = true; }
    }
    border-radius: root.framed || root.flash ? Theme.radius-card : 0px;
    border-width: root.flash ? 2px : (root.framed ? 1px : 0px);
    border-color: root.flash ? Theme.accent : Theme.stroke;
    animate border-color { duration: Theme.t-slow; }
    // A card of its own changes its fill; a row of a shared card shades it (another card's colour on top would whiten
    // it behind Mica). At rest the shade keeps its colour, at no opacity: from `transparent` (black) the animation
    // passes through grey.
    background: root.framed
        ? (root.clickable && touch.pressed ? Theme.card-pressed : (root.clickable && touch.has-hover ? Theme.card-hover : Theme.card))
        : (root.clickable && touch.pressed ? Theme.subtle-pressed : (root.clickable && touch.has-hover ? Theme.subtle-hover : Theme.subtle-hover.with-alpha(0)));
    animate background { duration: Theme.t-fast; }
    if root.divider : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.stroke;
    }

    // From the row's top: the row above lights up to its own edge under the pointer, and the line does not go into it.
    if root.nested : Rectangle {
        x: root.pad + 6px;
        y: 0px;
        width: 1px;
        height: root.nested-next ? root.natural : txt.y + 10px;
        background: Theme.stroke-strong;
    }
    if root.nested : Rectangle {
        x: root.pad + 6px;
        y: txt.y + 10px;
        width: root.indent - 12px;
        height: 1px;
        background: Theme.stroke-strong;
    }
    touch := TouchArea {
        enabled: root.clickable && !root.fold;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.has-icon : Image {
        x: root.pad + root.indent;
        y: (root.natural - self.height) / 2;
        width: 22px;
        height: 22px;
        source: root.icon;
        opacity: root.dimmed ? 0.45 : 1.0;
    }
    if !root.has-icon && root.glyph != "" : Icon {
        x: root.pad + root.indent + 1px;
        y: (root.natural - self.height) / 2;
        data: root.glyph;
        size: 20px;
        tint: root.tint;
        opacity: root.dimmed ? 0.45 : 1.0;
    }
    txt := VerticalLayout {
        x: root.pad + root.lead;
        y: root.stacked ? 13px : (root.natural - self.preferred-height) / 2;
        width: root.text-w;
        height: self.preferred-height;
        spacing: 2px;
        opacity: root.dimmed ? 0.45 : 1.0;
        animate opacity { duration: Theme.t-normal; }
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Rectangle {
                horizontal-stretch: 1;
                preferred-width: title.preferred-width;
                height: title.preferred-height;
                title := Text {
                    width: parent.width;
                    text: root.title;
                    color: root.tint;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                TouchArea {
                    enabled: root.info != "";
                    mouse-cursor: root.clickable ? pointer : help;
                    clicked => { if root.clickable { root.clicked(); } }
                    changed has-hover => {
                        if self.has-hover {
                            Tip.text = root.info;
                            Tip.left = root.absolute-position.x + txt.x;
                            Tip.top = root.absolute-position.y + txt.y;
                            Tip.bottom = root.absolute-position.y + txt.y + title.height;
                        } else if Tip.text == root.info {
                            Tip.text = "";
                        }
                    }
                }
            }
            if root.warning != "" : InfoTip {
                y: (parent.height - self.height) / 2;
                text: root.warning;
                alert: true;
            }
        }
        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-3;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
    ctl := HorizontalLayout {
        x: root.stacked ? root.pad : parent.width - root.pad - self.preferred-width;
        y: root.stacked ? 13px + txt.preferred-height + 10px : (root.natural - self.preferred-height) / 2;
        width: min(self.preferred-width, parent.width - 2 * root.pad);
        height: self.preferred-height;
        spacing: 12px;
        opacity: root.dimmed ? 0.6 : 1.0;
        animate opacity { duration: Theme.t-normal; }
        @children
    }
}

// A line of release notes. kind: 0 a paragraph, 1 a section's title, 2 a list item `level` deep.
export struct NoteLine {
    kind: int,
    level: int,
    text: string,
}

// Release notes: the sections' titles apart, the items behind a dot, each nested one set in further.
export component Notes inherits VerticalLayout {
    in property <[NoteLine]> lines;

    alignment: start;
    spacing: 6px;
    for l[i] in root.lines : VerticalLayout {
        padding-top: l.kind == 1 && i > 0 ? 12px : 0px;
        if l.kind == 1 : Text {
            text: l.text;
            color: Theme.text;
            font-size: 14px;
            font-weight: 600;
            wrap: word-wrap;
        }
        if l.kind == 0 : Text {
            text: l.text;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
        // Not a horizontal layout: its text would be measured on one line, and the notes would not be as high as they
        // are.
        if l.kind == 2 : Rectangle {
            height: item.preferred-height;
            Rectangle {
                x: l.level * 18px;
                y: 7px;
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: l.level == 0 ? Theme.accent : Theme.text-3;
            }
            item := Text {
                x: l.level * 18px + 15px;
                y: 0px;
                width: parent.width - self.x;
                height: self.preferred-height;
                text: l.text;
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

// A message in a coloured band. kind: 0 information, 1 warning, 2 error.
export component InfoBar inherits Card {
    in property <string> text;
    in property <int> kind: 0;
    preferred-height: row.preferred-height;
    background: root.kind == 2 ? Theme.danger-fill : (root.kind == 1 ? Theme.warning-fill : Theme.card);
    row := HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Icon {
            data: root.kind == 2 ? Icons.error : (root.kind == 1 ? Icons.warning : Icons.info);
            tint: root.kind == 2 ? Theme.danger : (root.kind == 1 ? Theme.warning : Theme.accent);
            size: 18px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    height: 6px;
    border-radius: 3px;
    background: Theme.control-stroke;
    clip: true;
    Rectangle {
        x: 0px;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.accent;
        animate width { duration: Theme.t-slow; easing: ease-out; }
    }
}

// A scrollable area with a thin scroll bar that appears on hover.
export component ScrollArea inherits Rectangle {
    clip: true;
    // Scrolls so that what is at `abs-y` (a window coordinate) shows near the top.
    public function reveal(abs-y: length) {
        let inside = abs-y - root.absolute-position.y - fl.content-y;
        fl.content-y = clamp(24px - inside, min(0px, root.height - fl.content-height), 0px);
    }
    // Back to the top.
    public function to-top() { fl.content-y = 0px; }
    // A taller window or a shorter page: no room left under the end of the page.
    property <length> lowest: min(0px, root.height - fl.content-height);
    changed lowest => { if fl.content-y < self.lowest { fl.content-y = self.lowest; } }
    fl := Flickable {
        // What a tooltip belonged to has moved away from it.
        changed viewport-y => { Tip.text = ""; }
        @children
    }
    property <bool> scrollable: fl.content-height > root.height + 1px;
    // The bar: thin, wider under the pointer; it can be dragged.
    bar := Rectangle {
        visible: root.scrollable;
        property <bool> wide: bar-touch.has-hover || bar-touch.pressed;
        // Anchored to the right edge: an animated position would lag behind a resize.
        x: root.width - self.width - 3px;
        y: 2px + (root.height - 4px - self.height) * clamp(-fl.content-y / max(1px, fl.content-height - root.height), 0, 1);
        width: self.wide ? 8px : 4px;
        height: max(32px, (root.height - 4px) * root.height / max(1px, fl.content-height));
        border-radius: self.width / 2;
        background: Theme.text-3;
        opacity: self.wide ? 0.9 : 0.55;
        animate width, opacity { duration: Theme.t-fast; }
    }
    bar-touch := TouchArea {
        visible: root.scrollable;
        x: root.width - 12px;
        width: 12px;
        property <length> grab;
        property <length> start;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { self.grab = self.mouse-y; self.start = fl.content-y; }
        }
        moved => {
            if self.pressed {
                let travel = max(1px, root.height - 4px - bar.height);
                let room = max(0px, fl.content-height - root.height);
                fl.content-y = clamp(self.start - (self.mouse-y - self.grab) * room / travel, -room, 0px);
            }
        }
    }
}

// The search field of the side navigation: a magnifier, the text, a cross that empties it.
export component SearchBox inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited(string);
    public function clear() { input.text = ""; root.text = ""; root.edited(""); }

    height: 36px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.control-stroke;
    background: input.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background, border-color { duration: Theme.t-fast; }
    property <bool> kept: input.has-focus && touch.has-hover;
    changed kept => { Fields.kept = self.kept; }
    property <int> blur: Fields.blur;
    changed blur => { input.clear-focus(); }
    Icon {
        x: 12px;
        y: (parent.height - self.height) / 2;
        data: Icons.search;
        tint: input.has-focus ? Theme.accent : Theme.text-2;
        size: 16px;
    }
    Text {
        x: 38px;
        width: parent.width - 38px - 32px;
        height: parent.height;
        text: root.placeholder;
        visible: input.text == "";
        color: Theme.text-3;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
        input := TextInput {
            x: 38px;
            width: parent.width - 38px - 32px;
            height: parent.height;
            text <=> root.text;
            color: Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-accent;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            edited => { root.edited(self.text); }
            key-pressed(e) => {
                if e.text == Key.Escape { root.clear(); return accept; }
                reject
            }
        }
    }
    if root.text != "" : IconButton {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        icon: Icons.dismiss;
        size: 24px;
        tint: Theme.text-2;
        clicked => { root.clear(); }
    }
    accessible-role: text-input;
    accessible-label: root.placeholder;
}

// A small screen to click on: an edge (left, right, top, bottom) of it, or a place for a small window (top left, top
// centre, top right, bottom left, bottom centre, bottom right, then one of the user's: a click or a drag anywhere else
// puts it there). The chosen one is in the accent colour.
export component ScreenPicker inherits Rectangle {
    // false: the four edges; true: the six places, and the user's own when it has a seventh option.
    in property <bool> corners;
    // The names of the places, in the order above.
    in property <[string]> options;
    in property <int> current: -1;
    // The user's place, in thousandths of the room across and down (-1: none yet).
    in property <int> custom-x: -1;
    in property <int> custom-y: -1;
    callback selected(int);
    // A place of the user's, in thousandths of the room across and down.
    callback placed(int, int);

    width: 176px;
    height: 112px;
    // The screen, on a little stand.
    screen := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 99px;
        border-radius: 6px;
        border-width: 2px;
        border-color: Theme.stroke-strong;
        background: Theme.control;
        // The size of a small window, and the room it has inside the screen.
        property <length> win-w: 34px;
        property <length> win-h: 20px;
        property <length> room-w: self.width - self.win-w - 16px;
        property <length> room-h: self.height - self.win-h - 16px;
        // While pressed, where the user's window goes (thousandths).
        property <int> drag-x: round(clamp((anywhere.mouse-x - 8px - self.win-w / 2) / self.room-w, 0, 1) * 1000);
        property <int> drag-y: round(clamp((anywhere.mouse-y - 8px - self.win-h / 2) / self.room-h, 0, 1) * 1000);
        property <bool> free: root.corners && root.options.length > 6;
        anywhere := TouchArea {
            enabled: parent.free;
            mouse-cursor: parent.free ? pointer : default;
            clicked => { root.placed(parent.drag-x, parent.drag-y); }
        }
        for i in root.corners ? 6 : 4 : Rectangle {
            property <bool> chosen: i == root.current;
            // Edges: bars along the middle of each side; places: small windows.
            property <length> bar: 6px;
            property <length> long-h: parent.width * 0.42;
            property <length> long-v: parent.height * 0.46;
            property <int> column: mod(i, 3);
            x: root.corners
                ? (self.column == 0 ? 8px : self.column == 1 ? (parent.width - self.width) / 2 : parent.width - self.width - 8px)
                : (i == 0 ? 6px : i == 1 ? parent.width - self.width - 6px : (parent.width - self.width) / 2);
            y: root.corners
                ? (i < 3 ? 8px : parent.height - self.height - 8px)
                : (i == 2 ? 6px : i == 3 ? parent.height - self.height - 6px : (parent.height - self.height) / 2);
            width: root.corners ? parent.win-w : (i < 2 ? self.bar : self.long-h);
            height: root.corners ? parent.win-h : (i < 2 ? self.long-v : self.bar);
            border-radius: root.corners ? 4px : 3px;
            background: self.chosen && !anywhere.pressed ? Theme.accent
                : (zone.has-hover ? Theme.text-2 : Theme.stroke-strong);
            animate background { duration: Theme.t-fast; }
            zone := TouchArea {
                // Larger than what is drawn, easy to hit.
                x: -8px;
                y: -8px;
                width: parent.width + 16px;
                height: parent.height + 16px;
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
            accessible-role: button;
            accessible-label: i < root.options.length ? root.options[i] : "";
            accessible-checked: self.chosen;
        }
        // The user's window: where it is, or where the pointer drags it.
        if root.corners && (anywhere.pressed || (root.current == 6 && root.custom-x >= 0)) : Rectangle {
            property <int> fx: anywhere.pressed ? parent.drag-x : root.custom-x;
            property <int> fy: anywhere.pressed ? parent.drag-y : root.custom-y;
            x: 8px + parent.room-w * self.fx / 1000;
            y: 8px + parent.room-h * self.fy / 1000;
            width: parent.win-w;
            height: parent.win-h;
            border-radius: 4px;
            background: Theme.accent;
            accessible-role: button;
            accessible-label: 6 < root.options.length ? root.options[6] : "";
            accessible-checked: true;
        }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: screen.height;
        width: 14px;
        height: 7px;
        background: Theme.stroke-strong;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: screen.height + 7px;
        width: 56px;
        height: 4px;
        border-radius: 2px;
        background: Theme.stroke-strong;
    }
}

// How loud a sound is, 0 to 1: green, then amber, then red near the top.
export component LevelMeter inherits Rectangle {
    in property <float> level;
    width: 240px;
    height: 32px;
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8px;
        border-radius: 4px;
        background: Theme.control-stroke;
        clip: true;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.level, 0, 1);
            border-radius: 4px;
            background: root.level > 0.9 ? Theme.danger : (root.level > 0.75 ? Theme.warning : Theme.success);
            animate width { duration: 80ms; }
        }
    }
    accessible-role: progress-indicator;
    accessible-value: round(root.level * 100);
}
