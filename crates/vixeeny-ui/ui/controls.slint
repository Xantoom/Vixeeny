// The controls of every Vixeeny window, drawn after the Windows 11 (Fluent) ones: plain Slint
// elements only (std-widgets would pull the SVG decoder in), colours and motion from `Theme`.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
export { Theme } from "theme.slint";
export { Icons } from "icons.slint";

// A 20-unit Fluent glyph (see `Icons`) drawn as a path, sharp at any scale.
export component Icon inherits Rectangle {
    in property <string> data;
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    width: root.size;
    height: root.size;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.data;
        fill: root.tint;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> accent: false;
    in property <bool> subtle: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 32px;
    height: 32px;
    preferred-width: row.preferred-width;
    border-radius: Theme.radius;
    border-width: root.accent || root.subtle ? 0px : 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.accent
        ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent))
        : root.subtle
            ? (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent))
            : (touch.pressed ? Theme.control-pressed : (touch.has-hover ? Theme.control-hover : Theme.control));
    animate background { duration: Theme.t-fast; }

    row := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 14px;
        padding-right: root.text == "" ? 8px : 14px;
        spacing: 8px;
        alignment: center;
        if root.icon != "" : Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            tint: root.accent ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
        }
        if root.text != "" : Text {
            text: root.text;
            color: root.accent ? Theme.on-accent : (root.danger ? Theme.danger : Theme.text);
            font-size: 14px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <color> tint: Theme.text;
    in property <length> size: 32px;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: Theme.radius;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.active ? Theme.accent-soft
        : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Icon {
        data: root.icon;
        tint: root.active ? Theme.accent : root.tint;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.label;
}

export component Toggle inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 40px;
    height: 20px;
    border-radius: 10px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.on ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent))
        : (touch.has-hover ? Theme.subtle-hover : transparent);
    border-width: root.on ? 0px : 1px;
    border-color: Theme.stroke-strong;
    animate background { duration: Theme.t-fast; }

    Rectangle {
        property <length> d: touch.pressed ? 17px : (touch.has-hover ? 14px : 12px);
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        y: (parent.height - self.d) / 2 - (root.on ? 0px : 1px);
        x: root.on ? parent.width - self.d - 4px : 4px;
        background: root.on ? Theme.on-accent : Theme.text-2;
        animate x, width, height, y { duration: Theme.t-normal; easing: cubic-bezier(0, 0, 0, 1); }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    accessible-role: switch;
    accessible-checked: root.on;
}

export component Check inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> text;
    callback toggled(bool);

    height: 32px;
    preferred-width: row.preferred-width;
    opacity: root.enabled ? 1.0 : 0.45;
    row := HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: root.on ? 0px : 1px;
            border-color: Theme.stroke-strong;
            background: root.on ? Theme.accent : (touch.has-hover ? Theme.subtle-hover : transparent);
            animate background { duration: Theme.t-fast; }
            if root.on : Icon {
                data: Icons.checkmark;
                tint: Theme.on-accent;
                size: 14px;
                x: 3px;
                y: 3px;
            }
        }
        if root.text != "" : Text {
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            wrap: word-wrap;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.text;
}

export component TextBox inherits Rectangle {
    in property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    callback edited(string);
    callback accepted(string);

    min-width: 120px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    background: input.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }

    // The focus underline.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        x: 1px;
        width: parent.width - 2px;
        border-radius: 1px;
        background: Theme.accent;
        visible: input.has-focus;
    }
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.placeholder;
        visible: input.text == "" && !input.has-focus;
        color: Theme.text-3;
        font-size: 14px;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: MouseCursor.text; }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.text;
        enabled: root.enabled;
        read-only: root.read-only;
        color: Theme.text;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-accent;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        changed has-focus => { if (!self.has-focus) { root.accepted(self.text); } }
    }
    accessible-role: text-input;
    accessible-label: root.placeholder;
}

export component ComboBox inherits Rectangle {
    in property <[string]> options;
    in property <int> current: -1;
    in property <bool> enabled: true;
    in property <string> placeholder;
    callback selected(int);

    min-width: 140px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    background: touch.pressed ? Theme.control-pressed : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: root.current >= 0 && root.current < root.options.length ? root.options[root.current] : root.placeholder;
            color: root.current >= 0 ? Theme.text : Theme.text-3;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            y: (parent.height - self.height) / 2;
            data: Icons.chevron-down;
            tint: Theme.text-2;
            size: 12px;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        // The list is at least as wide as the box, wider when the choices need it.
        x: 0;
        y: root.height + 2px;
        width: max(root.width, 220px);
        height: min(root.options.length * 36px + 8px, 320px);
        Rectangle {
            background: Theme.flyout;
            border-radius: Theme.radius-flyout;
            border-width: 1px;
            border-color: Theme.stroke-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000050;
            drop-shadow-offset-y: 6px;
            Flickable {
                content-height: root.options.length * 36px + 8px;
                for option[i] in root.options : Rectangle {
                    x: 4px;
                    y: 4px + i * 36px;
                    width: parent.width - 8px;
                    height: 34px;
                    border-radius: Theme.radius;
                    background: item.pressed ? Theme.subtle-pressed : (item.has-hover || i == root.current ? Theme.subtle-hover : transparent);
                    if i == root.current : Rectangle {
                        x: 0px;
                        y: (parent.height - 16px) / 2;
                        width: 3px;
                        height: 16px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                    }
                    Text {
                        x: 12px;
                        width: parent.width - 20px;
                        text: option;
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.selected(i); menu.close(); }
                    }
                }
            }
        }
    }
    accessible-role: combobox;
}

// "−  42  +"
export component NumberBox inherits Rectangle {
    in property <int> value;
    in property <int> lo: 0;
    in property <int> hi: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;
    callback changed(int);

    width: 136px;
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: Theme.control;
    opacity: root.enabled ? 1.0 : 0.45;
    HorizontalLayout {
        IconButton {
            icon: Icons.subtract;
            size: 30px;
            enabled: root.enabled && root.value > root.lo;
            clicked => { root.changed(max(root.lo, root.value - root.step)); }
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            color: Theme.text;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        IconButton {
            icon: Icons.add;
            size: 30px;
            enabled: root.enabled && root.value < root.hi;
            clicked => { root.changed(min(root.hi, root.value + root.step)); }
        }
    }
}

export component Slider inherits Rectangle {
    in property <int> value;
    in property <int> lo: 0;
    in property <int> hi: 100;
    in property <int> step: 1;
    in property <bool> enabled: true;
    callback changed(int);

    min-width: 160px;
    height: 32px;
    opacity: root.enabled ? 1.0 : 0.45;
    property <float> ratio: root.hi > root.lo ? (clamp(root.value, root.lo, root.hi) - root.lo) / (root.hi - root.lo) : 0;
    function pick(x: length) {
        if (!root.enabled) { return; }
        // A 20 px thumb: the travel is the width minus one thumb.
        let r = clamp((x - 10px) / max(1px, root.width - 20px), 0, 1);
        let raw = root.lo + r * (root.hi - root.lo);
        let snapped = root.lo + round((raw - root.lo) / max(1, root.step)) * max(1, root.step);
        root.changed(clamp(round(snapped), root.lo, root.hi));
    }
    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        height: 4px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: Theme.stroke-strong;
        Rectangle {
            width: parent.width * root.ratio;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        x: root.ratio * (parent.width - 20px);
        y: (parent.height - 20px) / 2;
        background: Theme.dark ? #454545 : #ffffff;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        Rectangle {
            property <length> d: touch.pressed ? 10px : (touch.has-hover ? 14px : 12px);
            width: self.d;
            height: self.d;
            border-radius: self.d / 2;
            x: (parent.width - self.d) / 2;
            y: (parent.height - self.d) / 2;
            background: Theme.accent;
            animate width, height, x, y { duration: Theme.t-fast; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => { if (e.kind == PointerEventKind.down) { root.pick(self.mouse-x); } }
        moved => { if (self.pressed) { root.pick(self.mouse-x); } }
    }
    accessible-role: slider;
    accessible-value: root.value;
}

// Two to four exclusive choices side by side (software / hardware, light / dark…).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.control-stroke;
    background: Theme.control;
    opacity: root.enabled ? 1.0 : 0.45;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[i] in root.options : Rectangle {
            border-radius: 3px;
            min-width: label.preferred-width + 28px;
            background: i == root.current ? Theme.accent : (item.has-hover ? Theme.subtle-hover : transparent);
            animate background { duration: Theme.t-fast; }
            label := Text {
                text: option;
                color: i == root.current ? Theme.on-accent : Theme.text;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            item := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
            accessible-role: radio-button;
            accessible-label: option;
        }
    }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> current: false;
    callback clicked();

    height: 40px;
    border-radius: Theme.radius;
    background: root.current ? Theme.selected : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.current ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: Theme.t-normal; easing: cubic-bezier(0, 0, 0, 1); }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 14px;
        Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            tint: root.current ? Theme.accent : Theme.text-2;
            size: 18px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: tab;
    accessible-label: root.text;
}

// A row of the settings: a title (and a line of explanation) on the left, its control on the
// right. The text wraps instead of being cut.
export component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> icon;
    in property <bool> dimmed: false;
    in property <bool> clickable: false;
    callback clicked();

    // The text wraps: the height is estimated from the room the text has (the width of the
    // control and the icon are taken off), as a Slint layout does not grow a wrapped text.
    property <length> room: max(80px, root.width - 32px - 16px - ctl.preferred-width - (root.icon != "" ? 36px : 0px));
    property <int> title-lines: Math.max(1, Math.ceil(root.title.character-count * 7.8px / root.room));
    property <int> hint-lines: root.description == "" ? 0 : Math.max(1, Math.ceil(root.description.character-count * 6.9px / root.room));
    property <length> wanted: 24px + root.title-lines * 20px + root.hint-lines * 16px + (root.hint-lines > 0 ? 2px : 0px);
    min-height: Math.max(56px, root.wanted);
    preferred-height: Math.max(56px, root.wanted);
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.stroke;
    background: root.clickable && touch.has-hover ? Theme.card-hover : Theme.card;
    animate background { duration: Theme.t-fast; }
    opacity: root.dimmed ? 0.5 : 1.0;

    layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        if root.icon != "" : Icon {
            y: (parent.height - self.height) / 2;
            data: root.icon;
            tint: Theme.text;
            size: 20px;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 120px;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 14px;
                wrap: word-wrap;
            }
            if root.description != "" : Text {
                text: root.description;
                color: Theme.text-2;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        ctl := VerticalLayout {
            alignment: center;
            @children
        }
    }
    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component SectionLabel inherits Text {
    color: Theme.text;
    font-size: 14px;
    font-weight: 600;
    wrap: word-wrap;
}

// A message in a coloured band. kind: 0 information, 1 warning, 2 error.
export component InfoBar inherits Rectangle {
    in property <string> text;
    in property <int> kind: 0;
    preferred-height: row.preferred-height;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.stroke;
    background: root.kind == 2 ? Theme.danger-fill : (root.kind == 1 ? Theme.warning-fill : Theme.card);
    row := HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        Icon {
            data: root.kind == 2 ? Icons.error : (root.kind == 1 ? Icons.warning : Icons.info);
            tint: root.kind == 2 ? Theme.danger : (root.kind == 1 ? Theme.warning : Theme.accent);
            size: 18px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    height: 4px;
    border-radius: 2px;
    background: Theme.stroke-strong;
    Rectangle {
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 2px;
        background: Theme.accent;
        animate width { duration: Theme.t-normal; }
    }
}

// A small rounded label that can be selected (formats, filters).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    preferred-width: label.preferred-width + 28px;
    border-radius: 16px;
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.control-stroke;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.selected ? Theme.accent : (touch.has-hover ? Theme.control-hover : Theme.control);
    animate background { duration: Theme.t-fast; }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
}

// A scrollable area with a thin scroll bar that appears on hover.
export component ScrollArea inherits Rectangle {
    in-out property <length> scroll-y <=> fl.content-y;
    out property <length> total-height: fl.content-height;
    clip: true;
    fl := Flickable {
        @children
    }
    property <bool> scrollable: fl.content-height > root.height + 1px;
    Rectangle {
        visible: root.scrollable;
        x: root.width - 8px;
        y: 2px + (root.height - 4px - self.height) * (-fl.content-y / max(1px, fl.content-height - root.height));
        width: 4px;
        height: max(32px, (root.height - 4px) * root.height / max(1px, fl.content-height));
        border-radius: 2px;
        background: Theme.text-3;
        opacity: 0.6;
    }
}
