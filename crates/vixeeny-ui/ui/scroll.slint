import { Theme, Icons, Button, Card } from "controls.slint";

// Control window of a scrolling capture: the live vertical preview of what has been assembled, and the Finish / Cancel
// buttons. The capture runs from the start.
export component ScrollWindow inherits Window {
    in property <string> status;
    in property <image> preview;
    in property <string> finish-label: "Finish";
    in property <string> cancel-label: "Cancel";

    callback finish();
    callback cancel();

    title: "Vixeeny";
    icon: Theme.app-icon;
    always-on-top: true;
    min-width: 240px;
    preferred-width: 280px;
    preferred-height: 440px;
    default-font-family: Theme.font;
    background: Theme.bg;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                root.finish();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Card {
                vertical-stretch: 1;
                clip: true;
                Image {
                    source: root.preview;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    x: 4px;
                    y: 4px;
                    image-fit: contain;
                }
            }

            Text {
                text: root.status;
                color: Theme.text-2;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: root.cancel-label;
                    clicked => { root.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: root.finish-label;
                    icon: Icons.checkmark;
                    accent: true;
                    clicked => { root.finish(); }
                }
            }
        }
    }
}
