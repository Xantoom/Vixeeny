import { Theme, Icons, Button } from "controls.slint";

// Control window of a scrolling capture (plan 5.7): the live vertical preview of what has been
// assembled, and the Start / Finish / Cancel buttons.
export component ScrollWindow inherits Window {
    in property <string> status;
    in property <image> preview;
    in property <bool> running: false;
    in property <string> start-label: "Start";
    in property <string> finish-label: "Finish";
    in property <string> cancel-label: "Cancel";

    callback start();
    callback finish();
    callback cancel();

    title: "Vixeeny";
    icon: Theme.app-icon;
    always-on-top: true;
    min-width: 240px;
    preferred-width: 280px;
    preferred-height: 440px;
    default-font-family: Theme.font;
    background: Theme.bg;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.running) { root.finish(); } else { root.start(); }
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            Rectangle {
                vertical-stretch: 1;
                background: Theme.card;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.stroke;
                clip: true;
                Image {
                    source: root.preview;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    x: 4px;
                    y: 4px;
                    image-fit: contain;
                }
            }

            Text {
                text: root.status;
                color: Theme.text-2;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: root.cancel-label;
                    clicked => { root.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.running : Button {
                    text: root.start-label;
                    icon: Icons.play-filled;
                    accent: true;
                    clicked => { root.start(); }
                }
                if root.running : Button {
                    text: root.finish-label;
                    icon: Icons.checkmark;
                    accent: true;
                    clicked => { root.finish(); }
                }
            }
        }
    }
}
