import { PushButton } from "ocr.slint";

// Control window of a scrolling capture (plan 5.7): the live vertical preview of what has been
// assembled, and the Start / Finish / Cancel buttons.
export component ScrollWindow inherits Window {
    in property <string> window-title: "Vixeeny";
    in property <string> status;
    in property <image> preview;
    in property <bool> running: false;
    in property <string> start-label: "Start";
    in property <string> finish-label: "Finish";
    in property <string> cancel-label: "Cancel";

    callback start();
    callback finish();
    callback cancel();

    title: root.window-title;
    always-on-top: true;
    min-width: 220px;
    preferred-width: 260px;
    preferred-height: 420px;
    default-font-family: "Inter";
    background: #1f2937;

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.running) { root.finish(); } else { root.start(); }
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            Rectangle {
                vertical-stretch: 1;
                background: #111827;
                border-radius: 6px;
                border-width: 1px;
                border-color: #374151;
                clip: true;
                Image {
                    source: root.preview;
                    width: parent.width - 8px;
                    height: parent.height - 8px;
                    x: 4px;
                    y: 4px;
                    image-fit: contain;
                }
            }

            Text {
                text: root.status;
                color: #d1d5db;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                PushButton {
                    label: root.cancel-label;
                    clicked => { root.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
                if !root.running : PushButton {
                    label: root.start-label;
                    primary: true;
                    clicked => { root.start(); }
                }
                if root.running : PushButton {
                    label: root.finish-label;
                    primary: true;
                    clicked => { root.finish(); }
                }
            }
        }
    }
}
