import { Theme, Button, Card, Toggle, ScrollArea } from "controls.slint";

// Shown at the first start after an update: the new version and what changed in it.
export component WhatsNewWindow inherits Window {
    in property <string> heading;
    // The list of changes (or why it is not there yet).
    in property <string> notes;
    in property <string> show-label;
    in property <string> ok-label;
    in-out property <bool> show-again: true;

    callback show-toggled(bool);
    callback done();

    title: "Vixeeny";
    icon: Theme.app-icon;
    min-width: 420px;
    preferred-width: 560px;
    preferred-height: 520px;
    default-font-family: Theme.font;
    background: Theme.bg;

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape || event.text == Key.Return {
                root.done();
                return accept;
            }
            reject
        }

        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            HorizontalLayout {
                spacing: 12px;
                Image {
                    source: Theme.app-icon;
                    width: 32px;
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.heading;
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            Card {
                vertical-stretch: 1;
                ScrollArea {
                    width: parent.width;
                    height: parent.height;
                    VerticalLayout {
                        padding: 16px;
                        Text {
                            text: root.notes;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                Toggle {
                    y: (parent.height - self.height) / 2;
                    on: root.show-again;
                    toggled(on) => {
                        root.show-again = on;
                        root.show-toggled(on);
                    }
                }
                Text {
                    text: root.show-label;
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Button {
                    text: root.ok-label;
                    accent: true;
                    clicked => { root.done(); }
                }
            }
        }
    }
}
