import { Theme, Icons, Icon } from "controls.slint";

// The recording widget (plan 5.9): a small dark pill with a pulsing red dot, the elapsed time, and
// the pause / stop buttons. In pause the dot is amber and still and the time frozen. With
// `auto-hide` it fades after 3 s and comes back under the pointer.
export component RecordingWidget inherits Window {
    in property <bool> paused: false;
    in property <string> time: "00:00:00";
    in property <bool> auto-hide: false;
    in property <string> pause-label: "Pause";
    in property <string> resume-label: "Resume";
    in property <string> stop-label: "Stop";

    callback pause-clicked();
    callback stop-clicked();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    preferred-width: 200px;
    preferred-height: 44px;

    property <bool> pulse: true;
    property <bool> faded: false;

    // Fades 3 s after the pointer left (or at the start).
    fade-timer := Timer {
        interval: 3s;
        running: root.auto-hide && !hover.has-hover;
        triggered => { root.faded = true; fade-timer.running = false; }
    }
    Timer {
        interval: 650ms;
        running: !root.paused;
        triggered => { root.pulse = !root.pulse; }
    }

    pill := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: Theme.dark ? #2c2c2cf2 : #fcfcfcf2;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        opacity: (root.faded && !hover.has-hover) ? 0.12 : 1.0;
        animate opacity { duration: Theme.t-slow; }

        hover := TouchArea {
            changed has-hover => {
                if (self.has-hover) { root.faded = false; }
                else if (root.auto-hide) { fade-timer.running = true; }
            }
        }

        HorizontalLayout {
            padding-left: 18px;
            padding-right: 8px;
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: root.paused ? Theme.warning : Theme.record;
                opacity: root.paused ? 1.0 : (root.pulse ? 1.0 : 0.35);
                animate opacity { duration: 600ms; }
            }

            Text {
                text: root.time;
                color: Theme.text;
                font-size: 15px;
                font-weight: 600;
                font-italic: false;
                vertical-alignment: center;
                accessible-role: text;
            }

            Rectangle { horizontal-stretch: 1; }

            // Pause / resume.
            Rectangle {
                width: 30px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                border-radius: 15px;
                background: pause-touch.pressed ? Theme.subtle-pressed : (pause-touch.has-hover ? Theme.subtle-hover : transparent);
                animate background { duration: Theme.t-fast; }
                accessible-role: button;
                accessible-label: root.paused ? root.resume-label : root.pause-label;
                Icon {
                    x: 7px; y: 7px;
                    data: root.paused ? Icons.play-filled : Icons.pause-filled;
                    tint: Theme.text;
                    size: 16px;
                }
                pause-touch := TouchArea { mouse-cursor: pointer; clicked => { root.pause-clicked(); } }
            }

            // Stop.
            Rectangle {
                width: 30px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                border-radius: 15px;
                background: stop-touch.pressed ? Theme.subtle-pressed : (stop-touch.has-hover ? Theme.subtle-hover : transparent);
                animate background { duration: Theme.t-fast; }
                accessible-role: button;
                accessible-label: root.stop-label;
                Icon { x: 7px; y: 7px; data: Icons.stop-filled; tint: Theme.record; size: 16px; }
                stop-touch := TouchArea { mouse-cursor: pointer; clicked => { root.stop-clicked(); } }
            }
        }
    }
}
