// The recording widget (plan 5.9): a small pill with a pulsing red dot, the elapsed time, and the
// pause / stop buttons. In pause the dot is orange and still and the time frozen. With
// `auto-hide` it fades after 3 s and comes back under the pointer.
export component RecordingWidget inherits Window {
    in property <bool> paused: false;
    in property <string> time: "00:00:00";
    in property <bool> auto-hide: false;
    in property <string> pause-label: "Pause";
    in property <string> resume-label: "Resume";
    in property <string> stop-label: "Stop";

    callback pause-clicked();
    callback stop-clicked();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Inter";
    preferred-width: 200px;
    preferred-height: 40px;

    property <bool> pulse: true;
    property <bool> faded: false;

    // Fades 3 s after the pointer left (or at the start).
    fade-timer := Timer {
        interval: 3s;
        running: root.auto-hide && !hover.has-hover;
        triggered => { root.faded = true; fade-timer.running = false; }
    }
    Timer {
        interval: 650ms;
        running: !root.paused;
        triggered => { root.pulse = !root.pulse; }
    }

    pill := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.height / 2;
        background: #111827ee;
        border-width: 1px;
        border-color: #ffffff22;
        opacity: (root.faded && !hover.has-hover) ? 0.12 : 1.0;
        animate opacity { duration: 250ms; }

        hover := TouchArea {
            changed has-hover => {
                if (self.has-hover) { root.faded = false; }
                else if (root.auto-hide) { fade-timer.running = true; }
            }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 12px;
                height: 12px;
                y: (parent.height - self.height) / 2;
                border-radius: 6px;
                background: root.paused ? #f59e0b : #ef4444;
                opacity: root.paused ? 1.0 : (root.pulse ? 1.0 : 0.35);
                animate opacity { duration: 600ms; }
            }

            Text {
                text: root.time;
                color: white;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
                accessible-role: text;
            }

            Rectangle { horizontal-stretch: 1; }

            // Pause / resume.
            Rectangle {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: pause-touch.has-hover ? #ffffff30 : transparent;
                accessible-role: button;
                accessible-label: root.paused ? root.resume-label : root.pause-label;
                if !root.paused : Rectangle {
                    x: 9px; y: 8px; width: 3.5px; height: 12px; background: white; border-radius: 1px;
                }
                if !root.paused : Rectangle {
                    x: 15.5px; y: 8px; width: 3.5px; height: 12px; background: white; border-radius: 1px;
                }
                if root.paused : Path {
                    x: 9px; y: 7px; width: 12px; height: 14px;
                    commands: "M 0 0 L 12 7 L 0 14 Z";
                    fill: white;
                }
                pause-touch := TouchArea { clicked => { root.pause-clicked(); } }
            }

            // Stop.
            Rectangle {
                width: 28px;
                height: 28px;
                y: (parent.height - self.height) / 2;
                border-radius: 14px;
                background: stop-touch.has-hover ? #ffffff30 : transparent;
                accessible-role: button;
                accessible-label: root.stop-label;
                Rectangle { x: 9px; y: 9px; width: 10px; height: 10px; background: white; border-radius: 2px; }
                stop-touch := TouchArea { clicked => { root.stop-clicked(); } }
            }
        }
    }
}
