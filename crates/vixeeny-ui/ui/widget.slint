// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme, Icons, Icon } from "controls.slint";

// A round button of the bar (pause, stop).
component BarButton inherits Rectangle {
    in property <string> icon;
    in property <color> tint: Theme.text;
    in property <string> label;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent);
    animate background { duration: Theme.t-fast; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        tint: root.tint;
        size: 16px;
        animate tint { duration: Theme.t-fast; }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

// The recording widget (plan 5.9): a small bar with a breathing red dot, the elapsed time, and
// the pause / stop buttons; the dotted handle moves it. In pause the dot is amber and still and
// the time frozen. With `auto-hide` it fades after 3 s and comes back under the pointer. The bar
// sits `margin` inside the window, for its shadow.
export component RecordingWidget inherits Window {
    in property <bool> paused: false;
    in property <string> time: "00:00:00";
    in property <bool> auto-hide: false;
    in property <string> pause-label: "Pause";
    in property <string> resume-label: "Resume";
    in property <string> stop-label: "Stop";
    // Rises into place when it appears (off for the tests, where no time passes).
    in property <bool> rise-in: true;

    callback pause-clicked();
    callback stop-clicked();
    // The handle is pressed: the host lets the system move the window.
    callback drag();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    preferred-width: 216px;
    preferred-height: 60px;

    property <length> margin: 10px;
    property <bool> pulse: true;
    property <bool> faded: false;
    property <bool> shown: !root.rise-in;

    // Fades 3 s after the pointer left (or at the start).
    fade-timer := Timer {
        interval: 3s;
        running: root.auto-hide && !hover.has-hover;
        triggered => { root.faded = true; fade-timer.running = false; }
    }
    // The dot breathes: a slow ease between full and dim.
    Timer {
        interval: 900ms;
        running: !root.paused;
        triggered => { root.pulse = !root.pulse; }
    }
    // Appears with a short rise once on screen.
    Timer {
        interval: 16ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }

    Rectangle {
        x: bar.x; y: bar.y + 3px; width: bar.width; height: bar.height;
        border-radius: bar.border-radius;
        background: #00000000;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 2px;
        opacity: bar.opacity;
    }

    bar := Rectangle {
        x: root.margin;
        y: root.margin + (root.shown ? 0px : 6px);
        animate y { duration: Theme.t-normal; easing: cubic-bezier(0.2, 0, 0, 1); }
        width: parent.width - 2 * root.margin;
        height: parent.height - 2 * root.margin;
        border-radius: Theme.radius-card;
        background: Theme.dark ? #232327eb : #ffffffeb;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        opacity: !root.shown ? 0 : ((root.faded && !hover.has-hover) ? 0.15 : 1.0);
        animate opacity { duration: Theme.t-slow; easing: ease-in-out; }

        hover := TouchArea {
            changed has-hover => {
                if (self.has-hover) { root.faded = false; }
                else if (root.auto-hide) { fade-timer.running = true; }
            }
        }

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 5px;
            spacing: 6px;
            alignment: start;

            // The handle: two columns of dots.
            Rectangle {
                width: 14px;
                border-radius: Theme.radius;
                background: grip.has-hover ? Theme.subtle-hover : transparent;
                animate background { duration: Theme.t-fast; }
                for i in 6 : Rectangle {
                    x: 4px + Math.mod(i, 2) * 4px;
                    y: (parent.height - 14px) / 2 + floor(i / 2) * 5px;
                    width: 2px; height: 2px; border-radius: 1px;
                    background: Theme.text-3;
                }
                grip := TouchArea {
                    mouse-cursor: move;
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.drag(); }
                    }
                }
            }

            // The dot, with a soft halo while recording.
            Rectangle {
                width: 16px;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: root.paused ? 10px : (root.pulse ? 16px : 10px);
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.record.with-alpha(root.paused ? 0 : 0.25);
                    opacity: root.pulse ? 1 : 0;
                    animate width, opacity { duration: 850ms; easing: ease-in-out; }
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.paused ? Theme.warning : Theme.record;
                    animate background { duration: Theme.t-normal; }
                }
            }

            Text {
                text: root.time;
                color: root.paused ? Theme.text-2 : Theme.text;
                animate color { duration: Theme.t-normal; }
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
                accessible-role: text;
            }

            Rectangle { horizontal-stretch: 1; }

            Rectangle {
                width: 1px;
                Rectangle { y: (parent.height - 18px) / 2; height: 18px; background: Theme.divider; }
            }

            BarButton {
                y: (parent.height - self.height) / 2;
                icon: root.paused ? Icons.play-filled : Icons.pause-filled;
                label: root.paused ? root.resume-label : root.pause-label;
                clicked => { root.pause-clicked(); }
            }
            BarButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.stop-filled;
                tint: Theme.record;
                label: root.stop-label;
                clicked => { root.stop-clicked(); }
            }
        }
    }
}
