import { Theme, Icons, Icon, Button, Check } from "controls.slint";

// The first-run assistant (plan 5.15): language, folders, start-up, hardware. The host owns the
// state and the texts; this window shows one step and reports what was touched.
component PathRow inherits HorizontalLayout {
    in property <string> caption;
    in property <string> path;
    in property <string> browse-text;
    callback browse();
    spacing: 10px;
    VerticalLayout {
        spacing: 4px;
        Text { text: root.caption; color: Theme.text-2; font-size: 12px; }
        Rectangle {
            height: 32px;
            border-radius: Theme.radius;
            background: Theme.control;
            border-width: 1px;
            border-color: Theme.control-stroke;
            Text {
                x: 10px;
                width: parent.width - 20px;
                text: root.path;
                color: Theme.text;
                font-size: 14px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
    VerticalLayout {
        alignment: end;
        Button { text: root.browse-text; icon: Icons.folder-open; clicked => { root.browse(); } }
    }
}

export component WizardWindow inherits Window {
    in property <int> step: 0;
    in property <string> heading;
    in property <string> body;
    in property <string> step-text;
    in property <string> language-label;
    in property <[string]> languages;
    in property <int> language: 0;
    in property <string> images-label;
    in property <string> videos-label;
    in property <string> images-path;
    in property <string> videos-path;
    in property <string> browse-label;
    in property <string> autostart-label;
    in property <bool> autostart: true;
    in property <string> notifications-label;
    in property <bool> notifications: true;
    in property <string> hardware-text;
    in property <string> back-label;
    in property <string> next-label;
    in property <string> finish-label;
    in property <string> skip-label;
    in property <bool> last: false;

    callback language-chosen(int);
    callback browse(int);
    callback autostart-toggled(bool);
    callback notifications-toggled(bool);
    callback back();
    callback next();
    callback skip();

    title: "Vixeeny";
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    preferred-width: 560px;
    preferred-height: 420px;
    min-width: 560px;
    min-height: 420px;
    background: Theme.bg;

    VerticalLayout {
        padding: 32px;
        spacing: 14px;

        Text { text: root.step-text; color: Theme.text-3; font-size: 12px; }
        Text { text: root.heading; color: Theme.text; font-size: 26px; font-weight: 600; wrap: word-wrap; }
        if root.body != "": Text { text: root.body; color: Theme.text-2; font-size: 14px; wrap: word-wrap; }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            alignment: start;

            if root.step == 0: VerticalLayout {
                spacing: 6px;
                Text { text: root.language-label; color: Theme.text-2; font-size: 12px; }
                for name[i] in root.languages: Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-card;
                    background: i == root.language ? Theme.accent-soft : (lang-area.has-hover ? Theme.card-hover : Theme.card);
                    border-width: 1px;
                    border-color: i == root.language ? Theme.accent : Theme.stroke;
                    animate background { duration: Theme.t-fast; }
                    Text { x: 14px; text: name; color: Theme.text; font-size: 14px; vertical-alignment: center; }
                    if i == root.language : Icon { x: parent.width - 34px; y: 12px; data: Icons.checkmark; tint: Theme.accent; size: 16px; }
                    lang-area := TouchArea {
                        accessible-role: radio-button;
                        accessible-label: name;
                        clicked => { root.language-chosen(i); }
                    }
                }
            }
            if root.step == 1: VerticalLayout {
                spacing: 12px;
                PathRow {
                    caption: root.images-label;
                    path: root.images-path;
                    browse-text: root.browse-label;
                    browse => { root.browse(0); }
                }
                PathRow {
                    caption: root.videos-label;
                    path: root.videos-path;
                    browse-text: root.browse-label;
                    browse => { root.browse(1); }
                }
            }
            if root.step == 2: VerticalLayout {
                spacing: 4px;
                Check { text: root.autostart-label; on: root.autostart; toggled(v) => { root.autostart-toggled(v); } }
                Check { text: root.notifications-label; on: root.notifications; toggled(v) => { root.notifications-toggled(v); } }
            }
            if root.step == 3: Text {
                text: root.hardware-text;
                color: Theme.text;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            spacing: 10px;
            Button { subtle: true; text: root.skip-label; clicked => { root.skip(); } }
            Rectangle { }
            if root.step > 0: Button { text: root.back-label; clicked => { root.back(); } }
            Button {
                text: root.last ? root.finish-label : root.next-label;
                accent: true;
                clicked => { root.next(); }
            }
        }
    }
}
