// The side overlay (plan 5.12): the actions of Vixeeny as a strip of icons on one edge of the
// screen. The name of the action under the pointer (or the keyboard) shows beside the strip.
// It slides and fades in, takes the arrow keys, Enter and Escape, and goes away when the user
// clicks elsewhere, unless it is pinned. Nothing runs while it is still.

import { Theme, Icons, Icon } from "controls.slint";

export struct SideItem {
    // Which action this is (the Rust side maps it back).
    id: int,
    // Which little drawing goes with it, see `Glyphs`.
    glyph: int,
    label: string,
    enabled: bool,
    // A separator between groups rather than an action.
    header: bool,
    // On/off actions that are on (recording, replay): drawn highlighted.
    active: bool,
}

// The Fluent icon of an action (see `Icons`).
global Glyphs {
  pure public function path(kind: int) -> string {
    return kind == 0 ? Icons.screenshot
        : kind == 1 ? Icons.window
        : kind == 2 ? Icons.desktop
        : kind == 3 ? Icons.dual-screen
        : kind == 4 ? Icons.scroll
        : kind == 6 ? Icons.record-filled
        : kind == 7 ? Icons.stop-filled
        : kind == 8 ? Icons.history
        : kind == 9 ? Icons.save
        : Icons.settings;
  }
}

// Sizes, in logical pixels (`side_panel.rs` computes the window from the same numbers).
global Side {
    out property <length> button: 40px;
    out property <length> pad: 6px;
    out property <length> gap: 2px;
    out property <length> separator: 9px;
    out property <length> small: 28px;
    out property <length> margin: 12px;
    out property <length> tip-room: 220px;
    out property <length> tip-height: 40px;
}

component ItemView inherits Rectangle {
    in property <SideItem> item;
    in property <bool> vertical;
    in property <bool> selected;
    callback clicked();
    callback hovered();

    width: root.item.header ? (root.vertical ? Side.button : Side.separator) : Side.button;
    height: root.item.header ? (root.vertical ? Side.separator : Side.button) : Side.button;
    border-radius: Theme.radius-flyout;
    background: (root.selected && !root.item.header) ? (touch.pressed ? Theme.subtle-pressed : Theme.selected) : transparent;
    animate background { duration: Theme.t-fast; }
    opacity: root.item.enabled || root.item.header ? 1.0 : 0.38;
    animate opacity { duration: Theme.t-fast; }
    accessible-role: button;
    accessible-label: root.item.label;

    if root.item.header : Rectangle {
        x: root.vertical ? 8px : (parent.width - 1px) / 2;
        y: root.vertical ? (parent.height - 1px) / 2 : 8px;
        width: root.vertical ? parent.width - 16px : 1px;
        height: root.vertical ? 1px : parent.height - 16px;
        background: Theme.divider;
    }
    if !root.item.header : Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: Glyphs.path(root.item.glyph);
        tint: root.item.glyph == 6 || root.item.glyph == 7 ? Theme.record : (root.item.active ? Theme.accent : Theme.text);
        size: 20px;
    }
    // A dot under the actions that are on (recording, replay buffer).
    if root.item.active && !root.item.header : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 7px;
        width: 4px; height: 4px; border-radius: 2px;
        background: root.item.glyph == 7 ? Theme.record : Theme.accent;
    }
    touch := TouchArea {
        enabled: root.item.enabled && !root.item.header;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.hovered(); }
        }
        clicked => { root.clicked(); }
    }
}

// A small button of the strip's corner (pin, close).
component CornerButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    width: Side.small;
    height: Side.small;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-soft
        : (touch.pressed ? Theme.subtle-pressed : (touch.has-hover ? Theme.subtle-hover : transparent));
    animate background { duration: Theme.t-fast; }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        data: root.icon;
        size: 14px;
        tint: root.active ? Theme.accent : Theme.text-2;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    accessible-role: button;
    accessible-label: root.label;
}

export component SidePanelWindow inherits Window {
    in property <[SideItem]> items;
    // On the left or right edge (a column) rather than the top or bottom (a row).
    in property <bool> vertical: true;
    // 0 left, 1 right, 2 top, 3 bottom: where it slides in from.
    in property <int> edge: 1;
    // The OS blurs what is behind the window: a lighter fill lets it show.
    in property <bool> backdrop: false;
    in property <duration> enter: 250ms;
    in property <duration> exit: 150ms;
    in property <string> pin-label;
    in property <string> close-label;
    in-out property <bool> shown: false;
    in-out property <int> selected: -1;
    // Stays open when the user clicks elsewhere or picks an action.
    in-out property <bool> pinned: false;

    callback activate(int);
    // The index to select after moving by this many selectable entries.
    callback navigate(int) -> int;
    callback dismiss();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    forward-focus: keys;

    property <float> progress: root.shown ? 1.0 : 0.0;
    animate progress {
        duration: root.shown ? root.enter : root.exit;
        easing: root.shown ? cubic-bezier(0.16, 1, 0.3, 1) : ease-in;
    }

    property <color> fill: Theme.dark
        ? (root.backdrop ? #23232780 : #232327eb)
        : (root.backdrop ? #ffffff99 : #ffffffeb);

    // The label beside the strip: which entry, and where along the strip.
    property <bool> tip-on: false;
    property <length> tip-at: 0px;
    property <string> tip-text: root.selected >= 0 && root.selected < root.items.length ? root.items[root.selected].label : "";

    // The strip's size: its content plus the padding.
    property <length> strip-w: root.vertical ? Side.button + 2 * Side.pad : root.width - 2 * Side.margin;
    property <length> strip-h: root.vertical ? root.height - 2 * Side.margin : Side.button + 2 * Side.pad;

    // A click on the empty part of the window (around the strip) is a click elsewhere.
    TouchArea {
        clicked => { if !root.pinned { root.dismiss(); } }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.selected >= 0 && root.selected < root.items.length) {
                    root.activate(root.items[root.selected].id);
                }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow || (event.text == Key.Tab && event.modifiers.shift)) {
                root.selected = root.navigate(-1);
                root.tip-on = true;
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == Key.RightArrow || event.text == Key.Tab) {
                root.selected = root.navigate(1);
                root.tip-on = true;
                return accept;
            }
            reject
        }
    }

    // A soft shadow under the strip, as the Windows 11 flyouts have.
    Rectangle {
        x: strip.x; y: strip.y + 2px; width: strip.width; height: strip.height;
        border-radius: Theme.radius-card;
        background: #00000000;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000045;
        drop-shadow-offset-y: 4px;
        opacity: strip.opacity;
    }

    // The strip sits against the screen edge (beyond the margin for its shadow) and slides in
    // from beyond it; the room for the label is on the inner side.
    strip := Rectangle {
        property <length> rest-x: root.edge == 1 ? root.width - Side.margin - root.strip-w : Side.margin;
        property <length> rest-y: root.edge == 3 ? root.height - Side.margin - root.strip-h : Side.margin;
        x: self.rest-x + (root.edge == 0 ? -1 : (root.edge == 1 ? 1 : 0)) * (1.0 - root.progress) * (root.strip-w + Side.margin);
        y: self.rest-y + (root.edge == 2 ? -1 : (root.edge == 3 ? 1 : 0)) * (1.0 - root.progress) * (root.strip-h + Side.margin);
        width: root.strip-w;
        height: root.strip-h;
        opacity: root.progress;
        border-radius: Theme.radius-card;
        background: root.fill;
        border-width: 1px;
        border-color: Theme.stroke-strong;

        TouchArea { } // the strip itself is not "elsewhere"

        if root.vertical : VerticalLayout {
            padding: Side.pad;
            spacing: Side.gap;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                spacing: 0px;
                CornerButton {
                    width: Side.button / 2;
                    icon: root.pinned ? Icons.pin-filled : Icons.pin;
                    label: root.pin-label;
                    active: root.pinned;
                    clicked => { root.pinned = !root.pinned; }
                }
                CornerButton { width: Side.button / 2; icon: Icons.dismiss; label: root.close-label; clicked => { root.dismiss(); } }
            }
            Rectangle { height: Side.separator; Rectangle { x: 8px; y: (parent.height - 1px) / 2; width: parent.width - 16px; height: 1px; background: Theme.divider; } }
            for item[i] in root.items : ItemView {
                item: item;
                vertical: true;
                selected: i == root.selected;
                hovered => {
                    root.selected = i;
                    root.tip-at = self.y + self.height / 2;
                    root.tip-on = true;
                }
                changed selected => { if self.selected { root.tip-at = self.y + self.height / 2; } }
                clicked => { root.activate(item.id); }
            }
        }
        if !root.vertical : HorizontalLayout {
            padding: Side.pad;
            spacing: Side.gap;
            alignment: start;
            VerticalLayout {
                alignment: center;
                spacing: 0px;
                CornerButton {
                    height: Side.button / 2;
                    icon: root.pinned ? Icons.pin-filled : Icons.pin;
                    label: root.pin-label;
                    active: root.pinned;
                    clicked => { root.pinned = !root.pinned; }
                }
                CornerButton { height: Side.button / 2; icon: Icons.dismiss; label: root.close-label; clicked => { root.dismiss(); } }
            }
            Rectangle { width: Side.separator; Rectangle { x: (parent.width - 1px) / 2; y: 8px; width: 1px; height: parent.height - 16px; background: Theme.divider; } }
            for item[i] in root.items : ItemView {
                item: item;
                vertical: false;
                selected: i == root.selected;
                hovered => {
                    root.selected = i;
                    root.tip-at = self.x + self.width / 2;
                    root.tip-on = true;
                }
                changed selected => { if self.selected { root.tip-at = self.x + self.width / 2; } }
                clicked => { root.activate(item.id); }
            }
        }
    }

    // The name of the action, beside the strip.
    tip := Rectangle {
        property <bool> on: root.tip-on && root.tip-text != "" && root.progress > 0.99;
        width: label.preferred-width + 20px;
        height: 30px;
        x: root.vertical
            ? (root.edge == 1 ? strip.x - self.width - 8px : strip.x + strip.width + 8px)
            : Math.max(4px, Math.min(root.width - self.width - 4px, strip.x + root.tip-at - self.width / 2));
        y: root.vertical
            ? Math.max(4px, Math.min(root.height - self.height - 4px, strip.y + root.tip-at - self.height / 2))
            : (root.edge == 3 ? strip.y - self.height - 8px : strip.y + strip.height + 8px);
        animate x, y { duration: Theme.t-fast; easing: cubic-bezier(0.2, 0, 0, 1); }
        opacity: self.on ? 1 : 0;
        animate opacity { duration: Theme.t-fast; }
        border-radius: Theme.radius;
        background: Theme.flyout;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000035;
        drop-shadow-offset-y: 2px;
        label := Text {
            text: root.tip-text;
            color: Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
