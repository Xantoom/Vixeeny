// The side overlay (plan 5.12): the actions of Vixeeny in a translucent strip on one edge of the
// screen. It slides and fades in, takes the arrow keys, Enter and Escape, and does nothing while
// it is still (no timer runs once the animation is over).

import { Theme, Icons, Icon } from "controls.slint";

export struct SideItem {
    // Which action this is (the Rust side maps it back).
    id: int,
    // Which little drawing goes with it, see `Glyph`.
    glyph: int,
    label: string,
    enabled: bool,
    // A section title rather than an action.
    header: bool,
    // On/off actions that are on (recording, replay): drawn highlighted.
    active: bool,
}

// The Fluent icon of an action (see `Icons`).
global Glyphs {
  pure public function path(kind: int) -> string {
    return kind == 0 ? Icons.screenshot
        : kind == 1 ? Icons.window
        : kind == 2 ? Icons.desktop
        : kind == 3 ? Icons.dual-screen
        : kind == 4 ? Icons.scroll
        : kind == 5 ? Icons.scan-text
        : kind == 6 ? Icons.record-filled
        : kind == 7 ? Icons.stop-filled
        : kind == 8 ? Icons.history
        : kind == 9 ? Icons.save
        : kind == 10 ? Icons.slider
        : Icons.settings;
  }
}

component ItemView inherits Rectangle {
    in property <SideItem> item;
    in property <bool> vertical;
    in property <bool> selected;
    callback clicked();
    callback hovered();

    // Vertical: a row (icon and label); horizontal: a tile (icon over label).
    width: root.item.header ? (root.vertical ? 0px : 12px) : (root.vertical ? 272px : 96px);
    height: root.item.header ? (root.vertical ? 32px : 84px) : (root.vertical ? 44px : 84px);
    border-radius: Theme.radius-card;
    background: (root.selected && !root.item.header) ? Theme.selected : transparent;
    animate background { duration: Theme.t-fast; }
    opacity: root.item.enabled || root.item.header ? 1.0 : 0.38;
    accessible-role: button;
    accessible-label: root.item.label;

    // The marker of the keyboard selection, as in the Windows 11 navigation.
    if root.selected && !root.item.header && root.vertical : Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: 3px; height: 16px; border-radius: 2px;
        background: Theme.accent;
    }
    if root.item.header && root.vertical : Text {
        x: 14px;
        y: 12px;
        text: root.item.label;
        color: Theme.text-3;
        font-size: 12px;
        font-weight: 600;
    }
    if root.item.header && !root.vertical : Rectangle {
        x: 5px; y: 16px; width: 1px; height: 52px; background: Theme.divider;
    }
    if !root.item.header && root.vertical : HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        spacing: 14px;
        alignment: start;
        Icon {
            y: (parent.height - self.height) / 2;
            data: Glyphs.path(root.item.glyph);
            tint: root.item.glyph == 6 || root.item.glyph == 7 ? Theme.record : (root.item.active ? Theme.accent : Theme.text);
            size: 20px;
        }
        Text {
            text: root.item.label;
            color: root.item.active ? Theme.accent : Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if !root.item.header && !root.vertical : Rectangle {
        Icon {
            x: (parent.width - self.width) / 2;
            y: 14px;
            data: Glyphs.path(root.item.glyph);
            tint: root.item.glyph == 6 || root.item.glyph == 7 ? Theme.record : (root.item.active ? Theme.accent : Theme.text);
            size: 22px;
        }
        Text {
            x: 4px;
            y: 44px;
            width: parent.width - 8px;
            height: 36px;
            text: root.item.label;
            color: root.item.active ? Theme.accent : Theme.text-2;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
        }
    }
    if !root.item.header : TouchArea {
        enabled: root.item.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.hovered(); }
        }
        clicked => { root.clicked(); }
    }
}

export component SidePanelWindow inherits Window {
    in property <[SideItem]> items;
    // On the left or right edge (a column) rather than the top or bottom (a row).
    in property <bool> vertical: true;
    // 0 left, 1 right, 2 top, 3 bottom: where it slides in from.
    in property <int> edge: 1;
    // The OS blurs what is behind the window: a lighter fill lets it show.
    in property <bool> backdrop: false;
    in property <duration> enter: 250ms;
    in property <duration> exit: 150ms;
    in-out property <bool> shown: false;
    in-out property <int> selected: -1;

    callback activate(int);
    // The index to select after moving by this many selectable entries.
    callback navigate(int) -> int;
    callback dismiss();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    forward-focus: keys;

    property <float> progress: root.shown ? 1.0 : 0.0;
    animate progress {
        duration: root.shown ? root.enter : root.exit;
        easing: root.shown ? cubic-bezier(0.16, 1, 0.3, 1) : ease-in;
    }

    property <color> fill: Theme.dark
        ? (root.backdrop ? #2c2c2cc8 : #2c2c2cf5)
        : (root.backdrop ? #f9f9f9c8 : #f9f9f9f5);

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismiss();
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.selected >= 0 && root.selected < root.items.length) {
                    root.activate(root.items[root.selected].id);
                }
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow || (event.text == Key.Tab && event.modifiers.shift)) {
                root.selected = root.navigate(-1);
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == Key.RightArrow || event.text == Key.Tab) {
                root.selected = root.navigate(1);
                return accept;
            }
            reject
        }
    }

    // A soft shadow under the strip, as the Windows 11 flyouts have.
    shadow := Rectangle {
        x: strip.x - 2px; y: strip.y; width: strip.width + 4px; height: strip.height + 4px;
        border-radius: 12px;
        background: #00000000;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000050;
        drop-shadow-offset-y: 4px;
        opacity: strip.opacity;
    }

    // The strip sits 12 px inside the window; the window touches the screen edge, so the strip
    // slides in from beyond it.
    strip := Rectangle {
        x: 12px + (root.edge == 0 ? -1 : (root.edge == 1 ? 1 : 0)) * (1.0 - root.progress) * root.width;
        y: 12px + (root.edge == 2 ? -1 : (root.edge == 3 ? 1 : 0)) * (1.0 - root.progress) * root.height;
        width: root.width - 24px;
        height: root.height - 24px;
        opacity: root.progress;
        border-radius: 12px;
        background: root.fill;
        border-width: 1px;
        border-color: Theme.stroke-strong;

        if root.vertical : VerticalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: start;
            for item[i] in root.items : ItemView {
                item: item;
                vertical: true;
                selected: i == root.selected;
                hovered => { root.selected = i; }
                clicked => { root.activate(item.id); }
            }
        }
        if !root.vertical : HorizontalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: start;
            for item[i] in root.items : ItemView {
                item: item;
                vertical: false;
                selected: i == root.selected;
                hovered => { root.selected = i; }
                clicked => { root.activate(item.id); }
            }
        }
    }
}
