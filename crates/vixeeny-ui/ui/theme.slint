// The design tokens of every Vixeeny window: calm neutral surfaces (few borders, hairline
// dividers), the system accent for what is chosen, and short eased motion. The host sets `dark`,
// `accent-base` (the system accent colour) and `font` once per window; everything else follows.
export global Theme {
    in property <bool> dark: true;
    in property <color> accent-base: #0078d4;
    in property <string> font: "Segoe UI Variable Text";
    // 1.0 = animations on; 0.0 = the user turned them off in the OS.
    in property <float> motion: 1.0;
    // The icon of the program, for title bars, task bars and the like (set by the host).
    in property <image> app-icon;

    // ---- surfaces
    out property <color> bg: dark ? #141416 : #f6f6f7;
    out property <color> card: dark ? #1c1c1f : #ffffff;
    out property <color> card-hover: dark ? #222226 : #fafafb;
    out property <color> card-pressed: dark ? #19191c : #f3f3f4;
    out property <color> flyout: dark ? #232327 : #ffffff;
    out property <color> stroke: dark ? #ffffff0f : #0000000f;
    out property <color> stroke-strong: dark ? #ffffff24 : #00000024;

    // ---- text
    out property <color> text: dark ? #ededef : #18181b;
    out property <color> text-2: dark ? #a1a1aa : #5b5b63;
    out property <color> text-3: dark ? #71717a : #8e8e96;

    // ---- controls
    out property <color> control: dark ? #ffffff0d : #00000008;
    out property <color> control-hover: dark ? #ffffff14 : #0000000d;
    out property <color> control-pressed: dark ? #ffffff0a : #00000012;
    out property <color> control-stroke: dark ? #ffffff12 : #00000014;
    out property <color> subtle-hover: dark ? #ffffff0d : #0000000a;
    out property <color> subtle-pressed: dark ? #ffffff08 : #00000010;
    out property <color> selected: dark ? #ffffff12 : #0000000d;

    // ---- accent
    out property <color> accent: dark ? accent-base.brighter(0.45) : accent-base.darker(0.05);
    out property <color> accent-hover: dark ? accent-base.brighter(0.3) : accent-base.darker(0.15);
    out property <color> accent-pressed: dark ? accent-base.brighter(0.15) : accent-base.darker(0.25);
    out property <color> on-accent: dark ? #000000 : #ffffff;
    out property <color> accent-soft: accent.with-alpha(0.16);

    // ---- status
    out property <color> danger: dark ? #ff8a8a : #c42b1c;
    out property <color> danger-fill: dark ? #3a1f21 : #fdecec;
    out property <color> warning: dark ? #f5c451 : #9d5d00;
    out property <color> warning-fill: dark ? #352c17 : #fff6dc;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> record: #e5322d;

    // ---- shape and motion
    out property <length> radius: 6px;
    out property <length> radius-card: 8px;
    out property <length> radius-flyout: 10px;
    out property <duration> t-fast: motion > 0.5 ? 100ms : 0ms;
    out property <duration> t-normal: motion > 0.5 ? 180ms : 0ms;
    out property <duration> t-slow: motion > 0.5 ? 260ms : 0ms;
}
