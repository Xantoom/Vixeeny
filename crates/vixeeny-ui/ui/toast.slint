// SPDX-License-Identifier: GPL-3.0-or-later
import { Theme, Icons, Icon, IconButton } from "controls.slint";

// The notification (plan 5.14), after the Windows 11 ones: a card in the corner of the screen with
// the thumbnail of the capture, a title and the whole text. Clicking the card runs `activated`
// (open the file), the button runs `action` (open the folder, or the settings for an error).
// It slides in, and dismisses itself unless the pointer is on it.
export component ToastWindow inherits Window {
    in property <string> heading;
    in property <string> body;
    in property <image> thumb;
    in property <bool> has-thumb: false;
    in property <bool> error: false;
    in property <string> action-label;
    in property <duration> lifetime: 7s;

    callback activated();
    callback action();
    callback dismissed();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    icon: Theme.app-icon;
    default-font-family: Theme.font;
    preferred-width: 380px;
    preferred-height: 112px;

    property <bool> shown: false;
    property <float> progress: root.shown ? 1.0 : 0.0;
    animate progress { duration: Theme.t-slow; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    init => { root.shown = true; }

    Timer {
        interval: root.lifetime;
        running: !card.has-hover;
        triggered => { root.dismissed(); }
    }

    // The window is the card plus the room of its shadow.
    Rectangle {
        x: 8px + (1.0 - root.progress) * 40px;
        y: 4px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        border-radius: Theme.radius-flyout;
        clip: true;
        background: Theme.flyout;
        border-width: 1px;
        border-color: Theme.stroke-strong;
        opacity: root.progress;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 4px;

        card := TouchArea {
            clicked => { root.activated(); }
        }

        // The colour of the kind: accent for news, red for a failure.
        Rectangle {
            x: 0px;
            width: 3px;
            background: root.error ? Theme.danger : Theme.accent;
        }

        HorizontalLayout {
            padding: 14px;
            padding-left: 18px;
            spacing: 14px;

            if root.has-thumb: Rectangle {
                width: 76px;
                height: 76px;
                y: 0px;
                border-radius: Theme.radius;
                clip: true;
                background: Theme.bg-deep;
                Image {
                    source: root.thumb;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
            }
            if !root.has-thumb: Icon {
                y: 2px;
                data: root.error ? Icons.error : Icons.checkmark-circle;
                tint: root.error ? Theme.danger : Theme.accent;
                size: 24px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                alignment: start;
                Text {
                    text: root.heading;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: root.body;
                    color: Theme.text-2;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if root.action-label != "": Rectangle {
                    height: 36px;
                    Rectangle {
                        x: 0px;
                        y: 6px;
                        width: label.preferred-width + 24px;
                        height: 26px;
                        border-radius: Theme.radius;
                        background: btn.pressed ? Theme.control-pressed : (btn.has-hover ? Theme.control-hover : Theme.control);
                        border-width: 1px;
                        border-color: Theme.control-stroke;
                        animate background { duration: Theme.t-fast; }
                        label := Text {
                            text: root.action-label;
                            color: Theme.text;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn := TouchArea {
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: root.action-label;
                            clicked => { root.action(); }
                        }
                    }
                }
            }
        }

        // Close.
        Rectangle {
            x: parent.width - 28px;
            y: 6px;
            width: 22px;
            height: 22px;
            border-radius: Theme.radius;
            background: close.has-hover ? Theme.subtle-hover : transparent;
            opacity: card.has-hover ? 1.0 : 0.0;
            animate opacity { duration: Theme.t-fast; }
            Icon { data: Icons.dismiss; tint: Theme.text-2; size: 12px; x: 5px; y: 5px; }
            close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.dismissed(); }
            }
        }
    }
}
