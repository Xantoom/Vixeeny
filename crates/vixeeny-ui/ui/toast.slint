// The notification (plan 5.14): a small card in the corner of the screen with the thumbnail of the
// capture, a title and a line of detail. Clicking the card runs `activated` (open the file), the
// button runs `action` (open the folder, or the settings for an error). It dismisses itself.
export component ToastWindow inherits Window {
    in property <string> heading;
    in property <string> body;
    in property <image> thumb;
    in property <bool> has-thumb: false;
    in property <bool> error: false;
    in property <bool> dark: true;
    in property <string> action-label;
    in property <duration> lifetime: 6s;

    callback activated();
    callback action();
    callback dismissed();

    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Inter";
    preferred-width: 360px;
    preferred-height: 96px;

    property <color> fill: root.dark ? #1f2937f2 : #ffffffee;
    property <color> ink: root.dark ? #f9fafb : #111827;
    property <color> dim: root.dark ? #9ca3af : #4b5563;
    property <color> accent: root.error ? #ef4444 : #3b82f6;
    property <bool> shown: false;

    init => { root.shown = true; }

    Timer {
        interval: root.lifetime;
        running: !card.has-hover;
        triggered => { root.dismissed(); }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: 12px;
        clip: true;
        background: root.fill;
        border-width: 1px;
        border-color: root.dark ? #ffffff22 : #00000022;
        opacity: root.shown ? 1.0 : 0.0;
        animate opacity { duration: 180ms; }

        card := TouchArea {
            clicked => { root.activated(); }
        }

        Rectangle {
            x: 0px;
            width: 4px;
            background: root.accent;
        }

        HorizontalLayout {
            padding: 12px;
            padding-left: 16px;
            spacing: 12px;

            if root.has-thumb: Rectangle {
                width: 72px;
                border-radius: 6px;
                clip: true;
                background: #00000033;
                Image {
                    source: root.thumb;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }
            }
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: root.heading;
                    color: root.ink;
                    font-size: 14px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.body;
                    color: root.dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 34px;
                }
                if root.action-label != "": Rectangle {
                    height: 26px;
                    Rectangle {
                        x: 0px;
                        width: label.preferred-width + 20px;
                        border-radius: 6px;
                        background: btn.has-hover ? root.accent : root.accent.with-alpha(0.25);
                        label := Text {
                            text: root.action-label;
                            color: btn.has-hover ? #ffffff : root.ink;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn := TouchArea {
                            accessible-role: button;
                            accessible-label: root.action-label;
                            clicked => { root.action(); }
                        }
                    }
                }
            }
        }
    }
}
